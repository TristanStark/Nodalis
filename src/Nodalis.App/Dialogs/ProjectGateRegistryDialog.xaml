<Window x:Class="Nodalis.App.Dialogs.ProjectGateRegistryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registre des gates · Parcours 2.0"
        Width="1010" Height="760" MinWidth="690" MinHeight="490"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Gates · revues et décisions historisées"
                       FontWeight="SemiBold" FontSize="20" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Un gate est un point de contrôle du projet. Seule une décision humaine explicite peut lui donner un verdict. Les décisions passées sont immuables ; un GO ne termine jamais un jalon." />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="POINTS DE CONTRÔLE"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                    <ListBox Grid.Row="1" x:Name="GatesList" Margin="0,10,0,9"
                             SelectionChanged="GatesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,8">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,4,0,0" FontSize="11"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2">
                        <Button x:Name="AddGateButton" Content="Créer un gate"
                                Padding="10,7" Margin="0,0,7,7"
                                Click="AddGate_Click" />
                        <Button x:Name="AddDefaultsButton" Content="Proposer les 5 standards"
                                Padding="10,7" Margin="0,0,7,7"
                                Click="AddDefaults_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="GateNameText" FontSize="16"
                               FontWeight="SemiBold"
                               Text="Sélectionnez un point de contrôle" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="CRITÈRES DU POINT DE CONTRÔLE"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,10,0,6"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <WrapPanel Grid.Row="2" Margin="0,0,0,5">
                        <Button x:Name="AddCriterionButton" Content="Ajouter un critère"
                                Padding="10,6" Margin="0,0,7,0"
                                Click="AddCriterion_Click" />
                        <Button x:Name="AddProofButton" Content="Ajouter une preuve locale…"
                                Padding="10,6"
                                Click="AddProof_Click" />
                    </WrapPanel>
                    <ListBox Grid.Row="3" x:Name="CriteriaList"
                             Margin="0,0,0,8" MaxHeight="150"
                             DisplayMemberPath="Name" />
                    <TextBlock Grid.Row="4" Text="DÉCISIONS FIGÉES · HISTORIQUE"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,10,0,6"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <Grid Grid.Row="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ListBox x:Name="HistoryList"
                                 SelectionChanged="HistoryList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,5">
                                        <TextBlock Text="{Binding Label}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBox Grid.Row="1" x:Name="DecisionDetailsBox"
                                 Margin="0,7,0,0" FontFamily="Consolas"
                                 FontSize="11" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" />
                        <TextBlock Grid.Row="2"
                                   Text="RÉSERVES · état courant calculé"
                                   Margin="0,10,0,6"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <ListBox Grid.Row="3" x:Name="ReservationsList"
                                 MinHeight="46"
                                 SelectionChanged="ReservationsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,5">
                                        <TextBlock Text="{Binding Label}"
                                                   TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <WrapPanel Grid.Row="6" Margin="0,10,0,0">
                        <Button x:Name="RecordDecisionButton" Content="Consigner une décision…"
                                Padding="12,7" Click="RecordDecision_Click"
                                Margin="0,0,7,0" />
                        <Button x:Name="ChooseGateButton" Content="Lier au Parcours"
                                Padding="12,7" Click="ChooseGate_Click"
                                Margin="0,0,7,6" />
                        <Button x:Name="LiftReservationButton"
                                Content="Lever la réserve…"
                                Padding="12,7" Margin="0,0,7,6"
                                Click="LiftReservation_Click" />
                        <Button x:Name="ReopenReservationButton"
                                Content="Réouvrir la réserve…"
                                Padding="12,7" Margin="0,0,7,6"
                                Click="ReopenReservation_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Recharger" Padding="12,7"
                        Margin="0,0,7,0" Click="Reload_Click" />
                <Button Content="Fermer" Padding="12,7"
                        Click="Close_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Lecture du registre sans création de fichier…" />
        </DockPanel>
    </Grid>
</Window>
