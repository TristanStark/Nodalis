<Window x:Class="Nodalis.App.Dialogs.InboxConversionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inbox — Convertir la capture"
        Width="900" Height="640" MinWidth="740" MinHeight="490"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="Convertir dans Nodalis" FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Text="Choisir une destination réelle, vérifier l’aperçu puis confirmer. La capture originale reste dans l’Inbox."
                       Margin="0,5,0,0" FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Destination · Global / Application / Projet"
                               FontWeight="SemiBold" Margin="0,0,0,5"
                               TextWrapping="Wrap" />
                    <ComboBox x:Name="ScopeComboBox"
                              MinHeight="32"
                              AutomationProperties.Name="Choisir le projet, l’application ou Global"
                              SelectionChanged="ConversionOption_Changed"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,0,14" />
                    <TextBlock Text="Type de conversion"
                               FontWeight="SemiBold" Margin="0,0,0,5" />
                    <ComboBox x:Name="ModeComboBox" MinHeight="32"
                              SelectionChanged="ConversionOption_Changed"
                              AutomationProperties.Name="Choisir le type de conversion">
                        <ComboBoxItem Tag="QuickNote" Content="Ajouter aux Notes rapides" />
                        <ComboBoxItem Tag="NewDocument" Content="Créer un document Markdown" />
                        <ComboBoxItem Tag="AppendDocument" Content="Ajouter à un document existant" />
                        <ComboBoxItem Tag="MarkdownTask" Content="Créer une tâche Markdown" />
                    </ComboBox>
                    <TextBlock x:Name="NewFileLabel"
                               Text="Nom du nouveau document (.md)"
                               Margin="0,16,0,5" />
                    <TextBox x:Name="NewFileTextBox"
                             Text="Capture Inbox"
                             MinHeight="32"
                             TextChanged="NewFileTextBox_TextChanged"
                             ToolTip="Un nouveau fichier sera créé, aucun fichier existant ne sera remplacé."
                             AutomationProperties.Name="Nom du document à créer" />
                    <TextBlock x:Name="ExistingFileLabel"
                               Text="Document existant"
                               Margin="0,16,0,5" />
                    <ComboBox x:Name="ExistingFileComboBox"
                              MinHeight="32"
                              SelectionChanged="ConversionOption_Changed"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="Document Markdown cible" />
                    <TextBlock Margin="0,14,0,0"
                               Text="La conversion vers Fiche de Maintenance.md est un ajout Markdown simple, pas une intervention structurée."
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="ValidationText"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns" />
            <Grid Grid.Column="2" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Aperçu de la conversion"
                           FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBox x:Name="ConversionPreviewTextBox" Grid.Row="1"
                         IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Padding="10"
                         AutomationProperties.Name="Aperçu en lecture seule" />
            </Grid>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="ConvertButton" DockPanel.Dock="Right"
                    MinWidth="145" Content="Convertir"
                    IsDefault="True" Click="Convert_Click"
                    Padding="12,7" Margin="10,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Annuler"
                    IsCancel="True" Padding="12,7" />
        </DockPanel>
    </Grid>
</Window>