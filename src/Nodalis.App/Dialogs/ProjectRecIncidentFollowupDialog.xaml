<Window x:Class="Nodalis.App.Dialogs.ProjectRecIncidentFollowupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suivi d'incidents et de revalidation · Nodalis 2.0"
        Width="1060" Height="740" MinWidth="740" MinHeight="490"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Suivi des incidents et reprises de recette"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,8" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Lecture seule : comparaison des échecs REC associés à chaque incident avec les derniers résultats humains. Les interventions déclarées et un résultat Conforme ne prouvent pas la résolution ; toute décision reste humaine."/>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                       FontWeight="SemiBold"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="8" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="INCIDENTS ASSOCIÉS AUX TESTS"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <ListBox x:Name="IncidentsList" Grid.Row="1"
                             Margin="0,8,0,0"
                             SelectionChanged="Incidents_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5,6">
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="8" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="REVALIDATION : CONSTATS HISTORIQUES"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="TestsText" Grid.Row="1"
                             IsReadOnly="True" AcceptsReturn="True"
                             Margin="0,8,0,10" TextWrapping="Wrap"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Derniers tests par incident, version et environnement"/>
                    <TextBlock Grid.Row="2"
                               Text="INTERVENTIONS ET POINTS À CONTRÔLER"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="MaintenanceText" Grid.Row="3"
                             IsReadOnly="True" AcceptsReturn="True"
                             Margin="0,8,0,0" TextWrapping="Wrap"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Historique technique et avertissements de revalidation"/>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Fermer" Padding="13,8"
                    DockPanel.Dock="Right" IsCancel="True"/>
            <TextBlock Text="Aucun incident ni résultat REC modifié."
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
