<Window x:Class="Nodalis.App.Dialogs.ProjectRiskGateBacklinksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réserves de Gates liées au RIS" Width="795" Height="580"
        MinWidth="565" MinHeight="415" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadingText" FontSize="18"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SummaryText" Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <ListBox x:Name="BacklinksList" Grid.Row="1" BorderThickness="0"
                 Background="Transparent"
                 SelectionChanged="Backlinks_SelectionChanged"
                 MouseDoubleClick="Backlinks_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,0,0,6"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Status}"
                                       Margin="0,6,0,0" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding DecisionId}" FontSize="10"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="DiagnosticsText" Grid.Row="2" Margin="0,9,0,0"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}" />
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Fermer" Padding="12,7" Margin="0,0,8,0"
                        Click="Close_Click" />
                <Button x:Name="OpenGateButton" Content="Ouvrir le Gate"
                        Padding="12,7" Click="OpenGate_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </DockPanel>
    </Grid>
</Window>
