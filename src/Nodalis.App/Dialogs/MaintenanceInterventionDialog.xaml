<Window x:Class="Nodalis.App.Dialogs.MaintenanceInterventionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle intervention"
        Width="610"
        Height="610"
        MinWidth="460"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="FormHeadingTextBlock" FontSize="18" FontWeight="SemiBold" Text="Intervention de maintenance" />
            <TextBlock Margin="0,5,0,12"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="Le résumé est le seul contenu métier requis. Tout reste éditable dans la fiche Markdown." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Résumé *" FontWeight="SemiBold" />
                <TextBox x:Name="SummaryTextBox" MinHeight="32" Margin="0,5,0,12"
                         Padding="8,5" TextChanged="FieldChanged"
                         AutomationProperties.Name="Résumé de l'intervention" />
                <TextBlock Text="Date *" FontWeight="SemiBold" />
                <DatePicker x:Name="DatePicker" MinHeight="32" Margin="0,5,0,10"
                            SelectedDateFormat="Short"
                            SelectedDateChanged="DateChanged"
                            AutomationProperties.Name="Date de l'intervention" />
                <Expander x:Name="MoreFieldsExpander" Header="Détails facultatifs"
                          IsExpanded="False" Margin="0,7,0,12">
                    <StackPanel Margin="0,12,0,4">
                        <TextBlock x:Name="IncidentRelationLabel" Text="Incident lié" />
                        <ComboBox x:Name="IncidentComboBox" MinHeight="32" Margin="0,4,0,10"
                                  DisplayMemberPath="DisplayLabel"
                                  SelectedValuePath="Id"
                                  SelectionChanged="SelectionChanged"
                                  AutomationProperties.Name="Incident lié" />
                        <TextBlock Text="Symptômes" />
                        <TextBox x:Name="SymptomsTextBox" Margin="0,4,0,9" Padding="8,5" TextChanged="FieldChanged" />
                        <TextBlock Text="Cause" />
                        <TextBox x:Name="CauseTextBox" Margin="0,4,0,9" Padding="8,5" TextChanged="FieldChanged" />
                        <TextBlock Text="Diagnostic" />
                        <TextBox x:Name="DiagnosisTextBox" Margin="0,4,0,9" Padding="8,5" TextChanged="FieldChanged" />
                        <TextBlock Text="Action" />
                        <TextBox x:Name="ActionTextBox" Margin="0,4,0,9" Padding="8,5" TextChanged="FieldChanged" />
                        <TextBlock Text="Résultat" />
                        <TextBox x:Name="ResultTextBox" Margin="0,4,0,9" Padding="8,5" TextChanged="FieldChanged" />
                        <TextBlock Text="Statut" />
                        <TextBox x:Name="StatusTextBox" Margin="0,4,0,9" Padding="8,5" TextChanged="FieldChanged" />
                        <TextBlock Text="Catégorie" />
                        <TextBox x:Name="CategoryTextBox" Margin="0,4,0,9" Padding="8,5" TextChanged="FieldChanged" />
                        <TextBlock Text="Tags (séparés par des virgules)" />
                        <TextBox x:Name="TagsTextBox" Margin="0,4,0,9" Padding="8,5" TextChanged="FieldChanged" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,9,0" IsCancel="True" Content="Annuler" />
            <Button MinWidth="112" IsDefault="True" Click="Save_Click" Content="Enregistrer" />
        </StackPanel>
    </Grid>
</Window>