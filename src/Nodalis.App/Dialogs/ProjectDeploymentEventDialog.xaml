<Window x:Class="Nodalis.App.Dialogs.ProjectDeploymentEventDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consigner un événement MEP · action humaine"
        Width="650" Height="540" MinWidth="490" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock FontSize="19" FontWeight="SemiBold"
                       Text="Ajouter un événement au journal de tentative" />
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Demander un rollback, le commencer et en constater le résultat sont trois actions différentes. Aucune transition ni réussite n'est inférée automatiquement." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" IsCancel="True"
                    Padding="13,7" Margin="0,0,8,0" />
            <Button Content="Consigner après confirmation…" IsDefault="True"
                    Padding="13,7" Click="Accept_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Type d'événement" Margin="0,0,0,4" />
                <ComboBox x:Name="KindCombo" Padding="8,6"
                          DisplayMemberPath="Label"
                          SelectionChanged="KindCombo_SelectionChanged" />
                <TextBlock Text="Acteur" Margin="0,12,0,4" />
                <TextBox x:Name="ActorBox" Padding="8,6" />
                <TextBlock Text="Justification / fait observé" Margin="0,10,0,4" />
                <TextBox x:Name="ReasonBox" Padding="8,6" MinHeight="76"
                         TextWrapping="Wrap" AcceptsReturn="True" />
                <TextBlock x:Name="VersionLabel"
                           Text="Version réellement observée après l'action"
                           Margin="0,12,0,4" />
                <TextBox x:Name="ObservedVersionBox" Padding="8,6" />
                <TextBlock x:Name="RollbackLabel" Text="Résultat réel du rollback"
                           Margin="0,12,0,4" />
                <ComboBox x:Name="RollbackCombo" Padding="8,6"
                          DisplayMemberPath="Label" />
                <TextBlock TextWrapping="Wrap" Margin="0,14,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="La sauvegarde refuse les transitions incohérentes, un événement ajouté à une tentative terminée et tout conflit de révision." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
