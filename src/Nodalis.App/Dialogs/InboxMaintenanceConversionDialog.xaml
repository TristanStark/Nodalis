<Window x:Class="Nodalis.App.Dialogs.InboxMaintenanceConversionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inbox — Ajouter à une fiche de maintenance"
        Width="960" Height="690" MinWidth="700" MinHeight="510"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Ajouter à une fiche de maintenance" FontSize="19"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Choisir le projet et vérifier la capture. Le texte et les pièces jointes sont conservés ; l'entrée Inbox reste récupérable."
                       Margin="0,5,0,12" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Projet de destination (application · projet)"
                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ProjectComboBox" MinHeight="32"
                              DisplayMemberPath="Label" Margin="0,0,0,14"
                              SelectionChanged="ProjectChanged"
                              AutomationProperties.Name="Sélectionner une application et un projet"/>
                    <TextBlock Text="Ajouter comme" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ModeComboBox" MinHeight="32" Margin="0,0,0,14"
                              SelectionChanged="ModeChanged"
                              AutomationProperties.Name="Type de maintenance à créer">
                        <ComboBoxItem Content="Nouvel incident"/>
                        <ComboBoxItem Content="Intervention (incident existant ou autonome)"/>
                        <ComboBoxItem Content="Nouvel incident + première intervention"/>
                    </ComboBox>
                    <TextBlock x:Name="ExistingIncidentLabel" Text="Incident existant"
                               FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ExistingIncidentComboBox" MinHeight="32"
                              DisplayMemberPath="Label" Margin="0,0,0,14"
                              SelectionChanged="IncidentChanged"
                              AutomationProperties.Name="Choisir l'incident lié"/>
                    <TextBlock Text="Résumé de maintenance" FontWeight="SemiBold"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="SummaryTextBox" MinHeight="32" MaxLength="220"
                             Padding="8,5" TextChanged="SummaryChanged"
                             AutomationProperties.Name="Résumé du nouvel incident ou intervention"/>
                    <TextBlock Text="La date initiale correspond à la capture Inbox. Vous pourrez ensuite compléter le statut, la cause ou la résolution dans la fiche."
                               TextWrapping="Wrap" Margin="0,12,0,10"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="AttachmentText" TextWrapping="Wrap" Margin="0,3,0,7"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <Image x:Name="AttachmentImage" MaxHeight="155"
                           Margin="0,3,0,10" HorizontalAlignment="Left"
                           Stretch="Uniform" Visibility="Collapsed"
                           AutomationProperties.Name="Aperçu de la première image jointe"/>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </ScrollViewer>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns"/>
            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Capture originale" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="SourceSummaryText" Grid.Row="1" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>
                <TextBox x:Name="PreviewTextBox" Grid.Row="2" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="10"
                         AutomationProperties.Name="Aperçu du contenu ajouté au Markdown"/>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="ConvertButton" DockPanel.Dock="Right"
                    Content="Ajouter à la fiche" IsDefault="True"
                    Padding="12,7" Click="Convert_Click" MinWidth="145"
                    Margin="10,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True"
                    Padding="12,7"/>
        </DockPanel>
    </Grid>
</Window>