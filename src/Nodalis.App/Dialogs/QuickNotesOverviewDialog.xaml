<Window x:Class="Nodalis.App.Dialogs.QuickNotesOverviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notes rapides agrégées"
        Width="900"
        Height="700"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Padding="18,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Notes rapides agrégées"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="Projet → Application → Global"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <FlowDocumentScrollViewer x:Name="Preview"
                                  Grid.Row="1"
                                  Background="{StaticResource WindowBackgroundBrush}"
                                  BorderThickness="0"
                                  IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Auto" />

        <Border Grid.Row="2"
                Padding="12,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Button Width="90"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Content="Fermer" />
        </Border>
    </Grid>
</Window>
