<Window x:Class="Nodalis.App.Dialogs.ProjectGateRiskOverviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Synthèse des réserves et des risques · Projet"
        Width="1100" Height="745" MinWidth="700" MinHeight="490"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Réserves ↔ risques · synthèse du projet"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Vue consultative : sources contrôlées à la demande. Une case cochée ne qualifie pas une mesure ; un justificatif textuel ne prouve pas à lui seul un fichier."/>
        </StackPanel>
        <Border Grid.Row="1" Padding="12" Margin="0,0,0,10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="5">
            <WrapPanel>
                <TextBlock x:Name="OpenCountText" Margin="0,0,18,5"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="LiftedCountText" Margin="0,0,18,5"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="WithoutRiskCountText" Margin="0,0,18,5"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="OrphanCountText" Margin="0,0,18,5"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="BlockedCountText" Margin="0,0,18,5"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="UnassessedCountText" Margin="0,0,18,5"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="TaskIssuesCountText" Margin="0,0,8,5"
                           FontWeight="SemiBold"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0"
                     MinHeight="32" TextChanged="SearchBox_TextChanged"
                     ToolTip="Réserve, Gate, responsable, RIS ou titre de risque"
                     AutomationProperties.Name="Rechercher des réserves ou des risques"/>
            <ComboBox x:Name="FilterCombo" Grid.Column="2" MinHeight="32"
                      SelectionChanged="FilterCombo_SelectionChanged">
                <ComboBoxItem Content="Toutes les réserves"/>
                <ComboBoxItem Content="Réserves ouvertes"/>
                <ComboBoxItem Content="Réserves levées"/>
                <ComboBoxItem Content="Ouvertes sans RIS lié"/>
                <ComboBoxItem Content="Ouvertes avec RIS orphelin"/>
                <ComboBoxItem Content="Ouvertes avec mesure bloquée"/>
                <ComboBoxItem Content="Ouvertes avec évaluation absente"/>
                <ComboBoxItem Content="Ouvertes avec mesure non terminée"/>
                <ComboBoxItem Content="Ouvertes avec tâche absente ou ambiguë"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ReservationsList" Grid.Column="0"
                     SelectionChanged="ReservationsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="9,7">
                            <TextBlock Text="{Binding Label}"
                                       TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail}"
                                       Margin="0,5,0,0" FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Padding="12" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="RIS ASSOCIÉS À LA RÉSERVE"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBlock x:Name="LinkedCountText" Grid.Row="1"
                               Margin="0,6,0,5" TextWrapping="Wrap"/>
                    <ListBox x:Name="RisksList" Grid.Row="2"
                             SelectionChanged="RisksList_SelectionChanged"
                             MouseDoubleClick="RisksList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,5">
                                    <TextBlock Text="{Binding Label}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}"
                                               Margin="0,5,0,0" FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="DÉCISION ET PROVENANCE" Grid.Row="3"
                               FontWeight="SemiBold" FontSize="11"
                               Margin="0,12,0,6"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="DetailsBox" Grid.Row="4"
                             IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="Consolas"
                             FontSize="11" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenGateButton"
                        Content="Ouvrir le dossier Gate"
                        Padding="12,8" Margin="0,0,8,0"
                        Click="OpenGate_Click"/>
                <Button x:Name="OpenRiskButton"
                        Content="Ouvrir la fiche RIS"
                        Padding="12,8" Margin="0,0,8,0"
                        Click="OpenRisk_Click"/>
                <Button Content="Fermer" Padding="12,8"
                        Click="Close_Click"/>
            </StackPanel>
            <TextBlock x:Name="ResultsText" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </DockPanel>
    </Grid>
</Window>
