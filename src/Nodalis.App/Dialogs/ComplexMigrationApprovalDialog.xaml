<Window x:Class="Nodalis.App.Dialogs.ComplexMigrationApprovalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Migration guidée Complexe 2.0 — Validation"
        Width="910" Height="745" MinWidth="690" MinHeight="570"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock FontSize="19" FontWeight="SemiBold"
                       Text="Migration guidée vers la structure Complexe 2.0"/>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Margin="0,7,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
            <TextBlock x:Name="FingerprintText" Margin="0,7,0,0"
                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <ListBox x:Name="MovesList" Grid.Row="1"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,7" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding SectionName}"/>
                            <TextBlock Text="{Binding From}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding To}" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding State}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock FontSize="11" FontWeight="SemiBold"
                       Text="LIENS LOCAUX À RÉÉCRIRE DANS LA COPIE"/>
            <TextBox x:Name="RewritesText" IsReadOnly="True" MinHeight="38"
                     MaxHeight="86" Margin="0,5,0,0"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,9,0,0"
                       Text="BLOCAGES ET RÉFÉRENCES À REQUALIFIER"/>
            <TextBox x:Name="BlockersText" IsReadOnly="True" MinHeight="45"
                     MaxHeight="80" Margin="0,5,0,0"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap"
                       Text="Les fichiers sont préparés sur une copie. L’original est conservé dans Imports/.complex-v2-migrations ; toute interruption est journalisée. Les liens internes sans ambiguïté sont réécrits dans cette copie ; les backlinks externes et formats inconnus restent bloquants."
                       Foreground="{StaticResource SecondaryTextBrush}"/>
            <TextBlock Text="Pour autoriser cette opération, saisir MIGRER :"
                       FontWeight="SemiBold" Margin="0,9,0,4"/>
            <TextBox x:Name="ApprovalText" MaxLength="6" Width="165"
                     HorizontalAlignment="Left" TextChanged="ApprovalText_TextChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ApplyButton" Content="Approuver la migration"
                    MinWidth="185" IsEnabled="False"
                    Click="ApplyButton_Click" Margin="0,0,9,0"/>
            <Button Content="Annuler" IsCancel="True" MinWidth="105"/>
        </StackPanel>
    </Grid>
</Window>
