<Window x:Class="Nodalis.App.Dialogs.TaskListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tâches"
        Width="1040"
        Height="760"
        MinWidth="840"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="118" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Padding="16,10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TitleText"
                               Text="Tâches"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ScopeText"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,14,0"
                            Padding="12,6"
                            Click="CreateTask_Click"
                            Content="+ Nouvelle tâche" />
                    <CheckBox x:Name="IncludeCompletedCheckBox"
                              VerticalAlignment="Center"
                              Checked="IncludeCompletedCheckBox_Changed"
                              Unchecked="IncludeCompletedCheckBox_Changed"
                              Content="Inclure terminées" />
                </StackPanel>

                <WrapPanel Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Margin="0,14,0,0"
                           VerticalAlignment="Center">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Text="Filtres" />

                    <ComboBox x:Name="PriorityFilterComboBox"
                              Width="145"
                              Margin="0,0,8,0"
                              SelectionChanged="Filters_Changed" />

                    <ComboBox x:Name="StatusFilterComboBox"
                              Width="145"
                              Margin="0,0,8,0"
                              SelectionChanged="Filters_Changed" />

                    <ComboBox x:Name="OwnerFilterComboBox"
                              Width="155"
                              Margin="0,0,8,0"
                              SelectionChanged="Filters_Changed" />

                    <CheckBox x:Name="OverdueOnlyCheckBox"
                              Margin="4,0,16,0"
                              VerticalAlignment="Center"
                              Checked="Filters_Changed"
                              Unchecked="Filters_Changed"
                              Content="En retard uniquement" />

                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               Text="Tri" />

                    <ComboBox x:Name="SortComboBox"
                              Width="160"
                              SelectionChanged="Filters_Changed"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Échéance" />
                        <ComboBoxItem Content="Priorité" />
                        <ComboBoxItem Content="Responsable" />
                        <ComboBoxItem Content="Texte" />
                    </ComboBox>
                </WrapPanel>
            </Grid>
        </Border>

        <ListBox x:Name="TasksList"
                 Grid.Row="1"
                 Margin="12"
                 BorderThickness="0"
                 Background="Transparent"
                 MouseDoubleClick="TasksList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,7"
                            Padding="12"
                            CornerRadius="5"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Margin="0,2,10,0"
                                      VerticalAlignment="Top"
                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                      Click="TaskCheckBox_Click" />

                            <StackPanel Grid.Column="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="{Binding Text}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="10,0,0,0"
                                               Text="{Binding OverdueDisplay}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </DockPanel>

                                <WrapPanel Margin="0,5,0,0">
                                    <TextBlock Text="{Binding ProjectName}"
                                               Margin="0,0,12,0"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Priority, StringFormat=Priorité : {0}}"
                                               Margin="0,0,12,0"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Status, StringFormat=Statut : {0}}"
                                               Margin="0,0,12,0"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding Owner, StringFormat=Responsable : {0}}"
                                               Margin="0,0,12,0"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding DueDate, StringFormat=Échéance : {0:dd/MM/yyyy}}"
                                               Margin="0,0,12,0"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding TagsDisplay, StringFormat=Tags : {0}}"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </WrapPanel>

                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding SourceRelativePath}"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Top">
                                <Button Padding="10,5"
                                        Tag="{Binding}"
                                        Click="PromoteTask_Click"
                                        Content="Promouvoir">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanPromoteMeetingAction}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Margin="0,6,0,0"
                                        Padding="10,5"
                                        Tag="{Binding}"
                                        Click="EditTask_Click"
                                        Content="Modifier" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Padding="12,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <Button Width="90"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Content="Fermer" />
            </Grid>
        </Border>
    </Grid>
</Window>
