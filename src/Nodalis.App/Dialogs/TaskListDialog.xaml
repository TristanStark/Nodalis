<Window x:Class="Nodalis.App.Dialogs.TaskListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tâches"
        Width="900"
        Height="680"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Padding="16,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Tâches"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ScopeText"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <CheckBox x:Name="IncludeCompletedCheckBox"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Checked="IncludeCompletedCheckBox_Changed"
                          Unchecked="IncludeCompletedCheckBox_Changed"
                          Content="Inclure terminées" />
            </Grid>
        </Border>

        <ListBox x:Name="TasksList"
                 Grid.Row="1"
                 Margin="12"
                 BorderThickness="0"
                 Background="Transparent"
                 MouseDoubleClick="TasksList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,7"
                            Padding="12"
                            CornerRadius="5"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Margin="0,2,10,0"
                                      VerticalAlignment="Top"
                                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                      Click="TaskCheckBox_Click" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Text}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,5,0,0">
                                    <TextBlock Text="{Binding ProjectName}"
                                               Margin="0,0,12,0"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Owner, StringFormat=Responsable : {0}}"
                                               Margin="0,0,12,0"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Text="{Binding DueDate, StringFormat=Échéance : {0:dd/MM/yyyy}}"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </WrapPanel>
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding SourceRelativePath}"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Padding="12,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <Button Width="90"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Content="Fermer" />
            </Grid>
        </Border>
    </Grid>
</Window>
