<Window x:Class="Nodalis.App.Dialogs.ProjectRiskRegistryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registre des risques · Nodalis 2.0"
        Width="890" Height="620" MinWidth="590" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Risques du projet" FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,7,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Une fiche par risque (Analyse/Risques/RIS-0001.md). L'identifiant GUID est permanent. Une fiche non évaluée ne reçoit jamais une criticité faible par défaut ; aucune évaluation ni clôture automatique." />
            <WrapPanel Margin="0,12,0,0">
                <TextBox x:Name="SearchBox" Width="245" MinHeight="30"
                         Margin="0,0,8,6"
                         ToolTip="Rechercher une référence RIS ou un titre"
                         AutomationProperties.Name="Rechercher un risque"
                         TextChanged="Filter_Changed" />
                <ComboBox x:Name="FilterCombo" Width="255" MinHeight="30"
                          Margin="0,0,8,6"
                          ToolTip="Filtre de criticité ou qualification"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Tous les risques" />
                    <ComboBoxItem Content="Sans évaluation initiale" />
                    <ComboBoxItem Content="Résiduel non évalué" />
                    <ComboBoxItem Content="Criticité élevée" />
                    <ComboBoxItem Content="Criticité modérée" />
                    <ComboBoxItem Content="Criticité faible" />
                    <ComboBoxItem Content="Sous surveillance" />
                    <ComboBoxItem Content="Clôturés" />
                    <ComboBoxItem Content="Qualification à faire" />
                    <ComboBoxItem Content="Mesures bloquées" />
                    <ComboBoxItem Content="Mesures non terminées" />
                </ComboBox>
                <TextBlock x:Name="CountsText" VerticalAlignment="Center"
                           Margin="0,0,0,6" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="5" Padding="12"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="FICHES RIS · identité canonique"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <ListBox x:Name="RisksList" Grid.Row="1" Margin="0,10,0,0"
                             SelectionChanged="RisksList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="7,7">
                                    <TextBlock Text="{Binding Label}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,0" FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="5" Padding="12"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="DÉTAILS · source Markdown"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="RiskDetailsBox" Grid.Row="1"
                             Margin="0,10,0,10"
                             IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" FontFamily="Consolas"
                             FontSize="12" VerticalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="DiagnosticsText" Grid.Row="2"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Orientation="Horizontal"
                       HorizontalAlignment="Right"
                       Margin="0,0,0,6">
                <Button x:Name="CreateRiskButton" Content="Nouveau risque…"
                        Padding="12,7" Margin="0,0,8,0"
                        Click="CreateRisk_Click" />
                <Button x:Name="MeasureButton"
                        Content="Suivi des mesures…"
                        Padding="12,7" Margin="0,0,8,6"
                        Click="Measure_Click"
                        ToolTip="Historiser explicitement l'avancement du plan courant" />
                <Button x:Name="TreatmentButton"
                        Content="Plan de traitement…"
                        Padding="12,7" Margin="0,0,8,6"
                        Click="Treatment_Click"
                        ToolTip="Choisir ou réviser la stratégie et les mesures du risque" />
                <Button x:Name="QualificationButton"
                        Content="Décider du statut…"
                        Padding="12,7" Margin="0,0,8,6"
                        Click="Qualification_Click" />
                <Button x:Name="InitialReviewButton"
                        Content="Qualifier l'initiale…"
                        Padding="12,7" Margin="0,0,8,0"
                        Click="InitialReview_Click" />
                <Button x:Name="ResidualReviewButton"
                        Content="Réévaluer la résiduelle…"
                        Padding="12,7" Margin="0,0,8,0"
                        Click="ResidualReview_Click" />
                <Button x:Name="OpenRiskButton" Content="Ouvrir la fiche"
                        Padding="12,7" Margin="0,0,8,0"
                        Click="OpenRisk_Click" />
                <Button Content="Recharger" Padding="12,7" Margin="0,0,8,0"
                        Click="Reload_Click" />
                <Button Content="Fermer" Padding="12,7"
                        Click="Close_Click" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Grid.Row="1"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Lecture du registre sans création de fichier…" />
        </Grid>
    </Grid>
</Window>
