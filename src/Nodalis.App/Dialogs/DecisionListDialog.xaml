<Window x:Class="Nodalis.App.Dialogs.DecisionListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Décisions"
        Width="980"
        Height="700"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Border Padding="16,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Decision Records"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ScopeText"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Margin="12,20,0,20"
                         Padding="8,5"
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="Rechercher dans les décisions" />

                <ComboBox x:Name="StatusFilterComboBox"
                          Grid.Column="2"
                          Margin="12,20,0,20"
                          Padding="6,3"
                          SelectionChanged="StatusFilterComboBox_SelectionChanged"
                          ToolTip="Filtrer par statut">
                    <ComboBoxItem Tag="All" Content="Tous les statuts" />
                    <ComboBoxItem Tag="Active" Content="Active" />
                    <ComboBoxItem Tag="Superseded" Content="Superseded" />
                    <ComboBoxItem Tag="Deprecated" Content="Deprecated" />
                    <ComboBoxItem Tag="Warning" Content="Chaînes incohérentes" />
                </ComboBox>
            </Grid>
        </Border>

        <ListBox x:Name="DecisionsList"
                 Grid.Row="1"
                 Margin="12"
                 BorderThickness="0"
                 Background="Transparent"
                 MouseDoubleClick="DecisionsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,7"
                            Padding="12"
                            CornerRadius="5"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />

                            <StackPanel Grid.Column="1"
                                        Margin="12,0">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding Decision}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource SecondaryTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SupersedesReference}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="Remplace : " />
                                    <Run Text="{Binding SupersedesReference}" />
                                </TextBlock>
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource SecondaryTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SupersededByReference}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="Remplacée par : " />
                                    <Run Text="{Binding SupersededByReference}" />
                                </TextBlock>
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding LifecycleWarning}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource AccentBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLifecycleWarning}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding SourceReference}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Status}"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding LifecycleState}"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           FontSize="10"
                                           Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Padding="12,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Width="92"
                            Margin="0,0,8,0"
                            Click="MarkActive_Click"
                            Content="Active" />
                    <Button Width="102"
                            Margin="0,0,8,0"
                            Click="MarkDeprecated_Click"
                            Content="Deprecated" />
                    <Button Width="116"
                            Margin="0,0,8,0"
                            Click="Supersede_Click"
                            Content="Remplacer…" />
                    <Button Width="90"
                            IsCancel="True"
                            Content="Fermer" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
