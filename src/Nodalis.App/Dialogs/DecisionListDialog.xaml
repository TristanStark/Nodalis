<Window x:Class="Nodalis.App.Dialogs.DecisionListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Décisions"
        Width="920"
        Height="680"
        MinWidth="720"
        MinHeight="500"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>

        <Border Padding="16,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Decision Records"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ScopeText"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Margin="12,18,0,18"
                         Padding="8,5"
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="Rechercher dans les décisions" />
            </Grid>
        </Border>

        <ListBox x:Name="DecisionsList"
                 Grid.Row="1"
                 Margin="12"
                 BorderThickness="0"
                 Background="Transparent"
                 MouseDoubleClick="DecisionsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,7"
                            Padding="12"
                            CornerRadius="5"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />

                            <StackPanel Grid.Column="1"
                                        Margin="12,0">
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding Decision}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding SourceReference}"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding Status}"
                                       HorizontalAlignment="Right"
                                       TextAlignment="Right"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Padding="12,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <Button Width="90"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Content="Fermer" />
            </Grid>
        </Border>
    </Grid>
</Window>
