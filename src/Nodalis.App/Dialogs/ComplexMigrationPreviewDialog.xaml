<Window x:Class="Nodalis.App.Dialogs.ComplexMigrationPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projet Complexe 2.0 — Inventaire en lecture seule"
        Width="900"
        Height="700"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Text="Prévisualisation de la structure Complexe 2.0"
                       FontWeight="SemiBold" FontSize="19"/>
            <TextBlock x:Name="SummaryText" Margin="0,6,0,0"
                       TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <ListBox x:Name="MovesList" Grid.Row="1"
                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12,8" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding SectionName}"/>
                            <TextBlock Text="{Binding From}" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                            <TextBlock Text="{Binding To}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding State}" FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="DOSSIERS DE LA STRUCTURE CIBLE ENCORE ABSENTS"
                       FontWeight="SemiBold" FontSize="11"/>
            <TextBox x:Name="MissingText" IsReadOnly="True"
                     Margin="0,5,0,0" MinHeight="45" MaxHeight="80"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="POINTS À QUALIFIER" FontWeight="SemiBold" FontSize="11"/>
            <TextBox x:Name="WarningsText" IsReadOnly="True"
                     Margin="0,5,0,0" MinHeight="55" MaxHeight="100"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button MinWidth="110" IsCancel="True" Content="Fermer"/>
        </StackPanel>
    </Grid>
</Window>
