<Window x:Class="Nodalis.App.Dialogs.RelationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une relation"
        Width="720"
        Height="410"
        MinWidth="560"
        MinHeight="370"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Type de relation" FontWeight="SemiBold"/>
        <ComboBox x:Name="RelationTypeComboBox" Grid.Row="1" Margin="0,7,0,0"
                  Height="32" IsEditable="True" IsTextSearchEnabled="True"
                  VerticalContentAlignment="Center"/>
        <TextBlock Grid.Row="3" Text="Cible : document, projet ou bloc Markdown identifié"
                   FontWeight="SemiBold"/>
        <TextBox x:Name="TargetSearchTextBox" Grid.Row="4" Margin="0,7,0,0"
                 Height="32" TextChanged="TargetSearchTextBox_TextChanged"
                 ToolTip="Rechercher un titre, un chemin ou un identifiant GUID"/>
        <ComboBox x:Name="TargetComboBox" Grid.Row="5" Margin="0,8,0,0"
                  Height="32" DisplayMemberPath="QualifiedName"
                  IsTextSearchEnabled="True"
                  SelectionChanged="TargetComboBox_SelectionChanged"
                  VerticalContentAlignment="Center"/>
        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <TextBlock x:Name="TargetCountText" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
            <TextBlock x:Name="TargetDetailsText" Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
        <TextBlock Grid.Row="7"
                   Text="La relation sera écrite dans le Markdown avec l’identifiant de la cible."
                   TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"/>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Margin="0,0,8,0" MinWidth="90" IsCancel="True" Content="Annuler"/>
            <Button MinWidth="100" IsDefault="True" Click="Save_Click" Content="Ajouter"/>
        </StackPanel>
    </Grid>
</Window>
