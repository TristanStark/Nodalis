<Window x:Class="Nodalis.App.Dialogs.ProjectRequirementCriteriaReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Requalification des critères CA · Passation EXI A"
        Width="760" Height="665" MinWidth="570" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Revue explicite des critères d'acceptation"
                       FontSize="19" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,7,0,2"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Chaque CA conserve son GUID historique et son contenu en mode A. Cochez individuellement les critères vérifiés. Le contrôle des références GUID et CA-xx sera relancé avant toute écriture." />
            <TextBlock x:Name="CountText" FontWeight="SemiBold"
                       Margin="0,6,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="Justification de la requalification"
                       FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="RationaleBox" Padding="8,6"
                     MaxLength="2000" MinHeight="65"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     TextChanged="ReviewChanged" />
            <TextBlock TextWrapping="Wrap" Margin="0,5,0,8"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Confirmez les identités et l'absence de références externes non réconciliées. Les verdicts et preuves existants ne sont pas recalculés automatiquement." />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Annuler" Padding="12,7"
                        Margin="0,0,8,0" IsCancel="True" />
                <Button x:Name="ApproveButton"
                        Content="Valider les CA et poursuivre…"
                        Padding="12,7" IsDefault="True"
                        IsEnabled="False" Click="Approve_Click" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="CriteriaPanel" />
        </ScrollViewer>
    </DockPanel>
</Window>