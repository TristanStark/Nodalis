<Window x:Class="Nodalis.App.Dialogs.RecoverableErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Erreur récupérée"
        Width="650"
        Height="390"
        MinWidth="520"
        MinHeight="340"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="L'action a été interrompue"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="12"
                Background="{StaticResource PanelElevatedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock Text="Contexte"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ContextText"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,10,0,0"
                           Text="Identifiant d'erreur"
                           FontWeight="SemiBold" />
                <TextBox x:Name="ErrorIdTextBox"
                         Margin="0,3,0,0"
                         IsReadOnly="True" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Margin="0,14,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Le détail technique a été journalisé localement. Vous pouvez continuer à utiliser Nodalis."
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Click="CopyDetails_Click"
                    Content="Copier les détails" />
            <Button Margin="0,0,8,0"
                    Click="OpenDiagnostics_Click"
                    Content="Diagnostics" />
            <Button IsDefault="True"
                    Click="Continue_Click"
                    Content="Continuer" />
        </StackPanel>
    </Grid>
</Window>
