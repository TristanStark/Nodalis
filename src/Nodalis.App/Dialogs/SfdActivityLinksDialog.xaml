<Window x:Class="Nodalis.App.Dialogs.SfdActivityLinksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Liens activités et fonctionnalités SFD"
        Width="710" Height="520" MinWidth="560" MinHeight="430"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Traçabilité activités ↔ fonctionnalités"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1"
                   Text="Associer les objets par GUID, sans dupliquer d'activité. Aucun lien n'est déduit de l'arborescence."
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Activité" VerticalAlignment="Center"/>
            <ComboBox x:Name="ActivityComboBox" Grid.Column="1" MinHeight="30"
                      DisplayMemberPath="Label"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Fonctionnalité" VerticalAlignment="Center"/>
            <ComboBox x:Name="FunctionalityComboBox" Grid.Column="1"
                      MinHeight="30" DisplayMemberPath="Label"/>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="AddButton" Content="Associer"
                        Width="110" Margin="0,0,8,0" Click="Add_Click"/>
                <Button x:Name="RemoveButton" Content="Dissocier le lien"
                        Width="140" Click="Remove_Click"/>
            </StackPanel>
            <ListBox x:Name="LinksListBox" Grid.Row="1"
                     DisplayMemberPath="Label"
                     SelectionChanged="Links_SelectionChanged"
                     MinHeight="100"/>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,0,16,0"/>
            <Button Content="Fermer" Width="95" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
