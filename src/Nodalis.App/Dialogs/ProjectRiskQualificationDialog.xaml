<Window x:Class="Nodalis.App.Dialogs.ProjectRiskQualificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qualification métier du risque · Nodalis 2.0"
        Width="650" Height="525" MinWidth="500" MinHeight="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadingText" FontSize="18"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="ContextText" Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Nouveau statut métier"
                   FontWeight="SemiBold" />
        <ComboBox x:Name="StatusCombo" Grid.Row="2"
                  MinHeight="34" Margin="0,6,0,12" />
        <StackPanel Grid.Row="3">
            <TextBlock Text="Décideur" FontWeight="SemiBold" />
            <TextBox x:Name="ActorBox" MaxLength="120"
                     Margin="0,6,0,12" />
        </StackPanel>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Justification de la décision (10 caractères minimum)"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBox x:Name="RationaleBox" Grid.Row="1"
                     Margin="0,6,0,0" MinHeight="100"
                     MaxLength="4000" TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" />
        </Grid>
        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annuler" Padding="12,8"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Proposer la décision" Padding="12,8"
                        Click="Accept_Click" />
            </StackPanel>
            <TextBlock Text="Ne modifie aucun score ni le cycle de vie."
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </DockPanel>
    </Grid>
</Window>
