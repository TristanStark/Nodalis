<Window x:Class="Nodalis.App.Dialogs.DocxImportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:Nodalis.App.Dialogs"
        Title="Prévisualisation de l'import DOCX"
        Width="980"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Border Padding="18,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Importer un document Word"
                           FontSize="19"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SourceText"
                           Margin="0,4,0,0"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <TabControl x:Name="ImportTabs"
                    Grid.Row="1"
                    Margin="14"
                    SelectionChanged="ImportTabs_SelectionChanged">
            <TabItem Header="Cible">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,0,0,16"
                                   Text="Choisissez explicitement la destination. La détection automatique ne modifie jamais le workspace avant validation."
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Application" />
                        <ComboBox x:Name="ApplicationComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  MinHeight="32"
                                  DisplayMemberPath="QualifiedName"
                                  SelectionChanged="ApplicationComboBox_SelectionChanged" />

                        <TextBlock Grid.Row="2"
                                   Margin="0,14,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Projet existant" />
                        <ComboBox x:Name="ProjectComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="0,14,0,0"
                                  MinHeight="32"
                                  DisplayMemberPath="QualifiedName"
                                  SelectionChanged="TargetSelection_Changed" />

                        <CheckBox x:Name="CreateNewProjectCheckBox"
                                  Grid.Row="3"
                                  Grid.Column="1"
                                  Margin="0,16,0,0"
                                  Checked="CreateNewProjectCheckBox_Changed"
                                  Unchecked="CreateNewProjectCheckBox_Changed"
                                  Content="Créer un nouveau projet pour cet import" />

                        <TextBlock Grid.Row="4"
                                   Margin="0,14,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Nom du nouveau projet" />
                        <TextBox x:Name="NewProjectNameTextBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="0,14,0,0"
                                 MinHeight="32"
                                 Padding="7,4"
                                 TextChanged="TargetText_Changed" />

                        <TextBlock Grid.Row="5"
                                   Margin="0,12,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Structure initiale" />
                        <ComboBox x:Name="ComplexityComboBox"
                                  Grid.Row="5"
                                  Grid.Column="1"
                                  Margin="0,12,0,0"
                                  MinHeight="32"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="TargetSelection_Changed" />

                        <Border Grid.Row="6"
                                Grid.ColumnSpan="2"
                                Margin="0,22,0,0"
                                Padding="12"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="Détection"
                                           FontWeight="SemiBold" />
                                <ItemsControl x:Name="DetectionNotesItems"
                                              Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,2"
                                                       TextWrapping="Wrap">
                                                <Run Text="• " />
                                                <Run Text="{Binding Path=., Mode=OneWay}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Sections">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="DocumentSelectionCheckBox"
                                  Margin="2,0,0,8"
                                  IsThreeState="True"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  FontWeight="SemiBold"
                                  Content="Document entier" />

                        <StackPanel Grid.Row="1"
                                    Margin="0,0,0,8"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,6,0"
                                    Padding="8,3"
                                    Click="SelectAllBlocks_Click"
                                    Content="Tout sélectionner" />
                            <Button Padding="8,3"
                                    Click="DeselectAllBlocks_Click"
                                    Content="Tout désélectionner" />
                        </StackPanel>

                        <ListBox x:Name="SectionsListBox"
                                 Grid.Row="2"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2,3"
                                            Padding="10"
                                            Background="{StaticResource PanelBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <CheckBox IsChecked="{Binding SelectionRoot.IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsThreeState="True"
                                                      FontWeight="SemiBold"
                                                      Content="{Binding SourceHeading}" />

                                            <Grid Grid.Row="1"
                                                  Margin="22,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Margin="0,5,8,0"
                                                           Text="Vers :" />
                                                <TextBox Grid.Column="1"
                                                         MinHeight="30"
                                                         Padding="6,3"
                                                         Text="{Binding TargetSection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>

                                            <TextBlock Grid.Row="2"
                                                       Margin="22,6,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}">
                                                <Run Text="{Binding BlockCount}" />
                                                <Run Text=" bloc(s) sélectionnable(s)" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                        </Grid.RowDefinitions>

                        <TextBlock Margin="0,0,0,8"
                                   Text="Contenu Word sélectionnable"
                                   FontWeight="SemiBold" />

                        <TreeView x:Name="ContentTreeView"
                                  Grid.Row="1"
                                  Margin="0,0,0,12"
                                  ItemsSource="{Binding SelectedItem.SelectionRoot.Children, ElementName=SectionsListBox}">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type dialogs:DocxImportSelectionNode}"
                                                          ItemsSource="{Binding Children}">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsThreeState="True"
                                              ToolTip="{Binding MarkdownPreview}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding KindLabel}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </CheckBox>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <TextBlock Grid.Row="2"
                                   Margin="0,0,0,8"
                                   Text="Aperçu Markdown de la sélection"
                                   FontWeight="SemiBold" />

                        <TextBox Grid.Row="3"
                                 Padding="10"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Text="{Binding SelectedItem.MarkdownPreview, ElementName=SectionsListBox, Mode=OneWay}" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="FilesTab"
                     Header="Fichiers">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Plan d'écriture"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <TextBlock x:Name="PlanTargetText"
                               Grid.Row="1"
                               Margin="0,6,0,10"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Sélectionnez une cible valide pour calculer le plan."
                               TextWrapping="Wrap" />

                    <ListBox x:Name="PlannedChangesList"
                             Grid.Row="2"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3"
                                        Padding="10"
                                        Background="{StaticResource PanelBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Action}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding RelativePath}"
                                                       FontFamily="Consolas"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0"
                                                       Text="{Binding Description}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3"
                               Margin="0,14,0,6"
                               Text="Avertissements du plan"
                               FontWeight="SemiBold" />

                    <ItemsControl x:Name="PlanWarningsItems"
                                  Grid.Row="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2"
                                           TextWrapping="Wrap">
                                    <Run Text="• " />
                                    <Run Text="{Binding Path=., Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>

            <TabItem Header="Diagnostic">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Points d'attention"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <ItemsControl x:Name="WarningsItems"
                                      Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3"
                                            Padding="10"
                                            Background="{StaticResource PanelBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding Path=., Mode=OneWay}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,20,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Le fichier DOCX original n'est jamais modifié. Une copie temporaire est conservée uniquement pendant cette prévisualisation ; Annuler la supprime."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Padding="14,9"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="SummaryText"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Width="96"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Content="Annuler" />
                    <Button x:Name="ImportButton"
                            Width="170"
                            IsDefault="True"
                            Click="Import_Click"
                            Content="Prévisualiser les fichiers" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
