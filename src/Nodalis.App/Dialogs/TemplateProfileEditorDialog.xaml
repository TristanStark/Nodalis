<Window x:Class="Nodalis.App.Dialogs.TemplateProfileEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Templates et profils de projet"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Templates et profils de projet"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="Les fichiers Markdown et JSON du dossier Templates restent les sources canoniques. Les changements de profil s'appliquent uniquement aux futurs projets." />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Templates">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="290" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="12"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="TEMPLATES"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />

                            <ListBox x:Name="TemplatesList"
                                     Grid.Row="1"
                                     Margin="0,8,0,10"
                                     SelectionChanged="TemplatesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,5">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Text="{Binding Category}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Margin="0,1,0,0"
                                                       Text="{Binding Key}"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <WrapPanel Grid.Row="2">
                                <Button Margin="0,0,6,6"
                                        Padding="10,5"
                                        Click="DuplicateTemplate_Click"
                                        Content="Dupliquer" />
                                <Button Margin="0,0,0,6"
                                        Padding="10,5"
                                        Click="RestoreTemplate_Click"
                                        Content="Restaurer par défaut" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Padding="12"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Nom"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="TemplateDisplayNameTextBox"
                                         Grid.Row="1"
                                         Margin="0,6,0,0"
                                         Padding="7,5"
                                         TextChanged="TemplateField_TextChanged" />

                                <TextBlock Grid.Column="2"
                                           Text="Catégorie"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="TemplateCategoryTextBox"
                                         Grid.Row="1"
                                         Grid.Column="2"
                                         Margin="0,6,0,0"
                                         Padding="7,5"
                                         TextChanged="TemplateField_TextChanged" />

                                <TextBlock Grid.Column="4"
                                           Text="Nom de fichier généré"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="TemplateDefaultFileNameTextBox"
                                         Grid.Row="1"
                                         Grid.Column="4"
                                         Margin="0,6,0,0"
                                         Padding="7,5"
                                         FontFamily="Consolas"
                                         TextChanged="TemplateField_TextChanged" />

                                <TextBlock Grid.Row="2"
                                           Margin="0,10,0,0"
                                           Text="Clé stable"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="TemplateKeyTextBox"
                                         Grid.Row="3"
                                         Margin="0,6,0,0"
                                         Padding="7,5"
                                         IsReadOnly="True"
                                         FontFamily="Consolas" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="2"
                                           Grid.ColumnSpan="3"
                                           Margin="0,10,0,0"
                                           Text="Les clés et fichiers de stockage restent stables. Dupliquez un template pour en créer un nouveau."
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1"
                              Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Padding="12"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="120" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="MARKDOWN"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="TemplateContentTextBox"
                                             Grid.Row="1"
                                             Margin="0,8,0,10"
                                             Padding="8"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             TextWrapping="NoWrap"
                                             TextChanged="TemplateField_TextChanged" />

                                    <TextBlock Grid.Row="2"
                                               Text="Valeurs de prévisualisation · une ligne nom=valeur"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBox x:Name="PreviewVariablesTextBox"
                                             Grid.Row="3"
                                             Margin="0,6,0,0"
                                             Padding="8"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             TextChanged="PreviewVariablesTextBox_TextChanged" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="12"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="PRÉVISUALISATION"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />

                                    <FlowDocumentScrollViewer x:Name="TemplatePreview"
                                                              Grid.Row="1"
                                                              Margin="0,8,0,8"
                                                              VerticalScrollBarVisibility="Auto"
                                                              IsToolBarVisible="False" />

                                    <TextBlock x:Name="PreviewStatusText"
                                               Grid.Row="2"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <DockPanel Grid.Row="2"
                                   Margin="0,14,0,0">
                            <TextBlock x:Name="TemplateStatusText"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button DockPanel.Dock="Right"
                                    MinWidth="150"
                                    Padding="14,6"
                                    Click="SaveTemplate_Click"
                                    Content="Enregistrer le template" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Profils projet">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="12"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Profil"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="ProfilesComboBox"
                                          Margin="0,6,0,0"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="ProfilesComboBox_SelectionChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nom affiché"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="ProfileDisplayNameTextBox"
                                         Margin="0,6,0,0"
                                         Padding="7,5" />
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Margin="14,18,0,0"
                                    Padding="12,6"
                                    VerticalAlignment="Center"
                                    Click="RestoreProfile_Click"
                                    Content="Restaurer ce profil" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Padding="12"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="SECTIONS INITIALES"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                <ListBox x:Name="ProfileSectionsList"
                                         Grid.Row="1"
                                         Margin="0,8,0,10"
                                         SelectionChanged="ProfileSectionsList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,5">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Margin="0,2,0,0"
                                                           Text="{Binding Detail}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <WrapPanel Grid.Row="2">
                                    <Button Margin="0,0,6,6"
                                            Padding="10,5"
                                            Click="MoveProfileSectionUp_Click"
                                            Content="↑ Monter" />
                                    <Button Margin="0,0,6,6"
                                            Padding="10,5"
                                            Click="MoveProfileSectionDown_Click"
                                            Content="↓ Descendre" />
                                    <Button Margin="0,0,6,6"
                                            Padding="10,5"
                                            Click="AddProfileSection_Click"
                                            Content="Ajouter" />
                                    <Button Margin="0,0,0,6"
                                            Padding="10,5"
                                            Click="RemoveProfileSection_Click"
                                            Content="Supprimer" />
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Padding="12"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="SECTION SÉLECTIONNÉE"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,16,0,0"
                                           Text="Nom"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBox x:Name="ProfileSectionNameTextBox"
                                         Grid.Row="2"
                                         Margin="0,6,0,0"
                                         Padding="7,5" />

                                <TextBlock Grid.Row="3"
                                           Margin="0,14,0,0"
                                           Text="Template initial"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <ComboBox x:Name="ProfileSectionTemplateComboBox"
                                          Grid.Row="4"
                                          Margin="0,6,0,0"
                                          Padding="6,4"
                                          DisplayMemberPath="DisplayName" />

                                <DockPanel Grid.Row="5"
                                           Margin="0,14,0,0">
                                    <CheckBox x:Name="ProfileSectionSingletonCheckBox"
                                              VerticalAlignment="Center"
                                              Content="Document unique dans la section" />
                                    <Button DockPanel.Dock="Right"
                                            Padding="12,5"
                                            Click="ApplyProfileSection_Click"
                                            Content="Appliquer à la section" />
                                </DockPanel>

                                <TextBlock Grid.Row="6"
                                           Margin="0,18,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="L'ordre est enregistré par pas de 10. Une section sans template crée seulement son dossier initial. Les projets existants ne sont jamais remodelés automatiquement." />
                            </Grid>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="2"
                               Margin="0,14,0,0">
                        <TextBlock x:Name="ProfileStatusText"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button DockPanel.Dock="Right"
                                MinWidth="150"
                                Padding="14,6"
                                Click="SaveProfile_Click"
                                Content="Enregistrer le profil" />
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2"
                Width="90"
                Margin="0,14,0,0"
                HorizontalAlignment="Right"
                IsCancel="True"
                Content="Fermer" />
    </Grid>
</Window>
