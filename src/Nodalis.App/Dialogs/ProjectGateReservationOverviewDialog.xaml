<Window x:Class="Nodalis.App.Dialogs.ProjectGateReservationOverviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vue transversale des réserves · Projet"
        Width="950" Height="685" MinWidth="620" MinHeight="450"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Réserves du projet"
                       FontWeight="SemiBold" FontSize="21"/>
            <TextBlock Text="Vue de consultation · les états sont calculés depuis les décisions et l'historique humain, sans modification des sources."
                       Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="5"
                Padding="12" Margin="0,0,0,11">
            <WrapPanel>
                <TextBlock x:Name="OpenCountText" FontWeight="SemiBold"
                           Margin="0,0,22,0"/>
                <TextBlock x:Name="LiftedCountText" FontWeight="SemiBold"
                           Margin="0,0,22,0"/>
                <TextBlock x:Name="OverdueCountText" FontWeight="SemiBold"
                           Margin="0,0,22,0"/>
                <TextBlock x:Name="OwnerCountText" FontWeight="SemiBold"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" MinHeight="30"
                     ToolTip="Rechercher une réserve, un gate ou un responsable"
                     TextChanged="SearchBox_TextChanged" />
            <ComboBox Grid.Column="2" x:Name="FilterCombo"
                      MinHeight="30"
                      SelectionChanged="FilterCombo_SelectionChanged">
                <ComboBoxItem Content="Toutes"/>
                <ComboBoxItem Content="Ouvertes"/>
                <ComboBoxItem Content="Levées"/>
                <ComboBoxItem Content="En retard"/>
                <ComboBoxItem Content="Sans responsable"/>
            </ComboBox>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <ListBox Grid.Column="0" x:Name="ReservationsList"
                     SelectionChanged="ReservationsList_SelectionChanged"
                     MouseDoubleClick="ReservationsList_MouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="8,7">
                            <TextBlock Text="{Binding Label}"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}"
                                       Margin="0,3,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="DOSSIER D'ORIGINE"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBox Grid.Row="1" x:Name="DetailsBox"
                             FontFamily="Consolas" FontSize="11"
                             IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="NavigateButton" Content="Ouvrir le dossier…"
                        Padding="14,8" Margin="0,0,8,0" IsEnabled="False"
                        Click="NavigateButton_Click"/>
                <Button Content="Fermer" Padding="14,8"
                        Click="CloseButton_Click"/>
            </StackPanel>
            <TextBlock x:Name="ResultsText" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
