<Window x:Class="Nodalis.App.Dialogs.ProjectTestCampaignDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Décision de campagne REC · Nodalis 2.0"
        Width="730" Height="660" MinWidth="550" MinHeight="530"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="140"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Grid.Row="0"
                   FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="ContextText" Grid.Row="1"
                   Margin="0,7,0,11" TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}"/>
        <GroupBox Grid.Row="2" Header="Avertissements de qualification (non bloquants)"
                  Padding="7" Margin="0,0,0,13">
            <TextBox x:Name="WarningsBox" IsReadOnly="True"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Réserves et avertissements de qualification"/>
        </GroupBox>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Décideur (obligatoire)" Margin="0,0,0,5"/>
            <TextBox x:Name="ActorBox" MinHeight="30"
                     AutomationProperties.Name="Auteur de la décision REC"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Justification humaine (obligatoire)"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="RationaleBox" MinHeight="30"
                     AutomationProperties.Name="Justification de la décision REC"/>
        </StackPanel>
        <StackPanel x:Name="VerdictGroup" Grid.Row="5" Margin="0,0,0,12">
            <TextBlock Text="Verdict de clôture" Margin="0,0,0,5"/>
            <ComboBox x:Name="VerdictCombo" MinHeight="32"
                      SelectionChanged="VerdictCombo_SelectionChanged"
                      AutomationProperties.Name="Verdict humain de clôture">
                <ComboBoxItem Content="Validée"/>
                <ComboBoxItem Content="Validée avec réserves"/>
                <ComboBoxItem Content="Non validée"/>
            </ComboBox>
        </StackPanel>
        <StackPanel x:Name="ReservationsGroup" Grid.Row="6"
                    Margin="0,0,0,10">
            <TextBlock Text="Réserves explicites (une par ligne)"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="ReservationsBox" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     MinHeight="60"
                     AutomationProperties.Name="Réserves humaines de clôture"/>
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Une clôture avec réserves exige au moins une réserve. Aucune preuve n'est approuvée automatiquement."/>
        </StackPanel>
        <DockPanel Grid.Row="7" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Retour" IsCancel="True"
                        Padding="13,8" Margin="0,0,8,0"/>
                <Button x:Name="ConfirmButton" Content="Relire la décision"
                        IsDefault="True" Padding="13,8"
                        Click="Confirm_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
