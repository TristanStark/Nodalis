<Window x:Class="Nodalis.App.Dialogs.ProjectDeploymentClosureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bilan de mise en production · décision humaine"
        Width="700" Height="660" MinWidth="525" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Clôturer une opération de mise en production"
                       FontSize="19" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Une seule décision finale, figée dans le Markdown. Elle ne modifie ni les tentatives, ni les risques, ni les jalons et n'exécute aucune MEP." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" IsCancel="True"
                    Padding="12,7" Margin="0,0,8,0" />
            <Button Content="Vérifier puis consigner le bilan…"
                    IsDefault="True" Padding="12,7"
                    Click="Accept_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="HistoryText" TextWrapping="Wrap"
                           FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="Verdict métier de l'opération"
                           Margin="0,0,0,5" />
                <ComboBox x:Name="OutcomeCombo" Padding="8,6"
                          DisplayMemberPath="Label"
                          SelectionChanged="OutcomeCombo_SelectionChanged" />
                <TextBlock x:Name="EffectiveLabel" Margin="0,12,0,4"
                           Text="Date réelle de déploiement (jj/MM/aaaa HH:mm)" />
                <TextBox x:Name="EffectiveBox" Padding="8,6"
                         ToolTip="Date réellement constatée, pas celle de la clôture ni celle de la tentative" />
                <TextBlock Text="Responsable du bilan" Margin="0,12,0,4" />
                <TextBox x:Name="ActorBox" Padding="8,6" />
                <TextBlock Text="Justification et contrôles humains" Margin="0,12,0,4" />
                <TextBox x:Name="ReasonBox" Padding="8,6" MinHeight="74"
                         TextWrapping="Wrap" AcceptsReturn="True" />
                <TextBlock x:Name="ReservationLabel"
                           Text="Réserves explicites et suivi nécessaire"
                           Margin="0,12,0,4" />
                <TextBox x:Name="ReservationsBox" Padding="8,6" MinHeight="70"
                         TextWrapping="Wrap" AcceptsReturn="True" />
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="La date de clôture est horodatée au moment de la confirmation. La date effective doit être saisie uniquement pour une réussite. Aucun succès ne peut être déduit d'un rollback." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
