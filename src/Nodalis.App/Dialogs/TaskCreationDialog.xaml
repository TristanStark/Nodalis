<Window x:Class="Nodalis.App.Dialogs.TaskCreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle tâche"
        Width="580"
        Height="610"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Nouvelle tâche"
                   FontSize="18"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="Tâche" />
            <TextBox x:Name="TaskTextBox"
                     Grid.Row="0"
                     Grid.Column="1"
                     Margin="0,0,0,12"
                     Padding="8,5" />

            <TextBlock Grid.Row="1"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="Responsable" />
            <TextBox x:Name="OwnerTextBox"
                     Grid.Row="1"
                     Grid.Column="1"
                     Margin="0,0,0,12"
                     Padding="8,5" />

            <TextBlock Grid.Row="2"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="Échéance" />
            <DatePicker x:Name="DueDatePicker"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,0,0,12"
                        Padding="8,5"
                        SelectedDateFormat="Short"
                        ToolTip="Sélectionnez une date ou laissez vide." />

            <TextBlock Grid.Row="3"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="Priorité" />
            <ComboBox x:Name="PriorityComboBox"
                      Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      Padding="8,5"
                      IsEditable="False"
                      SelectedIndex="2">
                <ComboBoxItem Content="Critique" />
                <ComboBoxItem Content="Haute" />
                <ComboBoxItem Content="Normale" />
                <ComboBoxItem Content="Basse" />
            </ComboBox>

            <TextBlock Grid.Row="4"
                       Margin="0,0,12,12"
                       VerticalAlignment="Center"
                       Text="Statut" />
            <ComboBox x:Name="StatusComboBox"
                      Grid.Row="4"
                      Grid.Column="1"
                      Margin="0,0,0,12"
                      Padding="8,5"
                      IsEditable="False"
                      SelectedIndex="0">
                <ComboBoxItem Content="À faire" />
                <ComboBoxItem Content="En cours" />
                <ComboBoxItem Content="Bloqué" />
                <ComboBoxItem Content="En attente" />
            </ComboBox>

            <TextBlock Grid.Row="5"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Text="Tags" />
            <TextBox x:Name="TagsTextBox"
                     Grid.Row="5"
                     Grid.Column="1"
                     Padding="8,5"
                     ToolTip="Séparez les tags par des virgules." />
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,0,8,0"
                    MinWidth="90"
                    IsCancel="True"
                    Content="Annuler" />
            <Button MinWidth="110"
                    IsDefault="True"
                    Click="Create_Click"
                    Content="Créer" />
        </StackPanel>
    </Grid>
</Window>
