<Window x:Class="Nodalis.App.Dialogs.ProjectRecAnomaliesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anomalies de recette · Nodalis 2.0"
        Width="1020" Height="720" MinWidth="710" MinHeight="470"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Anomalies de recette · lecture seule"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,6" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Projection des résultats humains Non conforme / Bloqué enregistrés. Les associations, interventions et anciens résultats conformes n'établissent jamais à eux seuls une résolution ou une revalidation."/>
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="9"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="8" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="RÉSULTATS HISTORIQUES"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <ListBox x:Name="AnomaliesList" Grid.Row="1"
                             Margin="0,8,0,0"
                             SelectionChanged="Anomalies_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,5">
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="8" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CONTEXTE ET LIENS ACTIFS"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="DetailsBox" Grid.Row="1"
                             IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="Consolas"
                             FontSize="11" Margin="0,8,0,8"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Détails historiques et liens d'incidents"/>
                    <TextBlock Grid.Row="2" Text="DIAGNOSTICS ET LIMITES"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="DiagnosticsBox" Grid.Row="3"
                             IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontSize="11"
                             Margin="0,8,0,0"
                             VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Avertissements de la projection de recette"/>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Fermer" Padding="13,8" IsCancel="True"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"/>
            <TextBlock Text="Aucune donnée source modifiée."
                       Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
