<Window x:Class="Nodalis.App.Dialogs.ProjectDeploymentReservationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suivi des réserves · exploitation"
        Width="1060" Height="780" MinWidth="700" MinHeight="490"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Suivi des réserves en exploitation"
                       FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="OperationText" Margin="0,5,0,0"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Chaque réserve est suivie séparément de la fiche MEP, qui reste immuable après son bilan. Seules des décisions humaines ajoutent des événements ; rien n'est résolu automatiquement." />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="5" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="RÉSERVES DE CETTE MEP"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,8" />
                    <ListBox x:Name="ReservationsList"
                             SelectionChanged="ReservationsList_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Label}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,3,0,0" FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <TabControl Grid.Column="2" x:Name="ModeTabs">
                <TabItem Header="Consulter / suivre">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="DetailsBox" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="12"
                                 Padding="10" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 TextWrapping="Wrap" />
                        <ScrollViewer Grid.Row="1" MaxHeight="280"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="Nouvelle action humaine"
                                           Margin="0,0,0,5"
                                           FontWeight="SemiBold" />
                                <ComboBox x:Name="ActionCombo" Padding="7,5"
                                          DisplayMemberPath="Label"
                                          SelectionChanged="ActionCombo_SelectionChanged" />
                                <TextBlock x:Name="NewOwnerLabel"
                                           Text="Nouveau responsable (réattribution)"
                                           Margin="0,8,0,4" />
                                <TextBox x:Name="NewOwnerBox" Padding="7,5" />
                                <TextBlock Text="Auteur de la décision"
                                           Margin="0,8,0,4" />
                                <TextBox x:Name="ActionActorBox" Padding="7,5" />
                                <TextBlock Text="Motif / constats"
                                           Margin="0,8,0,4" />
                                <TextBox x:Name="ActionReasonBox" Padding="7,5"
                                         MinHeight="52" AcceptsReturn="True"
                                         TextWrapping="Wrap" />
                                <TextBlock Text="Preuve du projet (chemin relatif au workspace, facultatif)"
                                           Margin="0,8,0,4" TextWrapping="Wrap" />
                                <TextBox x:Name="EvidenceBox" Padding="7,5" />
                                <Button x:Name="RecordButton"
                                        Content="Consigner cette action…"
                                        Click="Record_Click" Padding="12,7"
                                        HorizontalAlignment="Right"
                                        Margin="0,9,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Créer une réserve">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">
                            <TextBlock Text="Décision MEP à l'origine"
                                       Margin="0,0,0,5" />
                            <ComboBox x:Name="OriginCombo" Padding="7,5"
                                      DisplayMemberPath="Label"
                                      SelectionChanged="OriginCombo_SelectionChanged" />
                            <TextBlock x:Name="OriginSummaryText"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,7,0,10" />
                            <TextBlock Text="Intitulé de la réserve"
                                       Margin="0,0,0,4" />
                            <TextBox x:Name="TitleBox" Padding="7,5" />
                            <TextBlock Text="Action / description à reprendre"
                                       Margin="0,10,0,4" />
                            <TextBox x:Name="DescriptionBox" Padding="7,5"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="85" />
                            <TextBlock Text="Responsable exploitation"
                                       Margin="0,10,0,4" />
                            <TextBox x:Name="OwnerBox" Padding="7,5" />
                            <TextBlock Text="Auteur de la reprise"
                                       Margin="0,10,0,4" />
                            <TextBox x:Name="CreatorBox" Padding="7,5" />
                            <TextBlock Text="Échéance facultative"
                                       Margin="0,10,0,4" />
                            <DatePicker x:Name="DueDatePicker" />
                            <Button x:Name="CreateButton"
                                    Content="Créer la réserve suivie…"
                                    Click="Create_Click" Padding="12,7"
                                    HorizontalAlignment="Right"
                                    Margin="0,12,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0"
                   LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Fermer" IsCancel="True"
                    Padding="12,7" Click="Close_Click" />
            <Button x:Name="RelationsButton" DockPanel.Dock="Right"
                    Content="Liens tâche/jalon…" Click="Relations_Click"
                    Padding="12,7" Margin="0,0,8,0"
                    ToolTip="Associer/dissocier uniquement les identifiants persistants déjà présents dans le projet" />
            <Button DockPanel.Dock="Right" Content="Actualiser"
                    Padding="12,7" Margin="0,0,8,0"
                    Click="Refresh_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="Lecture seule jusqu'à une action explicite." />
        </DockPanel>
    </Grid>
</Window>
