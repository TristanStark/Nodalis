<Window x:Class="Nodalis.App.Dialogs.InboxCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capturer dans Inbox"
        Width="620"
        Height="360"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Text="Nouvelle capture Inbox" />
            <TextBlock Margin="0,6,0,14"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="Capture volontaire : saisissez du texte ou du Markdown. Les captures de fichiers et d'images arriveront dans la prochaine étape." />
        </StackPanel>
        <TextBox x:Name="CaptureTextBox"
                 Grid.Row="1"
                 Padding="10"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="Wrap"
                 AutomationProperties.Name="Contenu de la capture Inbox" />
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Width="94"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Annuler" />
            <Button Width="125"
                    IsDefault="True"
                    Click="Save_Click"
                    Content="Enregistrer" />
        </StackPanel>
    </Grid>
</Window>
