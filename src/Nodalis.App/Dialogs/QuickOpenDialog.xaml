<Window x:Class="Nodalis.App.Dialogs.QuickOpenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Open"
        Width="820"
        Height="560"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Padding="14,11"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <TextBox x:Name="QueryTextBox"
                     Padding="10,6"
                     FontSize="16"
                     TextChanged="QueryTextBox_TextChanged"
                     PreviewKeyDown="QueryTextBox_PreviewKeyDown" />
        </Border>

        <ListBox x:Name="ResultsList"
                 Grid.Row="1"
                 BorderThickness="0"
                 Background="{StaticResource WindowBackgroundBrush}"
                 SelectionMode="Single"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Margin="0,0,10,0"
                                Padding="7,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                CornerRadius="4"
                                Background="{StaticResource PanelElevatedBrush}">
                            <TextBlock Text="{Binding KindLabel}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                <Run Text="{Binding FavoriteMarker, Mode=OneWay}"
                                     Foreground="{StaticResource AccentBrush}" />
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0"
                                       Text="{Binding QualifiedPath}"
                                       FontSize="11"
                                       FontFamily="Consolas"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Padding="12,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="↑ ↓ naviguer · Entrée ouvrir · Échap fermer" />
        </Border>
    </Grid>
</Window>
