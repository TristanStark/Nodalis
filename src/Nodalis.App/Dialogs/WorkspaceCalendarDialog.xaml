<Window x:Class="Nodalis.App.Dialogs.WorkspaceCalendarDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendrier du workspace"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Padding="16,12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Calendrier du workspace"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="Vue dérivée des échéances Markdown, jalons et réunions. Aucun calendrier secondaire n'est stocké."
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="ViewModeComboBox"
                      Grid.Column="0"
                      Width="105"
                      Margin="0,0,8,0"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Mois"
                              Tag="Month"
                              IsSelected="True" />
                <ComboBoxItem Content="Semaine"
                              Tag="Week" />
            </ComboBox>

            <Button Grid.Column="1"
                    Width="32"
                    Margin="0,0,4,0"
                    Click="Previous_Click"
                    Content="‹" />
            <DatePicker x:Name="AnchorDatePicker"
                        Grid.Column="2"
                        Width="130"
                        SelectedDateChanged="AnchorDatePicker_SelectedDateChanged" />
            <Button Grid.Column="3"
                    Width="32"
                    Margin="4,0,12,0"
                    Click="Next_Click"
                    Content="›" />

            <ComboBox x:Name="ApplicationFilter"
                      Grid.Column="4"
                      Width="170"
                      Margin="0,0,8,0"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="ProjectFilter"
                      Grid.Column="5"
                      Width="190"
                      HorizontalAlignment="Left"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox x:Name="TypeFilter"
                      Grid.Column="6"
                      Width="130"
                      Margin="8,0,8,0"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Tous les types"
                              Tag="All"
                              IsSelected="True" />
                <ComboBoxItem Content="Tâches"
                              Tag="Task" />
                <ComboBoxItem Content="Jalons"
                              Tag="Milestone" />
                <ComboBoxItem Content="Réunions"
                              Tag="Meeting" />
            </ComboBox>

            <Button Grid.Column="7"
                    Click="Refresh_Click"
                    Content="Actualiser" />
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Margin="14,0,14,10"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DaysItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True"
                                   Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding CardWidth}"
                                MinHeight="150"
                                Margin="3"
                                Padding="8"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Background="{StaticResource PanelBackgroundBrush}"
                                AllowDrop="True"
                                Drop="Day_Drop"
                                DragOver="Day_DragOver">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding DateLabel}"
                                           FontWeight="SemiBold" />
                                <ListBox Grid.Row="1"
                                         Margin="0,7,0,0"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemsSource="{Binding Events}"
                                         PreviewMouseMove="Events_PreviewMouseMove"
                                         MouseDoubleClick="Events_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2"
                                                    Padding="5"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding KindLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource AccentBrush}" />
                                                    <TextBlock Text="{Binding ScopeLabel}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Padding="12,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</Window>
