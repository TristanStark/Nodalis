<Window x:Class="Nodalis.App.Dialogs.AiProposalResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Propositions de revue IA"
        Width="900"
        Height="720"
        MinWidth="700"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="PROPOSITIONS — À VÉRIFIER"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock Margin="0,6,0,0"
                       Text="Revue critique du moteur local"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ContextText"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Ce résultat est une proposition d'analyse, pas une vérité ni une modification de la documentation. Nodalis n'écrit rien dans le workspace depuis cette fenêtre." />
        </StackPanel>

        <TextBox x:Name="ResultTextBox"
                 Grid.Row="1"
                 Margin="0,16,0,0"
                 Padding="10"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="130"
                    Margin="0,0,8,0"
                    Click="Copy_Click"
                    Content="Copier" />
            <Button Width="100"
                    IsDefault="True"
                    IsCancel="True"
                    Content="Fermer" />
        </StackPanel>
    </Grid>
</Window>
