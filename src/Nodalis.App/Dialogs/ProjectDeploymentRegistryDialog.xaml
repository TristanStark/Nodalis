<Window x:Class="Nodalis.App.Dialogs.ProjectDeploymentRegistryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opérations MEP · Pilotage 2.0"
        Width="1030" Height="740" MinWidth="650" MinHeight="475"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Mises en production · opérations et tentatives"
                       FontSize="20" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Une seule fiche Markdown par opération. Les tentatives, constats et rollbacks restent historisés ; lire ou créer une fiche n'exécute aucune MEP et ne donne aucun GO." />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="OPÉRATIONS MEP CANONIQUES"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,7" />
                    <ListBox x:Name="OperationsList" Grid.Row="1"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="OperationsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="HISTORIQUE · JOURNAL EN LECTURE SEULE"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,7" />
                    <TextBox Grid.Row="1" x:Name="DetailsBox" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas" FontSize="12" Padding="10"
                             Text="Sélectionnez une opération MEP." />
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="DiagnosticsText"
                   Margin="0,10,0,0" MaxHeight="58"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Margin="0,0,0,7"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="Lecture seule avant toute création explicite." />
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="CreateButton" Content="Créer une MEP…"
                        Click="Create_Click" Padding="12,7" Margin="0,0,6,5" />
                <Button x:Name="AttemptButton" Content="Nouvelle tentative…"
                        Click="Attempt_Click" Padding="12,7" Margin="0,0,6,5" />
                <Button x:Name="EventButton" Content="Consigner un événement…"
                        Click="Event_Click" Padding="12,7" Margin="0,0,6,5" />
                <Button x:Name="OpenButton" Content="Ouvrir la fiche Markdown"
                        Click="Open_Click" Padding="12,7" Margin="0,0,6,5" />
                <Button x:Name="RefreshButton" Content="Actualiser"
                        Click="Refresh_Click" Padding="12,7" Margin="0,0,6,5" />
                <Button Content="Fermer" Padding="12,7"
                        IsCancel="True" Click="Close_Click"
                        Margin="0,0,0,5" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
