<Window x:Class="Nodalis.App.Dialogs.WorkspaceViewsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vues dynamiques — aperçu 1.5"
        Width="1120" Height="760" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Loaded="Window_Loaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Vues dynamiques du workspace"
                       FontWeight="SemiBold" FontSize="17" />
            <TextBlock Text="Regrouper les éléments existants sans les dupliquer. Les modifications s'effectuent toujours dans le document source."
                       TextWrapping="Wrap" Margin="0,5,0,10"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <Border Grid.Row="1" Padding="12" Margin="0,0,0,10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Vues sauvegardées" FontWeight="SemiBold" />
                <WrapPanel Margin="0,7,0,0">
                    <ComboBox x:Name="SavedViewsComboBox" Width="250" Height="30"
                              Margin="0,0,12,6" SelectionChanged="SavedView_Changed"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Choisir une vue enregistrée" />
                    <TextBox x:Name="ViewNameTextBox" Width="230" Height="30"
                             Padding="7,4" Margin="0,0,12,6"
                             AutomationProperties.Name="Nom de la vue" />
                    <ComboBox x:Name="VisibilityComboBox" Width="145" Height="30"
                              SelectionChanged="Filters_Changed" Margin="0,0,12,6"
                              AutomationProperties.Name="Stockage de la vue" />
                    <CheckBox x:Name="PinViewCheckBox" Content="Épingler" VerticalAlignment="Center"
                              Margin="0,0,12,6" ToolTip="Afficher cette vue sur l'accueil et dans Mes vues"
                              AutomationProperties.Name="Épingler la vue enregistrée" />
                    <Button Content="Enregistrer" MinWidth="90" Padding="8,4"
                            Click="SaveView_Click" Margin="0,0,7,6" />
                    <Button Content="Dupliquer" MinWidth="78" Padding="8,4"
                            Click="DuplicateView_Click" Margin="0,0,7,6" />
                    <Button Content="Supprimer" MinWidth="78" Padding="8,4"
                            Click="DeleteView_Click" Margin="0,0,0,6" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Padding="12" Margin="0,0,0,10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="5">
            <WrapPanel>
                <StackPanel Margin="0,0,14,4">
                    <TextBlock Text="Rechercher" Margin="0,0,0,4" />
                    <TextBox x:Name="SearchTextBox" Width="225" Height="30"
                             Padding="7,4" TextChanged="Filters_TextChanged"
                             AutomationProperties.Name="Filtrer les titres" />
                </StackPanel>
                <StackPanel Margin="0,0,14,4">
                    <TextBlock Text="Type d'élément" Margin="0,0,0,4" />
                    <ComboBox x:Name="KindComboBox" Width="160" Height="30"
                              SelectionChanged="Filters_Changed" />
                </StackPanel>
                <StackPanel Margin="0,0,14,4">
                    <TextBlock Text="Statut contient" Margin="0,0,0,4" />
                    <TextBox x:Name="StatusTextBox" Width="148" Height="30"
                             Padding="7,4" TextChanged="Filters_TextChanged" />
                </StackPanel>
                <StackPanel Margin="0,0,14,4">
                    <TextBlock Text="Regroupement" Margin="0,0,0,4" />
                    <ComboBox x:Name="GroupComboBox" Width="150" Height="30"
                              SelectionChanged="Filters_Changed" />
                </StackPanel>
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Trier par" Margin="0,0,0,4" />
                    <ComboBox x:Name="SortComboBox" Width="125" Height="30"
                              SelectionChanged="Filters_Changed" />
                </StackPanel>
            </WrapPanel>
        </Border>
        <TabControl x:Name="LayoutTabs" Grid.Row="3" Margin="0,0,0,8"
                    SelectionChanged="Layout_Changed"
                    AutomationProperties.Name="Affichage des résultats">
            <TabItem Header="Liste">
                <ListBox x:Name="ListResults" Margin="4"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="Result_SelectionChanged"
                         MouseDoubleClick="Result_DoubleClick"
                         AutomationProperties.Name="Résultats en liste">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem Header="Tableau">
                <DataGrid x:Name="TableResults" Margin="4" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          SelectionChanged="Result_SelectionChanged"
                          MouseDoubleClick="Result_DoubleClick"
                          Background="{StaticResource PanelBackgroundBrush}"
                          AutomationProperties.Name="Résultats en tableau">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Titre" Binding="{Binding Title}" Width="2*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DateLabel}" Width="*" />
                        <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="*" />
                        <DataGridTextColumn Header="Groupe" Binding="{Binding Group}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Cartes">
                <ListBox x:Name="CardResults" Margin="4"
                         SelectionChanged="Result_SelectionChanged"
                         MouseDoubleClick="Result_DoubleClick"
                         AutomationProperties.Name="Résultats en cartes">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="245" Margin="5" Padding="10"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderThickness="1" CornerRadius="5">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" Margin="0,6,0,0"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="4" Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PreviousPageButton" Content="← Précédent" IsEnabled="False"
                        Padding="8,5" Margin="8,0,4,0" Click="PreviousPage_Click" />
                <Button x:Name="NextPageButton" Content="Suivant →" IsEnabled="False"
                        Padding="8,5" Margin="4,0,8,0" Click="NextPage_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="WarningText" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="OpenSourceButton" Content="Ouvrir la source" IsEnabled="False"
                        Padding="12,6" Margin="8,0,8,0"
                        Click="OpenSource_Click" />
                <Button Content="Fermer" Padding="12,6" MinWidth="80" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>