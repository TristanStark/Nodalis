<Window x:Class="Nodalis.App.Dialogs.ProjectDeploymentPostCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contrôles post-déploiement · REC et incidents"
        Width="780" Height="710" MinWidth="530" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Associer un passage de tests à la MEP"
                       FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="AttemptText" Margin="0,5,0,0"
                       TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Choisissez un passage REC exact, puis les incidents concernés. Le verdict est une appréciation humaine ; aucun résultat de test ni statut d'incident ne sera modifié." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" IsCancel="True" Padding="12,7"
                    Margin="0,0,8,0" />
            <Button Content="Revoir et consigner…"
                    Click="Accept_Click" IsDefault="True" Padding="12,7" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Campagne et passage REC du même environnement/version"
                           Margin="0,4,0,5" />
                <ComboBox x:Name="CampaignCombo" Padding="8,6"
                          DisplayMemberPath="Label"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          SelectionChanged="CampaignCombo_SelectionChanged" />
                <TextBlock x:Name="PassageSummaryText" Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Text="Verdict de contrôle post-déploiement"
                           Margin="0,15,0,5" />
                <ComboBox x:Name="VerdictCombo" Padding="8,6"
                          DisplayMemberPath="Label" />
                <TextBlock Text="Auteur de la revue" Margin="0,12,0,5" />
                <TextBox x:Name="ActorBox" Padding="8,6" />
                <TextBlock Text="Justification et points contrôlés"
                           Margin="0,12,0,5" />
                <TextBox x:Name="RationaleBox" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="70" Padding="8,6" />
                <TextBlock Text="Réserves et suivi (si applicable)"
                           Margin="0,12,0,5" />
                <TextBox x:Name="ReservationsBox" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="54" Padding="8,6" />
                <TextBlock Text="Incidents de maintenance à relier (facultatif)"
                           FontWeight="SemiBold" Margin="0,16,0,7" />
                <Border BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4"
                        Background="{StaticResource PanelBackgroundBrush}"
                        Padding="8">
                    <ListBox x:Name="IncidentList" Height="125"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Padding="5" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Les nombres de tests sont figés avec la révision du passage. Les résultats non exécutés ou non conformes provoquent un avertissement, pas une décision automatique. Après mise à jour de REC, une nouvelle revue est nécessaire." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
