<Window x:Class="Nodalis.App.Dialogs.MilestoneEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jalon"
        Width="660"
        Height="720"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="130" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Nom"
                   FontWeight="SemiBold" />
        <TextBox x:Name="NameTextBox"
                 Grid.Row="1"
                 Margin="0,6,0,12"
                 MinHeight="30"
                 Padding="6,4" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Date cible"
                           FontWeight="SemiBold" />
                <DatePicker x:Name="TargetDatePicker"
                            Margin="0,6,0,0"
                            SelectedDateFormat="Short"
                            IsTodayHighlighted="True"
                            ToolTip="Sélectionnez une date, saisissez-la au clavier ou effacez-la." />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Statut"
                           FontWeight="SemiBold" />
                <TextBox x:Name="StatusTextBox"
                         Margin="0,6,0,0"
                         MinHeight="30"
                         Padding="6,4" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,14,0,0"
                   Text="Description"
                   FontWeight="SemiBold" />

        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="4"
                 Margin="0,6,0,12"
                 Padding="6"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="5">
            <TextBlock Text="Lien de référence (facultatif)"
                       FontWeight="SemiBold" />
            <TextBox x:Name="LinkTextBox"
                     Margin="0,6,0,12"
                     MinHeight="30"
                     Padding="6,4" />
        </StackPanel>

        <TextBlock Grid.Row="6"
                   Text="Prérequis"
                   FontWeight="SemiBold" />

        <ListBox x:Name="DependenciesListBox"
                 Grid.Row="7"
                 Margin="0,6,0,0"
                 Padding="4"
                 SelectionMode="Multiple"
                 BorderBrush="{StaticResource BorderBrush}"
                 Background="{StaticResource PanelBackgroundBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TargetDate, StringFormat={}{0:dd/MM/yyyy}}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="8"
                   Margin="0,6,0,0"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Ctrl+clic permet de sélectionner plusieurs prérequis. Un jalon ne peut pas dépendre de lui-même et les cycles sont refusés." />

        <StackPanel Grid.Row="9"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="90"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Annuler" />
            <Button Width="100"
                    IsDefault="True"
                    Click="Save_Click"
                    Content="Enregistrer" />
        </StackPanel>
    </Grid>
</Window>
