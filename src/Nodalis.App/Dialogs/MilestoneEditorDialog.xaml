<Window x:Class="Nodalis.App.Dialogs.MilestoneEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jalon"
        Width="620"
        Height="520"
        MinWidth="540"
        MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Nom"
                   FontWeight="SemiBold" />
        <TextBox x:Name="NameTextBox"
                 Grid.Row="1"
                 Margin="0,6,0,12"
                 MinHeight="30"
                 Padding="6,4" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Date cible"
                           FontWeight="SemiBold" />
                <DatePicker x:Name="TargetDatePicker"
                            Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Statut"
                           FontWeight="SemiBold" />
                <TextBox x:Name="StatusTextBox"
                         Margin="0,6,0,0"
                         MinHeight="30"
                         Padding="6,4" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3"
                   Margin="0,14,0,0"
                   Text="Description"
                   FontWeight="SemiBold" />

        <TextBox x:Name="DescriptionTextBox"
                 Grid.Row="4"
                 Margin="0,6,0,12"
                 Padding="6"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="5">
            <TextBlock Text="Lien de référence (facultatif)"
                       FontWeight="SemiBold" />
            <TextBox x:Name="LinkTextBox"
                     Margin="0,6,0,0"
                     MinHeight="30"
                     Padding="6,4" />
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="90"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Annuler" />
            <Button Width="100"
                    IsDefault="True"
                    Click="Save_Click"
                    Content="Enregistrer" />
        </StackPanel>
    </Grid>
</Window>
