<Window x:Class="Nodalis.App.Dialogs.AiTestReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prévisualisation des tests générés"
        Width="940"
        Height="760"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="APERÇU ÉDITABLE — AUCUNE INSERTION EFFECTUÉE"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock Margin="0,6,0,0"
                       Text="Scénarios de tests proposés"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="OptionsText"
                       Margin="0,6,0,0"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SourcesText"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Modifiez librement le Markdown. Le bouton d'insertion créera un nouveau document dans Tests ; Annuler ne modifie rien." />
        </StackPanel>

        <TextBox x:Name="MarkdownTextBox"
                 Grid.Row="1"
                 Margin="0,16,0,0"
                 Padding="10"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="110"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Annuler" />
            <Button Width="180"
                    IsDefault="True"
                    Click="Insert_Click"
                    Content="Insérer dans Tests" />
        </StackPanel>
    </Grid>
</Window>
