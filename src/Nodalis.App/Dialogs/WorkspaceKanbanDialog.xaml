<Window x:Class="Nodalis.App.Dialogs.WorkspaceKanbanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kanban léger"
        Width="1240"
        Height="760"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="TaskCardTemplate">
            <Border Margin="0,2,0,5"
                    Padding="8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Text}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding ProjectName}"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <StackPanel Margin="0,3,0,0"
                                Orientation="Horizontal">
                        <TextBlock Text="{Binding Owner}"
                                   FontSize="10"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Margin="8,0,0,0"
                                   Text="{Binding Priority}"
                                   FontSize="10"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding DueDate, StringFormat='Échéance : {0:dd/MM/yyyy}'}"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Padding="16,12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Kanban léger"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="Vue directe des tâches Markdown. Déplacer une carte met à jour son statut source ; aucune copie de tâche n'est créée."
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="14,10"
                    Orientation="Horizontal">
            <ComboBox x:Name="ProjectFilter"
                      Width="220"
                      Margin="0,0,8,0"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="OwnerFilter"
                      Width="180"
                      Margin="0,0,8,0"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox x:Name="PriorityFilter"
                      Width="160"
                      Margin="0,0,8,0"
                      SelectionChanged="Filter_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Click="Refresh_Click"
                    Content="Actualiser" />
        </StackPanel>

        <Grid Grid.Row="2"
              Margin="14,0,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="2,0,2,8"
                               Text="À FAIRE"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <ListBox x:Name="TodoList"
                             Tag="À faire"
                             AllowDrop="True"
                             PreviewMouseMove="TaskList_PreviewMouseMove"
                             MouseDoubleClick="TaskList_MouseDoubleClick"
                             DragOver="Column_DragOver"
                             Drop="Column_Drop"
                             ItemTemplate="{StaticResource TaskCardTemplate}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="2,0,2,8"
                               Text="EN COURS"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <ListBox x:Name="InProgressList"
                             Tag="En cours"
                             AllowDrop="True"
                             PreviewMouseMove="TaskList_PreviewMouseMove"
                             MouseDoubleClick="TaskList_MouseDoubleClick"
                             DragOver="Column_DragOver"
                             Drop="Column_Drop"
                             ItemTemplate="{StaticResource TaskCardTemplate}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="4"
                    Padding="8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="2,0,2,8"
                               Text="BLOQUÉ"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <ListBox x:Name="BlockedList"
                             Tag="Bloqué"
                             AllowDrop="True"
                             PreviewMouseMove="TaskList_PreviewMouseMove"
                             MouseDoubleClick="TaskList_MouseDoubleClick"
                             DragOver="Column_DragOver"
                             Drop="Column_Drop"
                             ItemTemplate="{StaticResource TaskCardTemplate}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="6"
                    Padding="8"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    Background="{StaticResource PanelBackgroundBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="2,0,2,8"
                               Text="TERMINÉ"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <ListBox x:Name="DoneList"
                             Tag="Terminé"
                             AllowDrop="True"
                             PreviewMouseMove="TaskList_PreviewMouseMove"
                             MouseDoubleClick="TaskList_MouseDoubleClick"
                             DragOver="Column_DragOver"
                             Drop="Column_Drop"
                             ItemTemplate="{StaticResource TaskCardTemplate}" />
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Padding="12,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
    </Grid>


</Window>
