<Window x:Class="Nodalis.App.Dialogs.ProjectGateReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dossier de décision humaine · Gate"
        Width="850" Height="780" MinWidth="600" MinHeight="510"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="GateNameText" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="Nouvelle décision historisée. Les verdicts précédents restent intacts. Aucun jalon n'est terminé, aucune réserve n'est levée automatiquement." />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Auteur de la décision" FontWeight="SemiBold" />
                <TextBox x:Name="ActorBox" Margin="0,3,0,7" MinHeight="28" />
                <TextBlock Text="Périmètre autorisé / étudié" FontWeight="SemiBold" />
                <TextBox x:Name="ScopeBox" Margin="0,3,0,7" MinHeight="28"
                         TextWrapping="Wrap" />
                <TextBlock Text="Verdict humain" FontWeight="SemiBold" />
                <ComboBox x:Name="VerdictCombo"
                          Margin="0,3,0,7" MinHeight="28"
                          DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Version du périmètre (facultatif)"
                           FontWeight="SemiBold" />
                <TextBox x:Name="VersionBox" Margin="0,3,0,7" MinHeight="28" />
                <TextBlock Text="Environnement (facultatif)" FontWeight="SemiBold" />
                <TextBox x:Name="EnvironmentBox" Margin="0,3,0,7" MinHeight="28" />
                <TextBlock Text="Justification de décision" FontWeight="SemiBold" />
                <TextBox x:Name="RationaleBox" Height="58" Margin="0,3,0,7"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="CRITÈRES · qualification explicite"
                       FontWeight="SemiBold" FontSize="12"
                       Margin="0,0,0,7" />
            <ListBox Grid.Row="1" x:Name="CriteriaList"
                     MinHeight="90" MaxHeight="225">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="6,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}"
                                       TextWrapping="Wrap" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" Margin="7,0"
                                      MinHeight="28"
                                      ItemsSource="{Binding Options}"
                                      SelectedItem="{Binding Status, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" MinHeight="28"
                                     ToolTip="Motif de qualification du critère (facultatif)"
                                     Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2"
                       Text="PREUVES LOCALES · sélectionner explicitement les fichiers à figer (SHA-256)"
                       FontWeight="SemiBold" FontSize="12"
                       Margin="0,9,0,7" TextWrapping="Wrap" />
            <ListBox Grid.Row="3" x:Name="EvidenceList"
                     MinHeight="75" MaxHeight="130">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="7,4"
                                  IsChecked="{Binding Selected, Mode=TwoWay}">
                            <TextBlock Text="{Binding RelativePath}"
                                       TextWrapping="Wrap" />
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,10,0,5">
            <TextBlock Text="Réserve identifiée (requise uniquement pour GO sous réserves)"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBox x:Name="ReservationBox" Margin="0,4,0,0" MinHeight="28"
                     TextWrapping="Wrap" />
            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="Les sources sont des références locales ; leur empreinte fige les octets examinés, sans copier ni envoyer les documents. Le GO et le GO sous réserves exigent une preuve sélectionnée." />
        </StackPanel>
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Proposer cette décision"
                        Padding="15,8" Margin="0,0,8,0"
                        Click="Accept_Click" />
                <Button Content="Annuler" Padding="15,8" Click="Cancel_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Aucun verdict n'est pré-approuvé." />
        </DockPanel>
    </Grid>
</Window>
