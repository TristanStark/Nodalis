<Window x:Class="Nodalis.App.Dialogs.ProjectIncidentRetestSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reprise d'incident · Nodalis 2.0"
        Width="700" Height="540" MinWidth="520" MinHeight="370"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Choisir un incident de maintenance"
                   FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="SummaryText" Grid.Row="1"
                   Margin="0,8,0,12" TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}"/>
        <ListBox x:Name="IncidentsList" Grid.Row="2"
                 SelectionChanged="Incidents_SelectionChanged"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 AutomationProperties.Name="Incidents canoniques du projet">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="7,6">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Location}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annuler" IsCancel="True"
                        Margin="0,0,8,0" Padding="13,8"/>
                <Button x:Name="ConfirmButton"
                        Content="Proposer les tests liés…"
                        Padding="13,8" Click="Confirm_Click"/>
            </StackPanel>
            <TextBlock Text="Sélection et proposition sans écriture métier."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
