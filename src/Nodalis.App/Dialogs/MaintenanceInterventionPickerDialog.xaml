<Window x:Class="Nodalis.App.Dialogs.MaintenanceInterventionPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier une intervention"
        Width="570" Height="420" MinWidth="430" MinHeight="320"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Choisissez l'intervention à modifier"
                   FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,12"/>
        <ListBox x:Name="InterventionsList"
                 Grid.Row="1" Padding="5"
                 Background="{StaticResource PanelBackgroundBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 MouseDoubleClick="Select_DoubleClick"
                 AutomationProperties.Name="Interventions de la fiche de maintenance">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="6">
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}"
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Annuler" IsCancel="True" MinWidth="90" Margin="0,0,8,0"/>
            <Button Content="Modifier" IsDefault="True" MinWidth="100" Click="Select_Click"/>
        </StackPanel>
    </Grid>
</Window>