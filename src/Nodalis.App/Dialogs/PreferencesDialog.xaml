<Window x:Class="Nodalis.App.Dialogs.PreferencesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préférences"
        Width="620"
        Height="750"
        MinWidth="540"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Éditeur"
                   FontSize="18"
                   FontWeight="SemiBold" />

        <Grid Grid.Row="1"
              Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="Taille de police" />
            <TextBox x:Name="FontSizeTextBox"
                     Grid.Column="1"
                     MinHeight="30"
                     Padding="6,4" />
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Délai d'autosave" />
                <TextBlock Margin="0,2,0,0"
                           FontSize="10"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="En millisecondes, entre 100 et 10000" />
            </StackPanel>
            <TextBox x:Name="AutosaveDelayTextBox"
                     Grid.Column="1"
                     MinHeight="30"
                     Padding="6,4" />
        </Grid>

        <CheckBox x:Name="WordWrapCheckBox"
                  Grid.Row="3"
                  Margin="0,18,0,0"
                  Content="Retour à la ligne automatique" />

        <CheckBox x:Name="LivePreviewCheckBox"
                  Grid.Row="4"
                  Margin="0,10,0,0"
                  Content="Aperçu Markdown en direct" />

        <StackPanel Grid.Row="5"
                    Margin="0,20,0,0">
            <TextBlock Text="Interface"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <CheckBox x:Name="ContextPanelCheckBox"
                      Margin="0,14,0,0"
                      Content="Afficher le panneau de contexte" />
            <TextBlock Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Les préférences sont locales à ce PC et ne modifient jamais le contenu métier du workspace." />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Raccourci global Inbox"
                           VerticalAlignment="Center" />
                <TextBox x:Name="InboxHotkeyTextBox"
                         Grid.Column="1"
                         MinHeight="30"
                         Padding="6,4"
                         AutomationProperties.Name="Raccourci global Inbox" />
            </Grid>
            <TextBlock Margin="0,4,0,0"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Par défaut Ctrl+Shift+I, actif seulement quand Nodalis tourne. Ctrl+Alt+N reste réservé aux notes rapides." />
        </StackPanel>

        <ScrollViewer Grid.Row="6"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Assistant IA local"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <CheckBox x:Name="AiEnabledCheckBox"
                      Margin="0,14,0,0"
                      Content="Activer explicitement l'assistant IA local" />
            <TextBlock Margin="0,6,0,10"
                       FontSize="10"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Text="Processus local stdin/stdout uniquement. Le payload exact est affiché avant chaque exécution." />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Exécutable local" />
                <TextBox x:Name="AiExecutableTextBox" Grid.Column="1" MinHeight="30" Padding="6,4" />
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Arguments" />
                <TextBox x:Name="AiArgumentsTextBox" Grid.Column="1" MinHeight="30" Padding="6,4" />
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Modèle" />
                <TextBox x:Name="AiModelTextBox" Grid.Column="1" MinHeight="30" Padding="6,4" />
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Timeout (secondes)" />
                <TextBox x:Name="AiTimeoutTextBox" Grid.Column="1" MinHeight="30" Padding="6,4" />
            </Grid>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="7"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="90"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Annuler" />
            <Button Width="100"
                    IsDefault="True"
                    Click="Save_Click"
                    Content="Enregistrer" />
        </StackPanel>
    </Grid>
</Window>
