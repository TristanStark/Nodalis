<Window x:Class="Nodalis.App.Dialogs.AiContextSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélection du contexte IA"
        Width="980"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="CONTEXTE LOCAL EXPLICITE"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock Margin="0,6,0,0"
                       Text="Choisir les documents à transmettre"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Cochez uniquement les sources utiles. Sélectionnez une ligne pour voir son contenu exact. Une seconde validation affichera ensuite le payload complet avant l'exécution locale." />
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="SourcesListBox"
                     SelectionChanged="SourcesListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Margin="0,3,9,0"
                                      VerticalAlignment="Top"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Label, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SizeLabel, Mode=OneWay}"
                                           FontSize="10"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="2"
                    Padding="10"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewLabelText"
                               FontWeight="SemiBold"
                               Text="Aperçu" />
                    <TextBox x:Name="PreviewTextBox"
                             Grid.Row="1"
                             Margin="0,8,0,0"
                             Padding="8"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="Consolas"
                             FontSize="11"
                             TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="110"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Annuler" />
            <Button Width="180"
                    IsDefault="True"
                    Click="Continue_Click"
                    Content="Continuer avec la sélection" />
        </StackPanel>
    </Grid>
</Window>
