<Window x:Class="Nodalis.App.Dialogs.MeetingAiReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revue du résumé IA"
        Width="900"
        Height="760"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="REVUE AVANT INSERTION"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock Margin="0,6,0,0"
                       Text="Résumé et propositions de la réunion"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="SourceText"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Chaque proposition est modifiable et peut être rejetée. Le compte-rendu source n'est jamais modifié : les éléments acceptés sont créés dans une note sœur avec leur provenance." />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,16,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="AcceptSummaryCheckBox"
                          IsChecked="True"
                          Content="Conserver le résumé" />
                <TextBox x:Name="SummaryTextBox"
                         Margin="0,8,0,18"
                         MinHeight="120"
                         Padding="10"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Text="Propositions"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,8"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Décochez les éléments à rejeter et éditez librement le texte des autres." />

                <ItemsControl x:Name="ProposalsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="10"
                                    CornerRadius="5"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Margin="0,4,10,0"
                                              VerticalAlignment="Top"
                                              IsChecked="{Binding IsAccepted, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="0,3,10,0"
                                               FontWeight="SemiBold"
                                               Text="{Binding Category, Mode=OneWay}" />
                                    <TextBox Grid.Column="2"
                                             MinHeight="34"
                                             Padding="7,4"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="110"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="Annuler" />
            <Button Width="210"
                    IsDefault="True"
                    Click="Accept_Click"
                    Content="Créer la synthèse acceptée" />
        </StackPanel>
    </Grid>
</Window>
