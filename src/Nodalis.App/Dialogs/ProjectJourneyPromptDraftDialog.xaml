<Window x:Class="Nodalis.App.Dialogs.ProjectJourneyPromptDraftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préparer un prompt · Parcours projet"
        Width="850" Height="680"
        MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Brouillon de prompt (sans exécution)"
                       FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <TabControl Grid.Row="1" AutomationProperties.Name="Messages IA distincts"
                    ToolTip="Les variables entre chevrons du brouillon utilisateur sont à renseigner explicitement avant copie.">
            <TabItem Header="Prompt utilisateur + sources">
                <TextBox x:Name="DraftText"
                         FontFamily="Consolas" FontSize="13"
                         Padding="14" IsReadOnly="False"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Brouillon utilisateur modifiable avant copie" />
            </TabItem>
            <TabItem x:Name="SystemTab"
                     Header="Système FRT-100 (configuration séparée)">
                <TextBox x:Name="SystemText"
                         FontFamily="Consolas" FontSize="13"
                         Padding="14" IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Référentiel FRT-100 système" />
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Padding="14,8" Margin="0,0,8,0"
                        Content="Copier le prompt utilisateur"
                        Click="Copy_Click" />
                <Button x:Name="CopySystemButton"
                        Padding="14,8" Margin="0,0,8,0"
                        Content="Copier le système FRT-100"
                        Click="CopySystem_Click" />
                <Button Padding="14,8" Content="Fermer"
                        Click="Close_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Aucune requête IA, aucune sauvegarde : copie manuelle uniquement." />
        </DockPanel>
    </Grid>
</Window>
