<Window x:Class="Nodalis.App.Dialogs.ProjectJourneyPromptDraftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préparer un prompt · Parcours projet"
        Width="850" Height="680"
        MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Brouillon de prompt (sans exécution)"
                       FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <TabControl Grid.Row="1" AutomationProperties.Name="Messages IA distincts"
                    ToolTip="Les variables entre chevrons du brouillon utilisateur sont à renseigner explicitement avant copie.">
            <TabItem Header="Prompt utilisateur + sources">
                <TextBox x:Name="DraftText"
                         FontFamily="Consolas" FontSize="13"
                         Padding="14" IsReadOnly="False"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Brouillon utilisateur modifiable avant copie" />
            </TabItem>
            <TabItem x:Name="SystemTab"
                     Header="Système FRT-100 (configuration séparée)">
                <TextBox x:Name="SystemText"
                         FontFamily="Consolas" FontSize="13"
                         Padding="14" IsReadOnly="True"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Référentiel FRT-100 système" />
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" HorizontalAlignment="Right">
                <Button Padding="12,7" Margin="0,0,8,6"
                        Content="Copier l'utilisateur"
                        Click="Copy_Click" />
                <Button x:Name="CopySystemButton"
                        Padding="12,7" Margin="0,0,8,6"
                        Content="Copier le système"
                        Click="CopySystem_Click" />
                <Button Padding="12,7" Margin="0,0,8,6"
                        Content="Exporter l'utilisateur…"
                        Click="ExportUser_Click"
                        ToolTip="Exporter uniquement sur demande le brouillon utilisateur" />
                <Button x:Name="ExportSystemButton" Padding="12,7"
                        Margin="0,0,8,6"
                        Content="Exporter le système…"
                        Click="ExportSystem_Click"
                        ToolTip="Exporter séparément le référentiel système" />
                <Button Padding="12,7" Margin="0,0,0,6"
                        Content="Fermer" Click="Close_Click" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Grid.Row="1"
                       TextWrapping="Wrap" Margin="0,3,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Aucune requête IA : copie ou export sur demande uniquement." />
        </Grid>
    </Grid>
</Window>
