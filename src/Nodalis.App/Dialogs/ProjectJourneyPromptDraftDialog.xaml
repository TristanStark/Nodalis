<Window x:Class="Nodalis.App.Dialogs.ProjectJourneyPromptDraftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Préparer un prompt · Parcours projet"
        Width="850" Height="680"
        MinWidth="580" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Brouillon de prompt (sans exécution)"
                       FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <TextBox x:Name="DraftText"
                 Grid.Row="1"
                 FontFamily="Consolas" FontSize="13"
                 Padding="14"
                 BorderBrush="{StaticResource BorderBrush}"
                 BorderThickness="1"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Brouillon de prompt à relire" />
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Padding="14,8" Margin="0,0,8,0"
                        Content="Copier le brouillon"
                        Click="Copy_Click" />
                <Button Padding="14,8" Content="Fermer"
                        Click="Close_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Aucune requête IA, aucune sauvegarde : copie manuelle uniquement." />
        </DockPanel>
    </Grid>
</Window>
