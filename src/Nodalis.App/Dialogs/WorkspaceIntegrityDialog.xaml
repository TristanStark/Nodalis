<Window x:Class="Nodalis.App.Dialogs.WorkspaceIntegrityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostic d'intégrité du workspace"
        Width="960"
        Height="680"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Padding="16,12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Diagnostic d'intégrité du workspace"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="Lecture seule par défaut. Aucune donnée métier n'est supprimée ou réparée automatiquement."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="SummaryText"
                           Margin="0,8,0,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="14,10"
                    Orientation="Horizontal">
            <Button x:Name="RefreshButton"
                    Margin="0,0,8,0"
                    Click="Refresh_Click"
                    Content="Relancer le diagnostic" />
            <Button x:Name="RebuildIndexButton"
                    Click="RebuildIndex_Click"
                    Content="Reconstruire l'index de liens" />
        </StackPanel>

        <ListBox x:Name="ResultsList"
                 Grid.Row="2"
                 Margin="14,0,14,10"
                 BorderThickness="1"
                 BorderBrush="{StaticResource BorderBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding SeverityLabel}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Code}"
                                       FontSize="10"
                                       FontFamily="Consolas"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Message}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding LocationLabel}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3"
                Padding="12,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</Window>
