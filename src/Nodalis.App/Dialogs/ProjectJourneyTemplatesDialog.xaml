<Window x:Class="Nodalis.App.Dialogs.ProjectJourneyTemplatesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modèles de Parcours · Nodalis 2.0"
        Width="1100" Height="760"
        MinWidth="840" MinHeight="570"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Closing="Dialog_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="18,14" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Personnaliser les modèles de Parcours"
                           FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Ces modèles serviront uniquement aux nouveaux Parcours. Les projets déjà initialisés ne sont jamais modifiés. Les changements restent locaux jusqu'à Enregistrer." />
                <TextBlock x:Name="SummaryText"
                           Margin="0,8,0,0" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="14,12,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="10" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="MODÈLES" FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox x:Name="ComplexityCombo"
                              Grid.Row="1" Margin="0,9,0,8"
                              MinHeight="30" DisplayMemberPath="Label"
                              AutomationProperties.Name="Complexité du nouveau modèle" />
                    <ListBox x:Name="TemplatesList"
                             Grid.Row="2" SelectionChanged="TemplatesList_SelectionChanged"
                             Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="3">
                        <Button x:Name="AddTemplateButton" Content="Ajouter"
                                Click="AddTemplate_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="RenameTemplateButton" Content="Renommer"
                                Click="RenameTemplate_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="RemoveTemplateButton" Content="Retirer"
                                Click="RemoveTemplate_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="10" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ÉTAPES DU MODÈLE"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <ListBox x:Name="StepsList" Grid.Row="1"
                             Margin="0,9,0,8"
                             SelectionChanged="StepsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,6">
                                    <TextBlock Text="{Binding Name}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Key}"
                                               FontSize="10" TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2">
                        <Button x:Name="AddStepButton" Content="Ajouter"
                                Click="AddStep_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="RenameStepButton" Content="Renommer"
                                Click="RenameStep_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="UpStepButton" Content="↑"
                                Click="UpStep_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="DownStepButton" Content="↓"
                                Click="DownStep_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="RemoveStepButton" Content="Retirer"
                                Click="RemoveStep_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Column="4" Padding="10" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="OPÉRATIONS PROPOSÉES"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <ListBox x:Name="OperationsList" Grid.Row="1" Margin="0,9,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PromptLabel}"
                                               TextWrapping="Wrap" FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2">
                        <Button x:Name="AddOperationButton" Content="Ajouter"
                                Click="AddOperation_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="RenameOperationButton" Content="Renommer"
                                Click="RenameOperation_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="PromptOperationButton" Content="Prompt"
                                Click="PromptOperation_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="UpOperationButton" Content="↑"
                                Click="UpOperation_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="DownOperationButton" Content="↓"
                                Click="DownOperation_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                        <Button x:Name="RemoveOperationButton" Content="Retirer"
                                Click="RemoveOperation_Click" Padding="9,5"
                                Margin="0,0,6,6" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2"
                Padding="14,10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ReloadButton" Content="Recharger"
                        Click="Reload_Click" Margin="0,0,9,0"
                        Padding="14,7" />
                <Button x:Name="SaveButton" Content="Enregistrer les modèles"
                        Click="Save_Click" Padding="14,7"
                        Margin="0,0,9,0" />
                <Button Content="Fermer" Click="Close_Click"
                        Padding="14,7" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
