<Window x:Class="Nodalis.App.Dialogs.InboxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inbox — Trier les captures"
        Width="1100"
        Height="700"
        MinWidth="750"
        MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="+ Nouvelle capture"
                        Click="CaptureNew_Click"
                        Margin="12,0,0,0"
                        Padding="12,7" />
                <StackPanel>
                    <TextBlock Text="Boîte de réception"
                               FontSize="23"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="Retrouvez, filtrez et classez vos captures sans changer de workspace."
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="185" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox"
                     MinHeight="32"
                     Padding="9,6"
                     TextChanged="SearchTextBox_TextChanged"
                     AutomationProperties.Name="Rechercher dans les captures"
                     ToolTip="Rechercher dans le texte, l'origine, la cible ou le type" />
            <ComboBox x:Name="StateFilterComboBox"
                      Grid.Column="1"
                      Margin="12,0,0,0"
                      MinHeight="32"
                      SelectionChanged="StateFilterComboBox_SelectionChanged"
                      SelectedIndex="0"
                      AutomationProperties.Name="Filtrer par état">
                <ComboBoxItem Content="Tous les états" />
                <ComboBoxItem Content="À traiter" />
                <ComboBoxItem Content="Traités" />
                <ComboBoxItem Content="Archivés" />
            </ComboBox>
            <CheckBox x:Name="TrashModeCheckBox"
                      Grid.Column="2"
                      Content="Corbeille Inbox"
                      Margin="14,0,0,0"
                      VerticalAlignment="Center"
                      Checked="TrashMode_Changed"
                      Unchecked="TrashMode_Changed"
                      ToolTip="Voir et restaurer les captures supprimées" />
        </Grid>
        <Grid Grid.Row="2" Margin="14,0,14,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="EntriesList"
                     Grid.Column="0"
                     SelectionMode="Extended"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionChanged="EntriesList_SelectionChanged"
                     MouseDoubleClick="EntriesList_MouseDoubleClick"
                     AutomationProperties.Name="Captures Inbox (sélection multiple Ctrl ou Maj)">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Afficher le contenu"
                                  Click="Open_Click" />
                        <MenuItem Header="Convertir vers note, document ou tâche"
                                  Click="Convert_Click" />
                        <MenuItem Header="Marquer comme traité"
                                  Click="Processed_Click" />
                        <MenuItem Header="Marquer à traiter"
                                  Click="Pending_Click" />
                        <MenuItem Header="Archiver"
                                  Click="Archive_Click" />
                        <Separator />
                        <MenuItem Header="Supprimer dans la corbeille"
                                  Click="Delete_Click" />
                        <MenuItem Header="Restaurer"
                                  Click="Restore_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#25445A" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                Background="Transparent">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding DateDisplay}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding KindDisplay}"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StateDisplay}"
                                               Margin="12,0,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="11" />
                                </DockPanel>
                                <TextBlock Text="{Binding Preview}"
                                           Margin="0,7,0,0"
                                           TextWrapping="Wrap"
                                           MaxHeight="70"
                                           ToolTip="{Binding Entry.ContentMarkdown}" />
                                <TextBlock Text="{Binding TargetDisplay}"
                                           Margin="0,6,0,0"
                                           FontSize="10"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1"
                          Background="{StaticResource BorderBrush}"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" />
            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Aperçu Markdown"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />
                <TextBox x:Name="PreviewTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="12"
                         AutomationProperties.Name="Contenu intégral de la capture" />
            </Grid>
        </Grid>
        <Border Grid.Row="3"
                Padding="12,10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button x:Name="ConvertButton"
                            Content="Convertir…"
                            Click="Convert_Click"
                            Padding="9,5"
                            Margin="0,0,10,0"
                            ToolTip="Convertir la capture sélectionnée en note, document ou tâche" />
                    <Button x:Name="PendingButton"
                            Content="À traiter"
                            Click="Pending_Click"
                            Margin="0,0,6,0"
                            Padding="9,5" />
                    <Button x:Name="ProcessedButton"
                            Content="Traité"
                            Click="Processed_Click"
                            Margin="0,0,6,0"
                            Padding="9,5" />
                    <Button x:Name="ArchiveButton"
                            Content="Archiver"
                            Click="Archive_Click"
                            Margin="0,0,6,0"
                            Padding="9,5" />
                    <Button x:Name="DeleteButton"
                            Content="Supprimer"
                            Click="Delete_Click"
                            Margin="0,0,6,0"
                            Padding="9,5" />
                    <Button x:Name="RestoreButton"
                            Content="Restaurer"
                            Click="Restore_Click"
                            Margin="0,0,6,0"
                            Padding="9,5" />
                    <Button Content="Fermer"
                            Padding="10,5"
                            IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Margin="4,0,8,0"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
