<Window x:Class="Nodalis.App.Dialogs.ProjectExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exporter le projet"
        Width="780"
        Height="690"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,14">
            <TextBlock x:Name="ProjectNameText"
                       FontSize="22"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="ProjectSummaryText"
                       Margin="0,5,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,0,0,14"
                Padding="12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,10,8"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Destination" />
                <TextBox x:Name="DestinationTextBox"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,8,8"
                         MinHeight="30"
                         VerticalContentAlignment="Center" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Margin="0,0,0,8"
                        MinWidth="90"
                        Click="BrowseDestination_Click"
                        Content="Parcourir…" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Nom de base" />
                <TextBox x:Name="BaseNameTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         MinHeight="30"
                         VerticalContentAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0"
                      Header="Sections exportées">
                <ListBox x:Name="SectionList"
                         Margin="8"
                         ItemsSource="{Binding Sections}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2">
                                <TextBlock DockPanel.Dock="Right"
                                           Margin="12,0,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding DocumentCount, StringFormat={}{0} document(s)}" />
                                <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Name}" />
                                </CheckBox>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <StackPanel Grid.Column="1"
                        Margin="10,28,0,0">
                <Button MinWidth="95"
                        Margin="0,0,0,8"
                        Click="MoveSectionUp_Click"
                        Content="↑ Monter" />
                <Button MinWidth="95"
                        Click="MoveSectionDown_Click"
                        Content="↓ Descendre" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Margin="0,0,0,7"
                               FontWeight="SemiBold"
                               Text="Formats" />
                    <CheckBox x:Name="MarkdownCheckBox"
                              Margin="0,0,0,5"
                              IsChecked="True"
                              Content="Dossier Markdown portable" />
                    <CheckBox x:Name="HtmlCheckBox"
                              Margin="0,0,0,5"
                              IsChecked="True"
                              Content="HTML autonome hors ligne" />
                    <CheckBox x:Name="DocxCheckBox"
                              Content="DOCX consolidé natif" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Margin="0,0,0,7"
                               FontWeight="SemiBold"
                               Text="Contenu" />
                    <CheckBox x:Name="AttachmentsCheckBox"
                              IsChecked="True"
                              Content="Inclure les pièces jointes locales" />
                    <TextBlock Margin="0,7,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Le DOCX consolide le texte ; le Markdown et l'HTML gèrent les pièces jointes."
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4"
                   Margin="0,14,0,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="L'export est écrit hors du workspace ; le projet source reste inchangé." />

            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Margin="0,0,8,0"
                        MinWidth="100"
                        IsCancel="True"
                        Content="Annuler" />
                <Button MinWidth="120"
                        Click="Export_Click"
                        Content="Exporter" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
