<Window x:Class="Nodalis.App.Dialogs.ProjectJourneyPromptPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bibliothèque des prompts · Nodalis 2.0"
        Width="980" Height="690" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Choisir un prompt pour cette opération"
                       FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="30 prompts FRT-100 originaux + revue combinée. Le référentiel FRT-100 est un prompt SYSTÈME distinct. Aucun modèle n'est appelé." />
        </StackPanel>
        <TextBox x:Name="SearchBox" Grid.Row="1"
                 Margin="0,0,0,12" MinHeight="32"
                 AutomationProperties.Name="Rechercher un prompt"
                 ToolTip="Rechercher par référence ou titre"
                 TextChanged="SearchBox_TextChanged" />
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="PromptsList" Grid.Column="0"
                     DisplayMemberPath="DisplayName"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     SelectionChanged="PromptsList_SelectionChanged"
                     AutomationProperties.Name="Catalogue local de prompts" />
            <TextBox x:Name="PreviewText" Grid.Column="2"
                     FontFamily="Consolas" FontSize="12"
                     Padding="12" TextWrapping="Wrap"
                     IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     AutomationProperties.Name="Consignes originales du prompt sélectionné" />
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Sans prompt" Padding="12,8"
                        Margin="0,0,8,0" Click="Clear_Click" />
                <Button x:Name="AssignButton"
                        Content="Associer ce prompt" Padding="12,8"
                        Margin="0,0,8,0" Click="Assign_Click" />
                <Button Content="Annuler" Padding="12,8"
                        Click="Cancel_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Sélection explicite, sans exécution IA." />
        </DockPanel>
    </Grid>
</Window>
