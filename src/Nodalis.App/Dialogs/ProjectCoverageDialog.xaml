<Window x:Class="Nodalis.App.Dialogs.ProjectCoverageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Couverture et cohérence projet"
        Width="980"
        Height="700"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Padding="16,12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Couverture et cohérence projet"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="Analyse locale et déterministe. Chaque alerte expose la règle appliquée et les sources croisées ; aucune correction n'est effectuée."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ProjectText"
                           Margin="0,8,0,0"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText"
                           Margin="0,4,0,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Border>

        <ListBox x:Name="ResultsList"
                 Grid.Row="1"
                 Margin="14,12,14,10"
                 BorderThickness="1"
                 BorderBrush="{StaticResource BorderBrush}"
                 SelectionChanged="ResultsList_SelectionChanged"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SeverityLabel}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Code}"
                                       FontSize="10"
                                       FontFamily="Consolas"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Message}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding RuleExplanation}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding SourcesLabel}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="2"
                   Margin="14,0,14,10">
            <Button Click="Refresh_Click"
                    Content="Relancer l'analyse" />
            <Button x:Name="OpenSourceButton"
                    DockPanel.Dock="Right"
                    Margin="12,0,0,0"
                    IsEnabled="False"
                    Click="OpenSource_Click"
                    Content="Ouvrir la première source" />
        </DockPanel>

        <Border Grid.Row="3"
                Padding="12,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</Window>
