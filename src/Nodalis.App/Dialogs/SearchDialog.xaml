<Window x:Class="Nodalis.App.Dialogs.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recherche"
        Width="980"
        Height="760"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="SearchResultTemplate">
            <StackPanel Margin="8,6">
                <TextBlock FontWeight="SemiBold">
                    <Run Text="{Binding DisplayName}" />
                    <Run Text=" · ligne " />
                    <Run Text="{Binding LineNumber}" />
                    <Run Text=" · " />
                    <Run Text="{Binding MatchKindDisplay}" />
                </TextBlock>
                <TextBlock Margin="0,3,0,0"
                           Text="{Binding Excerpt}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="108" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Padding="14,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox"
                             Padding="10,6"
                             FontSize="16"
                             TextChanged="SearchTextBox_TextChanged" />

                    <CheckBox x:Name="ExactModeCheckBox"
                              Grid.Column="1"
                              Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              Checked="ExactModeCheckBox_Changed"
                              Unchecked="ExactModeCheckBox_Changed"
                              Content="Mode exact" />
                </Grid>

                <TextBlock Margin="2,5,0,0"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Fuzzy local par défaut : fautes et mots incomplets. Le mode exact conserve la recherche littérale." />

                <TextBlock Margin="2,3,0,0"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Filtres : type:spec · date:2026-10-05 · project:&quot;Projet Patate&quot; · status:actif · tag:api · @clé:valeur" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <Expander x:Name="ProjectExpander"
                          IsExpanded="True"
                          Margin="0,0,0,12">
                    <Expander.Header>
                        <TextBlock x:Name="ProjectHeader"
                                   Text="PROJET · 0 résultat" />
                    </Expander.Header>
                    <ListBox x:Name="ProjectResults"
                             MinHeight="80"
                             MaxHeight="220"
                             MouseDoubleClick="Results_MouseDoubleClick"
                             SelectionChanged="Results_SelectionChanged"
                             ItemTemplate="{StaticResource SearchResultTemplate}" />
                </Expander>

                <Expander x:Name="ApplicationExpander"
                          IsExpanded="True"
                          Margin="0,0,0,12">
                    <Expander.Header>
                        <TextBlock x:Name="ApplicationHeader"
                                   Text="APPLICATION · 0 résultat" />
                    </Expander.Header>
                    <ListBox x:Name="ApplicationResults"
                             MinHeight="80"
                             MaxHeight="220"
                             MouseDoubleClick="Results_MouseDoubleClick"
                             SelectionChanged="Results_SelectionChanged"
                             ItemTemplate="{StaticResource SearchResultTemplate}" />
                </Expander>

                <Expander x:Name="GlobalExpander"
                          IsExpanded="True">
                    <Expander.Header>
                        <TextBlock x:Name="GlobalHeader"
                                   Text="GLOBAL · 0 résultat" />
                    </Expander.Header>
                    <ListBox x:Name="GlobalResults"
                             MinHeight="80"
                             MaxHeight="220"
                             MouseDoubleClick="Results_MouseDoubleClick"
                             SelectionChanged="Results_SelectionChanged"
                             ItemTemplate="{StaticResource SearchResultTemplate}" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="12,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Saisissez un terme. Recherche fuzzy activée." />
        </Border>
    </Grid>
</Window>
