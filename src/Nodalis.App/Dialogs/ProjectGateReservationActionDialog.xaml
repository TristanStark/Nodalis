<Window x:Class="Nodalis.App.Dialogs.ProjectGateReservationActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Qualifier une réserve · Gate"
        Width="690" Height="510" MinWidth="490" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Grid.Row="0" FontSize="18"
                   FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" x:Name="DescriptionText" Margin="0,9,0,16"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}"/>
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Auteur de la qualification" FontWeight="SemiBold"/>
            <TextBox x:Name="ActorBox" MinHeight="30" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Motif explicite (10 caractères minimum)"
                       FontWeight="SemiBold"/>
            <TextBox x:Name="RationaleBox" Margin="0,5,0,0" MinHeight="65"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock x:Name="EvidenceHeadingText"
                       FontWeight="SemiBold" TextWrapping="Wrap"/>
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Choisir un fichier…"
                        Padding="12,7" Margin="9,0,0,0"
                        Click="ChooseEvidence_Click" />
                <TextBlock x:Name="EvidenceText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Aucune preuve sélectionnée" />
            </DockPanel>
        </StackPanel>
        <TextBlock Grid.Row="5" TextWrapping="Wrap" Margin="0,6,0,0"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Une nouvelle ligne d'historique sera ajoutée après confirmation. Le GO sous réserves, son dossier initial, ses critères et les jalons restent inchangés. Aucune IA ni action automatique." />
        <DockPanel Grid.Row="6" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ConfirmButton" Padding="14,8"
                        Click="Confirm_Click" Margin="0,0,8,0"/>
                <Button Content="Annuler" Padding="14,8"
                        Click="Cancel_Click"/>
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </DockPanel>
    </Grid>
</Window>
