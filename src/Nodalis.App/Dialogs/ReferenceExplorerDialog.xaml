<Window x:Class="Nodalis.App.Dialogs.ReferenceExplorerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Références"
        Width="900"
        Height="650"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Padding="14,10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Références vers"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="TargetText"
                           Margin="0,3,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SourceFilterTextBox"
                     Padding="8,5"
                     TextChanged="Filters_Changed"
                     ToolTip="Filtrer par nom, chemin ou extrait de la source" />

            <ComboBox x:Name="TypeFilterComboBox"
                      Grid.Column="2"
                      Height="31"
                      SelectionChanged="Filters_Changed" />

            <ComboBox x:Name="ScopeFilterComboBox"
                      Grid.Column="4"
                      Height="31"
                      SelectionChanged="Filters_Changed" />
        </Grid>

        <ListBox x:Name="ResultsList"
                 Grid.Row="2"
                 Margin="14,0,14,10"
                 BorderThickness="1"
                 BorderBrush="{StaticResource BorderBrush}"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10,7">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding TypeLabel}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding LineNumber, StringFormat='ligne {0}'}"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </DockPanel>
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding Source.QualifiedName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding Excerpt}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3"
                Padding="12,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</Window>
