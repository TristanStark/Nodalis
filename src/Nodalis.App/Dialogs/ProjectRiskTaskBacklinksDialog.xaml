<Window x:Class="Nodalis.App.Dialogs.ProjectRiskTaskBacklinksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Risques associés à la tâche · Nodalis 2.0"
        Width="805" Height="590" MinWidth="580" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeadingText" FontSize="18"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="SummaryText" Margin="0,7,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <ListBox x:Name="BacklinksList" Grid.Row="1"
                 SelectionChanged="Backlinks_SelectionChanged"
                 MouseDoubleClick="Backlinks_MouseDoubleClick"
                 Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,0,0,6"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,5,0,0"
                                       Text="{Binding TreatmentId}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" FontSize="10" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding RiskRelativePath}"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" FontSize="10" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="DiagnosticsText" Grid.Row="2"
                   Margin="0,10,0,0" MaxHeight="85"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource SecondaryTextBrush}" />
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Fermer" Margin="0,0,8,0"
                        Padding="12,8" Click="Close_Click" />
                <Button x:Name="OpenRiskButton" Content="Ouvrir la fiche RIS"
                        Padding="12,8" Click="OpenRisk_Click" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </DockPanel>
    </Grid>
</Window>
