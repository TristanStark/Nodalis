<UserControl x:Class="Nodalis.App.Dialogs.ProjectJourneyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="360">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Padding="18,14"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="ProjectNameText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="Parcours projet" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           Text="Les étapes pilotent le parcours, pas les tâches ni les jalons. Chaque changement est prévisualisé et confirmé. Les documents du projet ne sont jamais modifiés par cet écran." />
                <TextBlock x:Name="ProgressText"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <WrapPanel Grid.Row="1"
                   Margin="16,12,16,10"
                   Orientation="Horizontal">
            <ComboBox x:Name="ModelCombo"
                      Width="205" MinHeight="30"
                      Margin="0,0,8,8"
                      DisplayMemberPath="Name"
                      SelectionChanged="ModelCombo_SelectionChanged"
                      ToolTip="Choisir explicitement le modèle de parcours à initialiser"
                      AutomationProperties.Name="Modèle du futur parcours" />
            <Button x:Name="InitializeButton"
                    Padding="14,7"
                    Margin="0,0,8,8"
                    Content="Créer depuis le modèle"
                    Click="Initialize_Click" />
            <Button x:Name="ManageTemplatesButton"
                    Padding="14,7"
                    Margin="0,0,8,8"
                    Content="Modèles…"
                    Click="ManageTemplates_Click" />
            <Button Padding="14,7"
                    Margin="0,0,8,8"
                    Content="Recharger"
                    Click="Refresh_Click" />
        </WrapPanel>
        <Grid Grid.Row="2"
              Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ÉTAPES"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <ListBox x:Name="StepsList"
                             Grid.Row="1"
                             Margin="0,10,0,10"
                             SelectionChanged="StepsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="7,7">
                                    <TextBlock Text="{Binding Name}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StatusLabel}"
                                               Margin="0,3,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="2">
                        <Button x:Name="AddStepButton" Content="Ajouter"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="AddStep_Click" />
                        <Button x:Name="RenameStepButton" Content="Renommer"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="RenameStep_Click" />
                        <Button x:Name="MoveStepUpButton" Content="↑"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="MoveStepUp_Click" />
                        <Button x:Name="MoveStepDownButton" Content="↓"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="MoveStepDown_Click" />
                        <Button x:Name="RemoveStepButton" Content="Retirer"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="RemoveStep_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedStepText"
                               Text="Sélectionnez une étape"
                               FontWeight="SemiBold"
                               FontSize="15"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="1"
                                Margin="0,14,0,10">
                        <TextBlock Text="ÉTAT DE L'ÉTAPE"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <ComboBox x:Name="StatusCombo"
                                  Margin="0,5,0,0"
                                  MinHeight="30"
                                  DisplayMemberPath="Label"
                                  SelectionChanged="StatusCombo_SelectionChanged" />
                    </StackPanel>
                    <TextBlock Grid.Row="2"
                               Margin="0,5,0,7"
                               Text="OPÉRATIONS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <ListBox Grid.Row="3"
                             x:Name="OperationsList"
                             Margin="0,0,0,10"
                             DisplayMemberPath="Name"
                             SelectionChanged="OperationsList_SelectionChanged" />
                    <WrapPanel Grid.Row="4">
                        <Button x:Name="AddOperationButton" Content="Ajouter"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="AddOperation_Click" />
                        <Button x:Name="RenameOperationButton" Content="Renommer"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="RenameOperation_Click" />
                        <Button x:Name="MoveOperationUpButton" Content="↑"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="MoveOperationUp_Click" />
                        <Button x:Name="MoveOperationDownButton" Content="↓"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="MoveOperationDown_Click" />
                        <Button x:Name="RemoveOperationButton" Content="Retirer"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="RemoveOperation_Click" />
                    </WrapPanel>
                    <Expander Grid.Row="5"
                              Header="SOURCES ET PREUVES"
                              Margin="0,6,0,6"
                              Foreground="{StaticResource PrimaryTextBrush}"
                              Background="{StaticResource PanelBackgroundBrush}"
                              ToolTip="Références à des fichiers existants du workspace, sans copie">
                        <StackPanel>
                            <ListBox x:Name="SourcesList"
                                     MaxHeight="145"
                                     MinHeight="48"
                                     Margin="0,7,0,7"
                                     SelectionChanged="SourcesList_SelectionChanged"
                                     MouseDoubleClick="SourcesList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,5">
                                            <TextBlock Text="{Binding RelativePath}"
                                                       TextWrapping="Wrap"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding Availability}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel>
                                <Button x:Name="LinkSourceButton"
                                        Content="Lier un fichier…"
                                        Margin="0,0,7,7" Padding="10,5"
                                        Click="LinkSource_Click" />
                                <Button x:Name="OpenSourceButton"
                                        Content="Ouvrir"
                                        Margin="0,0,7,7" Padding="10,5"
                                        Click="OpenSource_Click" />
                                <Button x:Name="UnlinkSourceButton"
                                        Content="Délier"
                                        Margin="0,0,7,7" Padding="10,5"
                                        Click="UnlinkSource_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                    <Expander Grid.Row="6"
                              Header="RELATIONS · JALONS ET GATES"
                              Margin="0,6,0,6"
                              MaxHeight="230"
                              Foreground="{StaticResource PrimaryTextBrush}"
                              Background="{StaticResource PanelBackgroundBrush}"
                              ToolTip="Liens non propriétaires : ni jalon ni gate ne sont modifiés ici">
                        <StackPanel>
                            <TextBlock x:Name="RelationsDiagnosticsText"
                                       Margin="0,5,0,4"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <ListBox x:Name="RelationsList"
                                     MaxHeight="92" MinHeight="38"
                                     Margin="0,3,0,7"
                                     SelectionChanged="RelationsList_SelectionChanged"
                                     MouseDoubleClick="RelationsList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,5">
                                            <TextBlock Text="{Binding Label}"
                                                       FontWeight="SemiBold"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="10"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel>
                                <Button x:Name="RefreshRelationsButton"
                                        Content="Actualiser"
                                        Margin="0,0,7,7" Padding="10,5"
                                        Click="RefreshRelations_Click" />
                                <Button x:Name="LinkMilestoneButton"
                                        Content="Lier un jalon…"
                                        Margin="0,0,7,7" Padding="10,5"
                                        Click="LinkMilestone_Click" />
                                <Button x:Name="GateRegistryButton"
                                        Content="Gates…"
                                        Margin="0,0,7,7" Padding="10,5"
                                        Click="GateRegistry_Click" />
                                <Button x:Name="OpenRelationButton"
                                        Content="Ouvrir"
                                        Margin="0,0,7,7" Padding="10,5"
                                        Click="OpenRelation_Click" />
                                <Button x:Name="UnlinkRelationButton"
                                        Content="Délier"
                                        Margin="0,0,7,7" Padding="10,5"
                                        Click="UnlinkRelation_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                    <WrapPanel Grid.Row="7" Margin="0,4,0,0">
                        <TextBlock x:Name="PromptKeyText"
                                   Text="Prompt : —"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Margin="0,0,8,7"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="SetOperationPromptButton"
                                Content="Associer un prompt…"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="SetOperationPrompt_Click" />
                        <Button x:Name="PrepareOperationPromptButton"
                                Content="Préparer / copier"
                                Margin="0,0,7,7" Padding="10,5"
                                Click="PrepareOperationPrompt_Click" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="3"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Padding="18,6"
                        Content="Fermer"
                        Click="CloseView_Click" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
