<Window x:Class="Nodalis.App.Dialogs.MilestoneListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jalons"
        Width="1020"
        Height="740"
        MinWidth="800"
        MinHeight="540"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border Padding="16,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Jalons du projet"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ScopeText"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Width="88"
                            Margin="0,0,8,0"
                            Click="Add_Click"
                            Content="Ajouter" />
                    <Button Width="88"
                            Margin="0,0,8,0"
                            Click="Edit_Click"
                            Content="Modifier" />
                    <Button Width="96"
                            Margin="0,0,8,0"
                            Click="NavigateDependency_Click"
                            Content="Prérequis" />
                    <Button Width="88"
                            Click="Delete_Click"
                            Content="Supprimer" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Margin="12">
            <TabItem Header="Liste">
                <ListBox x:Name="MilestonesList"
                         BorderThickness="0"
                         Background="Transparent"
                         MouseDoubleClick="MilestonesList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,7"
                                    Padding="12"
                                    CornerRadius="5"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TargetDate, StringFormat={}{0:dd/MM/yyyy}}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Description}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding DependencySummary}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="{Binding DependencyWarningSummary}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding Link}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Status}"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <TabItem Header="Timeline">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="TimelineList"
                             BorderThickness="0"
                             Background="Transparent"
                             MouseDoubleClick="TimelineList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Top"
                                               Text="{Binding TargetDate, StringFormat={}{0:dd/MM/yyyy}}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />

                                    <Grid Grid.Column="1">
                                        <Border Width="2"
                                                HorizontalAlignment="Center"
                                                Background="{StaticResource BorderBrush}" />
                                        <Ellipse Width="10"
                                                 Height="10"
                                                 VerticalAlignment="Top"
                                                 Margin="0,3,0,0"
                                                 Fill="{StaticResource AccentBrush}" />
                                    </Grid>

                                    <Border Grid.Column="2"
                                            Padding="12"
                                            CornerRadius="5"
                                            Background="{StaticResource PanelBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding Status}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Margin="0,5,0,0"
                                                       Text="{Binding DependencySummary}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding DependencyWarningSummary}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Padding="12,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <Button Width="90"
                        HorizontalAlignment="Right"
                        IsCancel="True"
                        Content="Fermer" />
            </Grid>
        </Border>
    </Grid>
</Window>
