<Window x:Class="Nodalis.App.Dialogs.DiagnosticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostics locaux"
        Width="820"
        Height="620"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Diagnostics et récupération"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="1"
                    Margin="0,10,0,12">
            <TextBlock x:Name="SessionStateText"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="DiagnosticsPathText"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Le rapport reste local. Nodalis ne l'envoie à aucun service."
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBox x:Name="ReportTextBox"
                 Grid.Row="2"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,0,8,0"
                    Click="OpenFolder_Click"
                    Content="Ouvrir le dossier" />
            <Button Margin="0,0,8,0"
                    Click="CopyReport_Click"
                    Content="Copier le rapport" />
            <Button IsCancel="True"
                    Content="Fermer" />
        </StackPanel>
    </Grid>
</Window>
