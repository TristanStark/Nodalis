<Window x:Class="Nodalis.App.Dialogs.MaintenanceHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historique de maintenance"
        Width="1040" Height="735" MinWidth="680" MinHeight="520"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Historique de maintenance" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Incidents et interventions des projets · résultats reliés au Markdown original"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,5,0,10"/>
        </StackPanel>
        <Border Grid.Row="1" Padding="12" Margin="0,0,0,12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Contexte" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ScopeComboBox" Grid.Column="1" MinHeight="30"
                              SelectionChanged="FilterChanged"
                              AutomationProperties.Name="Contexte des fiches de maintenance"/>
                    <TextBox x:Name="SearchTextBox" Grid.Column="3" MinHeight="32"
                             Padding="8,5" TextChanged="SearchChanged"
                             AutomationProperties.Name="Rechercher dans l'historique"
                             ToolTip="Recherche dans les résumés, diagnostics, actions, résultats et notes Markdown"/>
                </Grid>
                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Margin="0,0,12,7">
                        <TextBlock Text="Du" Margin="0,0,0,4"/>
                        <DatePicker x:Name="FromPicker" Width="140" SelectedDateFormat="Short"
                                    SelectedDateChanged="DateChanged"
                                    AutomationProperties.Name="Date de début"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,7">
                        <TextBlock Text="Au" Margin="0,0,0,4"/>
                        <DatePicker x:Name="ToPicker" Width="140" SelectedDateFormat="Short"
                                    SelectedDateChanged="DateChanged"
                                    AutomationProperties.Name="Date de fin"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,7">
                        <TextBlock Text="Statut" Margin="0,0,0,4"/>
                        <ComboBox x:Name="StatusComboBox" Width="142" MinHeight="30"
                                  SelectionChanged="FilterChanged"
                                  AutomationProperties.Name="Filtrer par statut"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,7">
                        <TextBlock Text="Catégorie" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryComboBox" Width="142" MinHeight="30"
                                  SelectionChanged="FilterChanged"
                                  AutomationProperties.Name="Filtrer par catégorie"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,7">
                        <TextBlock Text="Tag" Margin="0,0,0,4"/>
                        <TextBox x:Name="TagTextBox" Width="160" MinHeight="30"
                                 Padding="7,4" TextChanged="SearchChanged"
                                 AutomationProperties.Name="Filtrer par tag"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock x:Name="SummaryText" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
                <TextBlock x:Name="WarningsText" Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="180"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.4*" MinWidth="230"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="IncidentTitleText" Text="Incidents" FontWeight="SemiBold"
                           Margin="0,0,0,7"/>
                <ListBox x:Name="IncidentsList" Grid.Row="1"
                         BorderBrush="{StaticResource BorderBrush}"
                         Background="{StaticResource PanelBackgroundBrush}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         MouseDoubleClick="Open_DoubleClick"
                         AutomationProperties.Name="Incidents de maintenance">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6">
                                <TextBlock Text="{Binding DateLabel}" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Status}" FontSize="11"/>
                                <TextBlock Text="{Binding WarningLabel}" TextWrapping="Wrap"
                                           FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,7">
                    <TextBlock x:Name="InterventionTitleText" Text="Interventions"
                               DockPanel.Dock="Left" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <CheckBox x:Name="LinkedOnlyCheckBox" DockPanel.Dock="Right"
                              HorizontalAlignment="Right" Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              Content="Liées à l'incident sélectionné"
                              Checked="RelatedFilterChanged"
                              Unchecked="RelatedFilterChanged"
                              ToolTip="Afficher uniquement les interventions associées à l'incident choisi"/>
                </DockPanel>
                <ListBox x:Name="InterventionsList" Grid.Row="1"
                         BorderBrush="{StaticResource BorderBrush}"
                         Background="{StaticResource PanelBackgroundBrush}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         MouseDoubleClick="Open_DoubleClick"
                         AutomationProperties.Name="Interventions de maintenance">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6">
                                <TextBlock Text="{Binding DateLabel}" FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                           FontWeight="SemiBold" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Resolution}" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SourceLabel}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Status}" FontSize="11"/>
                                <TextBlock Text="{Binding WarningLabel}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,13,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Double-cliquez pour ouvrir la ligne Markdown."
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0"/>
            <Button DockPanel.Dock="Right" Content="Fermer" IsCancel="True"
                    MinWidth="85" Margin="7,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Modifier" MinWidth="90"
                    Click="Edit_Click" Margin="7,0,0,0"/>
            <Button DockPanel.Dock="Right" Content="Ouvrir la source" MinWidth="125"
                    IsDefault="True" Click="Open_Click"/>
        </DockPanel>
    </Grid>
</Window>