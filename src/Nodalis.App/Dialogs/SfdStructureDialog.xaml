<Window x:Class="Nodalis.App.Dialogs.SfdStructureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conditions, sous-conditions et règles SFD"
        Width="850" Height="660" MinWidth="650" MinHeight="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Complétude et rédaction métier SFD" FontSize="20"
                   FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Margin="0,0,0,16" TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Chaque C/SC conserve son GUID. Une RM appartient au catalogue commun et peut être liée à plusieurs sous-conditions."/>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Exigence" VerticalAlignment="Center"/>
            <ComboBox x:Name="RequirementComboBox" Grid.Column="1"
                      MinHeight="32" DisplayMemberPath="Label"
                      SelectionChanged="Requirement_SelectionChanged"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Condition (C)" VerticalAlignment="Center"/>
            <ComboBox x:Name="ConditionComboBox" Grid.Column="1"
                      MinHeight="32" DisplayMemberPath="Label"
                      SelectionChanged="Condition_SelectionChanged"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Sous-condition (SC)" VerticalAlignment="Center"/>
            <ComboBox x:Name="SubconditionComboBox" Grid.Column="1"
                      MinHeight="32" DisplayMemberPath="Label"
                      SelectionChanged="Subcondition_SelectionChanged"/>
        </Grid>
        <Grid Grid.Row="5" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Règle métier (RM)" VerticalAlignment="Center"/>
            <ComboBox x:Name="RuleComboBox" Grid.Column="1"
                      MinHeight="32" DisplayMemberPath="Label"
                      SelectionChanged="Rule_SelectionChanged"/>
        </Grid>
        <WrapPanel Grid.Row="6" Margin="0,0,0,16">
            <Button x:Name="AddConditionButton" Content="+ Condition" MinWidth="112"
                    Margin="0,0,8,8" Padding="8,5" Click="AddCondition_Click"/>
            <Button x:Name="AddSubconditionButton" Content="+ Sous-condition"
                    MinWidth="132" Margin="0,0,8,8" Padding="8,5"
                    Click="AddSubcondition_Click"/>
            <Button x:Name="AddRuleButton" Content="+ Règle métier"
                    MinWidth="126" Margin="0,0,8,8" Padding="8,5"
                    Click="AddRule_Click"/>
            <Button x:Name="LinkRuleButton" Content="Lier RM à SC"
                    MinWidth="108" Margin="0,0,8,8" Padding="8,5"
                    Click="LinkRule_Click"/>
            <Button x:Name="UnlinkRuleButton" Content="Dissocier RM"
                    MinWidth="108" Margin="0,0,8,8" Padding="8,5"
                    Click="UnlinkRule_Click"/>
        </WrapPanel>
        <Grid Grid.Row="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Diagnostic de complétude (lecture seule)"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ListBox x:Name="FindingsListBox" Grid.Row="1" MinHeight="100"
                     DisplayMemberPath="Label"/>
        </Grid>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Margin="0,0,16,0"/>
            <Button Content="Fermer" Width="100" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
