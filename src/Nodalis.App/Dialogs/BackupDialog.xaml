<Window x:Class="Nodalis.App.Dialogs.BackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sauvegardes"
        Width="980"
        Height="700"
        MinWidth="820"
        MinHeight="580"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Border Padding="18"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Sauvegardes du workspace"
                               FontSize="19"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,0"
                               Text="ZIP standard, vérifié avant conservation et avant toute restauration."
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <Grid Grid.Row="1"
                      Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Text="Destination" />
                    <TextBox x:Name="DestinationTextBox"
                             Grid.Column="1"
                             Margin="8,0"
                             Padding="7,5"
                             TextChanged="DestinationTextBox_TextChanged" />
                    <Button Grid.Column="2"
                            Click="BrowseDestination_Click"
                            Content="Parcourir" />
                </Grid>

                <Grid Grid.Row="2"
                      Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="AutomaticCheckBox"
                              VerticalAlignment="Center"
                              Content="Sauvegarde automatique" />

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Text="Cadence (min)" />
                    <TextBox x:Name="IntervalTextBox"
                             Grid.Column="3"
                             Margin="8,0,0,0"
                             Padding="6,4" />

                    <TextBlock Grid.Column="5"
                               VerticalAlignment="Center"
                               Text="Rétention" />
                    <TextBox x:Name="RetentionTextBox"
                             Grid.Column="6"
                             Margin="8,0,0,0"
                             Padding="6,4" />

                    <Button Grid.Column="8"
                            Click="Refresh_Click"
                            Content="Actualiser" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Margin="4,0,0,10"
                       Text="Archives disponibles"
                       FontWeight="SemiBold" />

            <ListBox x:Name="BackupsList"
                     Grid.Row="1"
                     BorderThickness="0"
                     Background="Transparent"
                     SelectionChanged="BackupsList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Padding="12"
                                CornerRadius="5"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding StatusMessage}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{Binding CreatedUtc, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Text="{Binding DisplaySize}"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Grid.Column="3"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Text="{Binding Status}"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2"
                Padding="12,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <StackPanel x:Name="ActionsPanel"
                            Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Width="150"
                            Margin="0,0,8,0"
                            Click="BackupNow_Click"
                            Content="Sauvegarder maintenant" />
                    <Button x:Name="RestoreSelectedButton"
                            Width="130"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="RestoreSelected_Click"
                            Content="Restaurer sélection" />
                    <Button Width="140"
                            Margin="0,0,8,0"
                            Click="RestoreArchive_Click"
                            Content="Restaurer une archive" />
                    <Button Width="140"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="Save_Click"
                            Content="Enregistrer et fermer" />
                    <Button Width="80"
                            IsCancel="True"
                            Content="Fermer" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
