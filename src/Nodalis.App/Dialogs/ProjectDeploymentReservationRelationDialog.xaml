<Window x:Class="Nodalis.App.Dialogs.ProjectDeploymentReservationRelationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réserve · liens vers les tâches et jalons"
        Width="810" Height="680" MinWidth="550" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Associer une tâche ou un jalon existant"
                       FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="HeadingText" Margin="0,6,0,0"
                       TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Seules les identités persistantes du projet peuvent être associées. Leurs statuts ne changent pas ; les références supprimées peuvent être dissociées sans recréer le document." />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="280" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="5" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="HISTORIQUE ET LIENS ACTIFS"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,0,0,8" />
                    <TextBox x:Name="HistoryBox" IsReadOnly="True"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas" FontSize="12"
                             Padding="8" />
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,0,0,0">
                    <TextBlock Text="Opération" Margin="0,0,0,5" />
                    <ComboBox x:Name="ActionCombo" Padding="8,6"
                              DisplayMemberPath="Label"
                              SelectionChanged="Choice_SelectionChanged" />
                    <TextBlock Text="Type d'élément" Margin="0,13,0,5" />
                    <ComboBox x:Name="KindCombo" Padding="8,6"
                              DisplayMemberPath="Label"
                              SelectionChanged="Choice_SelectionChanged" />
                    <Button x:Name="LoadTargetsButton"
                            Content="Charger les éléments du projet"
                            Click="LoadTargets_Click" Padding="10,7"
                            HorizontalAlignment="Right" Margin="0,9,0,0"
                            ToolTip="Recherche uniquement sur demande ; aucun scan pendant la navigation" />
                    <TextBlock Text="Tâche / jalon choisi" Margin="0,12,0,5" />
                    <ComboBox x:Name="TargetCombo" Padding="8,6"
                              DisplayMemberPath="Label"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling" />
                    <TextBlock x:Name="CandidatesText" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="Auteur de la décision" Margin="0,16,0,5" />
                    <TextBox x:Name="ActorBox" Padding="8,6" />
                    <TextBlock Text="Justification du lien / de la dissociation"
                               Margin="0,12,0,5" TextWrapping="Wrap" />
                    <TextBox x:Name="ReasonBox" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="86" Padding="8,6" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Un lien n'effectue aucune création ni clôture de tâche ou de jalon. Les anciennes décisions restent visibles dans l'historique." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,12,0,0"
                   LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Fermer"
                    IsCancel="True" Padding="12,7" Click="Close_Click" />
            <Button x:Name="SaveButton" DockPanel.Dock="Right"
                    Content="Consigner cette relation…"
                    Padding="12,7" Margin="0,0,8,0" Click="Save_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Text="Aucune lecture de cibles sans demande." />
        </DockPanel>
    </Grid>
</Window>
