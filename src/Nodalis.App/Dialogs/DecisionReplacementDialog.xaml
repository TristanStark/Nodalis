<Window x:Class="Nodalis.App.Dialogs.DecisionReplacementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remplacer une décision"
        Width="560"
        Height="310"
        MinWidth="480"
        MinHeight="280"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="18">
            <TextBlock Text="Décision remplacée"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <TextBlock x:Name="PreviousDecisionText"
                       Margin="0,5,0,0"
                       FontSize="17"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Margin="18,0,18,18">
            <TextBlock Text="Remplaçante"
                       FontWeight="SemiBold" />
            <ComboBox x:Name="ReplacementComboBox"
                      Margin="0,6,0,0"
                      MinHeight="34"
                      Padding="6,3"
                      DisplayMemberPath="Title" />
            <TextBlock Margin="0,10,0,0"
                       Text="La décision source passera à Superseded. La remplaçante passera à Active et les deux fichiers conserveront des liens réciproques."
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="14,9"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="92"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="Annuler" />
                <Button Width="112"
                        IsDefault="True"
                        Click="Confirm_Click"
                        Content="Remplacer" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
