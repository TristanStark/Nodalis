<Window x:Class="Nodalis.App.Dialogs.ProjectTestCampaignsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campagnes et passages de recette · Nodalis 2.0"
        Width="1190" Height="775" MinWidth="760" MinHeight="530"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Campagnes de tests · passages figés"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="La définition Markdown ne change pas lors d'un résultat. Un passage fige ses tests, son environnement et sa version ; conforme déclaré ne vaut ni preuve contrôlée ni validation d'exigence."/>
            <TextBlock x:Name="SummaryText" Margin="0,8,0,0"
                       TextWrapping="Wrap" FontWeight="SemiBold"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Padding="9" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="CAMPAGNES REC"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <ListBox x:Name="CampaignsList" Grid.Row="1" Margin="0,8,0,0"
                             SelectionChanged="CampaignsList_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="7,7">
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,4,0,0"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Padding="9" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="PASSAGES"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <ListBox x:Name="PassagesList" Grid.Row="1" Margin="0,8,0,0"
                             SelectionChanged="PassagesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="7,8">
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}"
                                               Margin="0,4,0,0"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="4" Padding="9" CornerRadius="5"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="TESTS ET RÉSULTATS EXACTS"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <ListBox x:Name="TestsList" Grid.Row="1" Margin="0,8,0,8"
                             SelectionChanged="TestsList_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,5">
                                    <TextBlock Text="{Binding Label}"
                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,4,0,0"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="DÉTAILS ET PROVENANCE"
                               FontSize="11" FontWeight="SemiBold"
                               Margin="0,6,0,8"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <TextBox x:Name="DetailsBox" Grid.Row="3"
                             IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" FontFamily="Consolas"
                             FontSize="11" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Détails du passage et de ses résultats"/>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="CreateButton" Content="Nouvelle campagne…"
                        Padding="11,8" Margin="0,0,8,5"
                        Click="Create_Click"/>
                <Button x:Name="StartButton" Content="Lancer un passage…"
                        Padding="11,8" Margin="0,0,8,5"
                        Click="Start_Click"/>
                <Button x:Name="RecordButton" Content="Enregistrer un résultat…"
                        Padding="11,8" Margin="0,0,8,5"
                        Click="Record_Click"/>
                <Button x:Name="OpenButton" Content="Ouvrir la fiche REC"
                        Padding="11,8" Margin="0,0,8,5"
                        Click="Open_Click"/>
                <Button x:Name="RefreshButton" Content="Actualiser"
                        Padding="11,8" Margin="0,0,8,5"
                        Click="Refresh_Click"/>
                <Button Content="Fermer" Padding="11,8"
                        Click="Close_Click"/>
            </WrapPanel>
            <TextBlock x:Name="StatusText" Grid.Row="1"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </Grid>
    </Grid>
</Window>
