<Window x:Class="Nodalis.App.Dialogs.ProjectHealthDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Project Health Check"
        Width="980"
        Height="700"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border Padding="16,12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Project Health Check"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,0"
                           Text="Analyse locale, déterministe et strictement en lecture seule. Aucun correctif n'est appliqué automatiquement."
                           Foreground="{StaticResource SecondaryTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="ProjectText"
                           Margin="0,8,0,0"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText"
                           Margin="0,4,0,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    Margin="14,10"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <TextBlock Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="Réunion récente :" />
            <TextBox x:Name="MeetingDaysTextBox"
                     Width="64"
                     Margin="0,0,6,0"
                     Text="30"
                     VerticalContentAlignment="Center" />
            <TextBlock Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       Text="jours"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <Button x:Name="RefreshButton"
                    Click="Refresh_Click"
                    Content="Relancer le Health Check" />
        </StackPanel>

        <ListBox x:Name="ResultsList"
                 Grid.Row="2"
                 Margin="14,0,14,10"
                 BorderThickness="1"
                 BorderBrush="{StaticResource BorderBrush}"
                 SelectionChanged="ResultsList_SelectionChanged"
                 MouseDoubleClick="ResultsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding SeverityLabel}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding Code}"
                                       FontSize="10"
                                       FontFamily="Consolas"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Message}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding LocationLabel}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3"
                   Margin="14,0,14,10">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Double-cliquez un résultat Markdown pour ouvrir directement sa source." />
            <Button x:Name="OpenSourceButton"
                    DockPanel.Dock="Right"
                    Margin="12,0,0,0"
                    IsEnabled="False"
                    Click="OpenSource_Click"
                    Content="Ouvrir la source" />
        </DockPanel>

        <Border Grid.Row="4"
                Padding="12,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </Border>
    </Grid>
</Window>
