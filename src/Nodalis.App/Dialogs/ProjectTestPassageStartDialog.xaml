<Window x:Class="Nodalis.App.Dialogs.ProjectTestPassageStartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau passage de recette · Nodalis 2.0"
        Width="790" Height="680" MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Figer un nouveau passage"
                       FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Choisissez les tests du projet. Leur définition exacte, l'environnement et la version seront figés. Aucun résultat n'est déduit au lancement."/>
        </StackPanel>
        <Border Grid.Row="1" CornerRadius="5" Padding="8"
                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                Background="{StaticResource PanelBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="4,2,4,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Tout sélectionner" Padding="9,6"
                                Margin="0,0,8,0" Click="SelectAll_Click"/>
                        <Button Content="Tout désélectionner" Padding="9,6"
                                Click="Clear_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SelectionText" VerticalAlignment="Center"
                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                </DockPanel>
                <ListBox x:Name="TestsList" Grid.Row="1"
                         SelectionMode="Extended"
                         SelectionChanged="TestsList_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.IsDeferredScrollingEnabled="True"
                         AutomationProperties.Name="Tests à figer dans ce passage">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="7,6">
                                <TextBlock Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RelativePath}"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Environnement" Margin="0,0,0,5"/>
                <TextBox x:Name="EnvironmentBox" MinHeight="30"
                         AutomationProperties.Name="Environnement du passage"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Version applicative" Margin="0,0,0,5"/>
                <TextBox x:Name="VersionBox" MinHeight="30"
                         AutomationProperties.Name="Version du passage"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Responsable du passage" Margin="0,0,0,5"/>
                <TextBox x:Name="ActorBox" MinHeight="30"
                         AutomationProperties.Name="Responsable du passage"/>
            </StackPanel>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annuler" IsCancel="True"
                        Padding="13,8" Margin="0,0,8,0"/>
                <Button Content="Préparer le passage" IsDefault="True"
                        Padding="13,8" Click="Confirm_Click"/>
            </StackPanel>
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="La validation définitive sera demandée après cette sélection."/>
        </DockPanel>
    </Grid>
</Window>
