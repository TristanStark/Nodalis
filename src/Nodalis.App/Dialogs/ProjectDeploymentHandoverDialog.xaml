<Window x:Class="Nodalis.App.Dialogs.ProjectDeploymentHandoverDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stabilisation et passation à l'exploitation"
        Width="850" Height="790" MinWidth="585" MinHeight="495"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Revue de stabilisation et transfert exploitation"
                       FontSize="19" FontWeight="SemiBold" />
            <TextBlock x:Name="AttemptText" Margin="0,5,0,0"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Sept domaines à qualifier. Les observations et preuves restent déclaratives ; même une acceptation ne crée aucun Go/No-Go ni contrôle technique automatique. Une nouvelle revue conserve les anciennes décisions." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Annuler" IsCancel="True"
                    Padding="12,7" Margin="0,0,8,0" />
            <Button Content="Revoir puis consigner…"
                    Click="Accept_Click" IsDefault="True" Padding="12,7" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Verdict de passation" Margin="0,4,0,5" />
                <ComboBox x:Name="OutcomeCombo" Padding="8,6"
                          DisplayMemberPath="Label" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Auteur de la revue" Margin="0,0,0,5" />
                        <TextBox x:Name="ActorBox" Padding="8,6" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Destinataire exploitation"
                                   Margin="0,0,0,5" />
                        <TextBox x:Name="RecipientBox" Padding="8,6" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Justification de la décision" Margin="0,12,0,5" />
                <TextBox x:Name="RationaleBox" Padding="8,6"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="55" />
                <TextBlock Text="Réserves et actions à reprendre (si applicable)"
                           Margin="0,12,0,5" />
                <TextBox x:Name="ReservationsBox" Padding="8,6"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" />
                <TextBlock Text="CONTRÔLES DE STABILISATION ET DE TRANSFERT"
                           FontWeight="SemiBold" FontSize="11" Margin="0,18,0,7"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ItemsControl x:Name="ChecksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="9" Margin="0,0,0,9">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Statuses}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Status"
                                                  SelectedValue="{Binding Status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Padding="6,4" />
                                    </Grid>
                                    <TextBlock Text="Constat / justification"
                                               FontSize="11" Margin="0,8,0,3" />
                                    <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="7,5" TextWrapping="Wrap"
                                             ToolTip="Observation saisie par une personne, jamais déduite de Nodalis" />
                                    <TextBlock Text="Preuve relative au workspace (facultative)"
                                               FontSize="11" Margin="0,7,0,3" />
                                    <TextBox Text="{Binding EvidencePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="7,5"
                                             ToolTip="Fichier existant du projet ; empreinte recalculée avant enregistrement" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
