<Window x:Class="Nodalis.App.Dialogs.GlossaryLookupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glossaire"
        Width="760"
        Height="620"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Border Padding="14,10"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <TextBox x:Name="SearchTextBox"
                     Padding="10,6"
                     FontSize="16"
                     TextChanged="SearchTextBox_TextChanged" />
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <Border x:Name="PrimaryCard"
                        Padding="14"
                        CornerRadius="6"
                        Background="{StaticResource PanelElevatedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="PrimaryScopeText"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="PrimaryTermText"
                                   Margin="0,5,0,0"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="PrimaryDefinitionText"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="PrimaryAliasesText"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock x:Name="PrimaryLinksText"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Click="OpenPrimary_Click"
                                Content="Ouvrir l'entrée Markdown" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="NotFoundText"
                           Text="Saisissez un terme, synonyme ou acronyme."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <TextBlock x:Name="AlternativesHeader"
                           Margin="0,20,0,8"
                           Text="AUTRES DÉFINITIONS"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Visibility="Collapsed" />

                <ListBox x:Name="AlternativesList"
                         BorderThickness="0"
                         Background="Transparent"
                         MouseDoubleClick="AlternativesList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12"
                                    CornerRadius="5"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Scope.DisplayName}"
                                               FontSize="11"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Term}"
                                               Margin="0,3,0,0"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Definition}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="12,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Button Width="90"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Content="Fermer" />
        </Border>
    </Grid>
</Window>
