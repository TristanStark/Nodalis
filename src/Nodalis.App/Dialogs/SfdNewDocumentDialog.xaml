<Window x:Class="Nodalis.App.Dialogs.SfdNewDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvel objet métier SFD"
        Width="620" Height="430" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Créer un objet métier SFD" FontSize="20"
                   FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Foreground="{StaticResource SecondaryTextBrush}"
                   Text="Un brouillon Markdown identifié sera créé. Aucun contenu métier ne sera inventé."
                   TextWrapping="Wrap" Margin="0,0,0,18"/>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Type d'objet" VerticalAlignment="Center"/>
            <ComboBox x:Name="KindComboBox" Grid.Column="1" MinHeight="32"
                      DisplayMemberPath="Label"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Titre" VerticalAlignment="Center"/>
            <TextBox x:Name="TitleTextBox" Grid.Column="1" MinHeight="32"
                     Padding="6,4" MaxLength="240"/>
        </Grid>
        <Grid x:Name="ParentPanel" Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="125"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ParentLabel" Text="Parent métier"
                       VerticalAlignment="Center"/>
            <ComboBox x:Name="ParentComboBox" Grid.Column="1" MinHeight="32"
                      DisplayMemberPath="Label"/>
        </Grid>
        <StackPanel Grid.Row="5">
            <Grid x:Name="ModePanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Fonctionnalité" VerticalAlignment="Center"/>
                <ComboBox x:Name="ModeComboBox" Grid.Column="1" MinHeight="32"
                          DisplayMemberPath="Label"/>
            </Grid>
            <TextBlock x:Name="HelpText" Margin="0,12,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Margin="0,20,0,0"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" IsCancel="True" Content="Annuler"/>
            <Button Width="120" IsDefault="True" Click="Create_Click" Content="Créer"/>
        </StackPanel>
    </Grid>
</Window>
