<Window x:Class="Nodalis.App.Dialogs.ProjectRiskMeasureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exécution des mesures du risque · Nodalis 2.0"
        Width="760" Height="720" MinWidth="550" MinHeight="470"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeadingText" FontSize="18"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="IntroText" Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,4,10,8">
                <TextBlock Text="Mesure du plan actuel"
                           FontWeight="SemiBold" />
                <ComboBox x:Name="MeasureCombo" Margin="0,5,0,10"
                          MinHeight="34" SelectionChanged="Measure_Changed" />
                <TextBlock x:Name="MeasureText" TextWrapping="Wrap"
                           Margin="0,0,0,12" />
                <TextBlock x:Name="PreviousText" FontWeight="SemiBold"
                           TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="Nouveau statut déclaré"
                           FontWeight="SemiBold" />
                <ComboBox x:Name="StatusCombo" MinHeight="34"
                          Margin="0,5,0,12" SelectionChanged="Status_Changed" />
                <TextBlock Text="Personne déclarant l'avancement"
                           FontWeight="SemiBold" />
                <TextBox x:Name="ActorBox" Margin="0,5,0,12"
                         MaxLength="120" />
                <TextBlock Text="Motif / explication de ce changement"
                           FontWeight="SemiBold" />
                <TextBox x:Name="RationaleBox" Margin="0,5,0,12"
                         MinHeight="70" MaxLength="4000"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
                <TextBlock x:Name="EvidenceLabel"
                           Text="Preuve ou compte rendu de vérification (obligatoire si terminé)"
                           FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBox x:Name="EvidenceBox" Margin="0,5,0,10"
                         MinHeight="70" MaxLength="2000"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annuler" Padding="12,8"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Proposer l'avancement" Padding="12,8"
                        Click="Accept_Click" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Aucune tâche Markdown n'est automatiquement clôturée." />
        </DockPanel>
    </Grid>
</Window>
