<Window x:Class="Nodalis.App.Dialogs.ProjectAiResponsePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prévisualiser une réponse IA · Nodalis 2.0"
        Width="1060" Height="795" MinWidth="740" MinHeight="540"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,9">
            <TextBlock Text="Réponse IA externe — lecture seule"
                       FontSize="20" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Collez une enveloppe nodalis.import.v1. Les propositions sont non fiables : aucune création, mise à jour, validation, suppression ni requête réseau." />
        </StackPanel>
        <TextBox x:Name="RawResponseBox" Grid.Row="1"
                 FontFamily="Consolas" FontSize="12"
                 Padding="10" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextChanged="RawResponseBox_TextChanged"
                 AutomationProperties.Name="Coller la réponse JSON externe ici" />
        <DockPanel Grid.Row="2" Margin="0,9,0,8">
            <Button DockPanel.Dock="Right" x:Name="AnalyzeButton"
                    Content="Analyser (sans importer)" Padding="14,7"
                    Click="Analyze_Click" />
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Aucune proposition lue. Résultat non enregistré." />
        </DockPanel>
        <ListView x:Name="ProposalsList" Grid.Row="3"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingStackPanel.IsVirtualizing="True"
                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                  SelectionChanged="ProposalsList_SelectionChanged"
                  AutomationProperties.Name="Propositions IA non approuvées">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Type" DisplayMemberBinding="{Binding Kind}" Width="115"/>
                    <GridViewColumn Header="Proposition" DisplayMemberBinding="{Binding Operation}" Width="110"/>
                    <GridViewColumn Header="Certitude IA" DisplayMemberBinding="{Binding Certainty}" Width="105"/>
                    <GridViewColumn Header="Référence candidate" DisplayMemberBinding="{Binding CandidateReference}" Width="190"/>
                    <GridViewColumn Header="GUID de proposition" DisplayMemberBinding="{Binding ProposalId}" Width="270"/>
                </GridView>
            </ListView.View>
        </ListView>
        <TextBox x:Name="DetailsBox" Grid.Row="4" Margin="0,9,0,0"
                 FontFamily="Consolas" FontSize="12" Padding="10"
                 AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Détail de la proposition non fiable" />
        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Padding="14,8"
                    Click="Close_Click" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Prévisualisation uniquement · aucune écriture autorisée." />
        </DockPanel>
    </Grid>
</Window>
