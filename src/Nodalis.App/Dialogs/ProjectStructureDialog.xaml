<Window x:Class="Nodalis.App.Dialogs.ProjectStructureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Structure du projet"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="ProjectTitleText"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0"
                       Text="Les rôles Jalons, Technique, Glossaire et Tests doivent toujours rester présents, mais leurs sections peuvent être renommées et réordonnées."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="12"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="SECTIONS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <ListBox x:Name="SectionsList"
                             Grid.Row="1"
                             Margin="0,8,0,10"
                             SelectionChanged="SectionsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,5">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding RequiredRoleDisplay}"
                                               FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock Margin="0,1,0,0"
                                               FontSize="10"
                                               Foreground="{StaticResource SecondaryTextBrush}">
                                        <Run Text="{Binding DocumentCount}" />
                                        <Run Text=" document(s)" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="2">
                        <Button Margin="0,0,6,6"
                                Padding="10,5"
                                Click="MoveSectionUp_Click"
                                Content="↑ Monter" />
                        <Button Margin="0,0,6,6"
                                Padding="10,5"
                                Click="MoveSectionDown_Click"
                                Content="↓ Descendre" />
                        <Button Margin="0,0,6,6"
                                Padding="10,5"
                                Click="RenameSection_Click"
                                Content="Renommer" />
                        <Button Margin="0,0,0,6"
                                Padding="10,5"
                                Click="DeleteSection_Click"
                                Content="Supprimer" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="12"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="DocumentsTitleText"
                               Text="DOCUMENTS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <ListBox x:Name="DocumentsList"
                             Grid.Row="1"
                             Margin="0,8,0,12" />

                    <TextBlock Grid.Row="2"
                               Margin="0,0,0,5"
                               Text="Déplacer vers"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <DockPanel Grid.Row="3">
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="12,5"
                                Click="MoveDocument_Click"
                                Content="Déplacer le document" />
                        <ComboBox x:Name="TargetSectionComboBox"
                                  MinWidth="220"
                                  DisplayMemberPath="Name" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="12"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="AJOUTER UNE SECTION"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBox x:Name="NewSectionNameTextBox"
                             Margin="0,7,10,0"
                             Padding="8,5"
                             ToolTip="Nom de la nouvelle section" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Template initial"
                               FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <ComboBox x:Name="TemplateComboBox"
                              Margin="0,7,10,0"
                              Padding="6,4"
                              DisplayMemberPath="DisplayName" />
                </StackPanel>

                <CheckBox x:Name="SingletonCheckBox"
                          Grid.Column="2"
                          Margin="0,24,12,0"
                          VerticalAlignment="Center"
                          Content="Document unique" />

                <Button Grid.Column="3"
                        Margin="0,22,0,0"
                        Padding="14,6"
                        VerticalAlignment="Center"
                        Click="AddSection_Click"
                        Content="Ajouter" />
            </Grid>
        </Border>

        <Grid Grid.Row="3"
              Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <Button Width="90"
                    HorizontalAlignment="Right"
                    IsCancel="True"
                    Content="Fermer" />
        </Grid>
    </Grid>
</Window>
