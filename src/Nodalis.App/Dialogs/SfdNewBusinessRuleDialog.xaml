<Window x:Class="Nodalis.App.Dialogs.SfdNewBusinessRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle règle métier SFD"
        Width="610" Height="380" MinWidth="510" MinHeight="355"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Règle métier partagée" FontSize="20" FontWeight="SemiBold"
                   Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="La règle sera enregistrée une seule fois dans DOCUMENTATION. Les sous-conditions la référenceront par identifiant."/>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Règle" VerticalAlignment="Center"/>
            <TextBox x:Name="RuleTextBox" Grid.Column="1" MaxLength="1000"
                     MinHeight="34" Padding="6,5"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Source" VerticalAlignment="Center"/>
            <TextBox x:Name="SourceTextBox" Grid.Column="1" MaxLength="500"
                     MinHeight="34" Padding="6,5"
                     ToolTip="Référence de la source métier ; obligatoire si la règle est confirmée"/>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="115"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Fiabilité" VerticalAlignment="Top"
                       Margin="0,8,0,0"/>
            <StackPanel Grid.Column="1">
                <ComboBox x:Name="CertaintyComboBox" MinHeight="32"
                          DisplayMemberPath="Label"/>
                <TextBlock Margin="0,9,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="Une règle à confirmer reste un brouillon. La fiabilité ne vaut jamais approbation métier."/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="90" Content="Annuler" IsCancel="True"
                    Margin="0,0,8,0"/>
            <Button Width="110" Content="Ajouter" IsDefault="True"
                    Click="Create_Click"/>
        </StackPanel>
    </Grid>
</Window>
