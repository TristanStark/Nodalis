<Window x:Class="Nodalis.App.Dialogs.ProjectTestResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Résultat de test · Nodalis 2.0"
        Width="620" Height="490" MinWidth="490" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Enregistrer un verdict humain"
                   FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="ContextText" Grid.Row="1"
                   Margin="0,7,0,14" TextWrapping="Wrap"
                   Foreground="{StaticResource SecondaryTextBrush}"/>
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Résultat explicite" Margin="0,0,0,5"/>
            <ComboBox x:Name="OutcomeCombo" MinHeight="32"
                      AutomationProperties.Name="Verdict du test">
                <ComboBoxItem Content="Conforme (déclaré)"/>
                <ComboBoxItem Content="Non conforme"/>
                <ComboBoxItem Content="Bloqué"/>
                <ComboBoxItem Content="Non applicable"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Exécutant" Margin="0,0,0,5"/>
            <TextBox x:Name="ActorBox" MinHeight="32"
                     AutomationProperties.Name="Exécutant du test"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Justification (obligatoire)" Margin="0,0,0,5"/>
            <TextBox x:Name="RationaleBox" MinHeight="32"
                     AutomationProperties.Name="Justification du verdict"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Référence ou note de preuve (facultatif)"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="EvidenceBox" MinHeight="32"
                     AutomationProperties.Name="Note de preuve non vérifiée"/>
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Ce commentaire ne vérifie pas la preuve. Le verdict ne pourra pas être remplacé dans ce passage : une réexécution exige un nouveau passage."/>
        </StackPanel>
        <DockPanel Grid.Row="6" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Annuler" IsCancel="True"
                        Margin="0,0,8,0" Padding="13,8"/>
                <Button Content="Relire et confirmer" IsDefault="True"
                        Padding="13,8" Click="Confirm_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
