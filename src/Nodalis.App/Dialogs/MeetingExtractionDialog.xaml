<Window x:Class="Nodalis.App.Dialogs.MeetingExtractionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extraire actions et décisions"
        Width="760"
        Height="620"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,14">
            <TextBlock Text="EXTRACTION DÉTERMINISTE"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" />
            <TextBlock Margin="0,6,0,0"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       Text="Prévisualiser avant création" />
            <TextBlock Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       Text="Aucun élément n'est créé tant que vous ne validez pas. Les doublons détectés restent visibles mais ne sont pas sélectionnables." />
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Actions">
                <Grid Margin="10">
                    <ListBox x:Name="ActionsList"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,4"
                                          IsChecked="{Binding IsSelected}"
                                          IsEnabled="{Binding CanSelect}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Décisions">
                <Grid Margin="10">
                    <ListBox x:Name="DecisionsList"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,4"
                                          IsChecked="{Binding IsSelected}"
                                          IsEnabled="{Binding CanSelect}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2"
                   Margin="0,14,0,0">
            <TextBlock x:Name="SummaryText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}" />
            <StackPanel DockPanel.Dock="Right"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Width="110"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"
                        Content="Annuler" />
                <Button Width="150"
                        Click="Apply_Click"
                        Content="Créer la sélection" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
