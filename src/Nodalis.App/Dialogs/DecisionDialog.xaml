<Window x:Class="Nodalis.App.Dialogs.DecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle décision"
        Width="780"
        Height="760"
        MinWidth="680"
        MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
        </Grid.RowDefinitions>

        <Border Padding="18,0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Decision Record"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="ScopeText"
                           Margin="0,3,0,0"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="210" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="SourceSuggestionPanel"
                            Grid.ColumnSpan="3"
                            Visibility="Collapsed">
                    <TextBlock Text="Décision détectée dans la source"
                               FontWeight="SemiBold" />
                    <ComboBox x:Name="SourceDecisionComboBox"
                              Margin="0,6,0,12"
                              MinHeight="30"
                              SelectionChanged="SourceDecisionComboBox_SelectionChanged" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="Titre"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Date"
                           FontWeight="SemiBold" />

                <TextBox x:Name="TitleTextBox"
                         Grid.Row="2"
                         Margin="0,6,0,12"
                         MinHeight="30"
                         Padding="6,4" />
                <DatePicker x:Name="DatePicker"
                            Grid.Row="2"
                            Grid.Column="2"
                            Margin="0,6,0,12" />

                <TextBlock Grid.Row="3"
                           Text="Statut"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SourceLabel"
                           Grid.Row="3"
                           Grid.Column="2"
                           Text="Source"
                           FontWeight="SemiBold" />

                <ComboBox x:Name="StatusComboBox"
                          Grid.Row="4"
                          Margin="0,6,0,12"
                          MinHeight="30"
                          Padding="6,3">
                    <ComboBoxItem Tag="Active" Content="Active" />
                    <ComboBoxItem Tag="Superseded" Content="Superseded" />
                    <ComboBoxItem Tag="Deprecated" Content="Deprecated" />
                </ComboBox>
                <TextBlock x:Name="SourceText"
                           Grid.Row="4"
                           Grid.Column="2"
                           Margin="0,8,0,12"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <TextBlock Grid.Row="5"
                           Grid.ColumnSpan="3"
                           Text="Décision"
                           FontWeight="SemiBold" />
                <TextBox x:Name="DecisionTextBox"
                         Grid.Row="6"
                         Grid.ColumnSpan="3"
                         Margin="0,6,0,12"
                         Height="90"
                         Padding="6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <TextBlock Grid.Row="7"
                           Grid.ColumnSpan="3"
                           Text="Contexte"
                           FontWeight="SemiBold" />
                <TextBox x:Name="ContextTextBox"
                         Grid.Row="8"
                         Grid.ColumnSpan="3"
                         Margin="0,6,0,12"
                         Height="80"
                         Padding="6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />

                <Grid Grid.Row="9"
                      Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Justification"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2"
                               Text="Impacts"
                               FontWeight="SemiBold" />
                </Grid>

                <Grid Grid.Row="10"
                      Grid.ColumnSpan="3"
                      Margin="0,6,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="JustificationTextBox"
                             Height="105"
                             Padding="6"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBox x:Name="ImpactsTextBox"
                             Grid.Column="2"
                             Height="105"
                             Padding="6"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>

                <TextBlock Grid.Row="11"
                           Grid.ColumnSpan="3"
                           Text="Liens connexes (un par ligne)"
                           FontWeight="SemiBold" />
                <TextBox x:Name="LinksTextBox"
                         Grid.Row="12"
                         Grid.ColumnSpan="3"
                         Margin="0,6,0,0"
                         Height="80"
                         Padding="6"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="14,8"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="96"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Content="Annuler" />
                <Button Width="118"
                        IsDefault="True"
                        Click="Create_Click"
                        Content="Créer la décision" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
