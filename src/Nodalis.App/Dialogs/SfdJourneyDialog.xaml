<Window x:Class="Nodalis.App.Dialogs.SfdJourneyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parcours SFD"
        Width="1080" Height="810" MinWidth="830" MinHeight="660"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="160"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Parcours Projet avec spec (SFD)"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Text="5 prompts maîtres dans l'ordre du référentiel, puis pilotage transversal. Les PM et ACT sont des brouillons Markdown éditables ; les réponses IA restent soumises à revue humaine."/>
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="UpgradeButton" Grid.Column="1" Visibility="Collapsed"
                    Content="Actualiser les 5 prompts" MinWidth="165"
                    Margin="0,0,8,0" Padding="12,6" Click="Upgrade_Click"/>
            <Button x:Name="InitializeButton" Grid.Column="2"
                    Content="Initialiser ce parcours" MinWidth="180"
                    Padding="12,6" Click="Initialize_Click"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Étapes SFD" Grid.Column="0">
                <ListBox x:Name="StepsList" DisplayMemberPath="Label"
                         SelectionChanged="Step_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
            <GroupBox Header="Opérations de l'étape" Grid.Column="2">
                <ListBox x:Name="OperationsList" DisplayMemberPath="Label"
                         SelectionChanged="Operation_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Statut explicite" VerticalAlignment="Center"/>
            <ComboBox x:Name="StatusCombo" Grid.Column="1" MinHeight="30"
                      DisplayMemberPath="Label"/>
            <Button x:Name="SaveStatusButton" Grid.Column="2"
                    Content="Enregistrer le statut" Margin="8,0,12,0"
                    Padding="10,5" Click="SaveStatus_Click"/>
            <TextBlock x:Name="StageEvidenceText" Grid.Column="3"
                       TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
        </Grid>
        <WrapPanel Grid.Row="5" Margin="0,0,0,6">
            <TextBlock Text="PM parent :" VerticalAlignment="Center" Margin="0,0,6,7"/>
            <ComboBox x:Name="ProcessCombo" Width="166" MinHeight="29"
                      DisplayMemberPath="Label" Margin="0,0,9,7"/>
            <Button x:Name="CreateProcessButton" Content="+ Créer un processus métier"
                    Padding="9,5" Margin="0,0,7,7" Click="CreateProcess_Click"/>
            <Button x:Name="CreateActivityButton" Content="+ Créer une activité"
                    Padding="9,5" Margin="0,0,14,7" Click="CreateActivity_Click"/>
            <TextBlock Text="Activité :" VerticalAlignment="Center" Margin="0,0,6,7"/>
            <ComboBox x:Name="ActivityCombo" Width="175" MinHeight="29"
                      DisplayMemberPath="Label" Margin="0,0,9,7"/>
            <TextBlock Text="Fonctionnalité :" VerticalAlignment="Center" Margin="0,0,6,7"/>
            <ComboBox x:Name="FunctionalityCombo" Width="175" MinHeight="29"
                      DisplayMemberPath="Label" Margin="0,0,7,7"/>
        </WrapPanel>
        <WrapPanel Grid.Row="6" Margin="0,0,0,8">
            <Button x:Name="DetermineProcessesButton" Content="Déterminer les processus métiers"
                    Padding="9,5" Margin="0,0,7,7" Click="DetermineProcesses_Click"/>
            <Button x:Name="GenerateActivityPromptButton" Content="Générer le prompt Activité"
                    Padding="9,5" Margin="0,0,7,7" Click="GenerateActivityPrompt_Click"/>
            <Button x:Name="AssembleFeaturesButton" Content="Assembler les fonctionnalités"
                    Padding="9,5" Margin="0,0,14,7" Click="AssembleFeatures_Click"/>

            <Button x:Name="AddStepButton" Content="+ Étape" Padding="9,5"
                    Margin="0,0,7,7" Click="AddStep_Click"/>
            <Button x:Name="RenameStepButton" Content="Renommer étape"
                    Padding="9,5" Margin="0,0,7,7" Click="RenameStep_Click"/>
            <Button x:Name="MoveUpButton" Content="↑" MinWidth="32"
                    Padding="8,5" Margin="0,0,7,7" Click="MoveUp_Click"/>
            <Button x:Name="MoveDownButton" Content="↓" MinWidth="32"
                    Padding="8,5" Margin="0,0,14,7" Click="MoveDown_Click"/>
            <Button x:Name="AddOperationButton" Content="+ Opération"
                    Padding="9,5" Margin="0,0,7,7" Click="AddOperation_Click"/>
            <Button x:Name="RenameOperationButton" Content="Renommer opération"
                    Padding="9,5" Margin="0,0,7,7" Click="RenameOperation_Click"/>
            <Button x:Name="LinkSourcesButton" Content="Ajouter des sources…"
                    Padding="9,5" Margin="0,0,7,7" Click="LinkSources_Click"/>
            <Button x:Name="PreparePromptButton" Content="Préparer ce prompt…"
                    Padding="9,5" Margin="0,0,7,7" Click="PreparePrompt_Click"/>

        </WrapPanel>
        <TextBlock Grid.Row="7" Text="Sources liées à l'opération (non copiées)"
                   FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ListBox x:Name="SourcesList" Grid.Row="8" Margin="0,0,0,12"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="9" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Width="105" Content="Fermer" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
