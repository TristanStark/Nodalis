                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     MouseDoubleClick="ProjectTaskList_MouseDoubleClick">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="4,5">
                                                            <TextBlock Text="{Binding Text}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource SecondaryTextBrush}">
                                                                <Run Text="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}}" />
                                                                <Run Text="  " />
                                                                <Run Text="{Binding Owner}" />
                                                                <Run Text="  " />
                                                                <Run Text="{Binding OverdueDisplay, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Padding="13"
                                            CornerRadius="6"
