<Window x:Class="Nodalis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="clr-namespace:Nodalis.App.Navigation"
        xmlns:coreNavigation="clr-namespace:Nodalis.Core.Navigation;assembly=Nodalis.Core"
        xmlns:editor="clr-namespace:Nodalis.App.Editor"
        Title="Nodalis"
        Icon="Assets/Nodalis.ico"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <!-- Purely presentational: hidden grouping nodes still exist in the canonical tree. -->
        <HierarchicalDataTemplate DataType="{x:Type navigation:NavigationNodeViewModel}"
                                  ItemsSource="{Binding VisibleChildren}">
            <Grid HorizontalAlignment="Stretch"
                  Margin="0,1"
                  ToolTip="{Binding DisplayName}"
                  ToolTipService.InitialShowDelay="250"
                  ToolTipService.ShowDuration="20000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NodeIcon"
                           Grid.Column="0"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding NavigationGlyph}" />
                <TextBlock x:Name="NodeText"
                           Grid.Column="1"
                           MinHeight="19"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="{Binding DisplayName}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static coreNavigation:WorkspaceNodeKind.Application}">
                    <Setter TargetName="NodeIcon" Property="Foreground"
                            Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="NodeText" Property="Foreground"
                            Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="NodeText" Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static coreNavigation:WorkspaceNodeKind.Global}">
                    <Setter TargetName="NodeIcon" Property="Foreground"
                            Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="NodeText" Property="FontWeight"
                            Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static coreNavigation:WorkspaceNodeKind.Project}">
                    <Setter TargetName="NodeIcon" Property="Foreground"
                            Value="{StaticResource NavigationProjectBrush}" />
                    <Setter TargetName="NodeText" Property="FontWeight"
                            Value="SemiBold" />
                    <Setter TargetName="NodeText" Property="TextWrapping" Value="Wrap" />
                    <Setter TargetName="NodeText" Property="MaxHeight" Value="38" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static coreNavigation:WorkspaceNodeKind.Document}">
                    <Setter TargetName="NodeIcon" Property="Foreground"
                            Value="{StaticResource NavigationDocumentBrush}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- Explicit 32px hit target with zero padding: the implicit theme Button
             has 10px left/right padding and clips 28px header glyph buttons. -->
        <Style x:Key="WorktreeHeaderButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Native WPF row template: 11px indentation, persistent full-row selection,
             visible project enclosure and connected guide, no stock white highlight. -->
        <Style x:Key="WorktreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="25" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Path x:Name="Chevron"
                                  Width="6" Height="10"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="{StaticResource SecondaryTextBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 1,1 L 5,5 L 1,9" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90" CenterX="3" CenterY="5" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Stroke"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TreeViewItem}"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Border x:Name="ProjectFrame"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Background="Transparent"
                                CornerRadius="7"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="RowSurface"
                                        Grid.Row="0"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4"
                                        MinHeight="{TemplateBinding MinHeight}"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="15" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="Expander"
                                                      Grid.Column="0"
                                                      Style="{StaticResource WorktreeExpanderStyle}"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                        <ContentPresenter x:Name="PART_Header"
                                                          Grid.Column="1"
                                                          ContentSource="Header"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border x:Name="ChildrenGuide"
                                        Grid.Row="1"
                                        Margin="11,0,0,0"
                                        BorderBrush="Transparent"
                                        BorderThickness="1,0,0,0">
                                    <ItemsPresenter x:Name="ItemsHost" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger SourceName="RowSurface" Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowSurface" Property="Background"
                                        Value="{StaticResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowSurface" Property="Background"
                                        Value="{StaticResource AccentMutedBrush}" />
                                <Setter TargetName="RowSurface" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="RowSurface" Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="RowSurface" Property="BorderThickness"
                                        Value="3,1,1,1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}"
                                         Value="Compact">
                                <Setter TargetName="RowSurface" Property="MinHeight" Value="27" />
                                <Setter TargetName="ProjectFrame" Property="Margin" Value="0,1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}"
                                         Value="{x:Static coreNavigation:WorkspaceNodeKind.Project}">
                                <Setter TargetName="ProjectFrame" Property="Background"
                                        Value="{StaticResource PanelElevatedBrush}" />
                                <Setter TargetName="ProjectFrame" Property="BorderBrush"
                                        Value="{StaticResource BorderBrush}" />
                                <Setter TargetName="ProjectFrame" Property="BorderThickness"
                                        Value="1" />
                                <Setter TargetName="ChildrenGuide" Property="BorderBrush"
                                        Value="{StaticResource NavigationGuideBrush}" />
                                <Setter TargetName="RowSurface" Property="MinHeight"
                                        Value="33" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static coreNavigation:WorkspaceNodeKind.Project}">
                    <Setter Property="Margin" Value="2,5,2,5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static coreNavigation:WorkspaceNodeKind.Application}">
                    <Setter Property="Margin" Value="0,7,0,2" />
                    <Setter Property="MinHeight" Value="33" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}"
                             Value="{x:Static coreNavigation:WorkspaceNodeKind.Global}">
                    <Setter Property="MinHeight" Value="33" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}}"
                             Value="Compact">
                    <Setter Property="Padding" Value="3,1" />
                    <Setter Property="Margin" Value="0,0,0,0" />
                    <Setter Property="MinHeight" Value="24" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                MinHeight="58"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Width="30"
                           Height="30"
                           Margin="0,0,10,0"
                           Source="Assets/Nodalis.ico"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           ToolTip="Nodalis" />
                    <TextBlock Text="NODALIS"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="WorkspaceNameText"
                               Margin="10,0,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <Button Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Click="CommandPalette_Click"
                        Content="Ctrl+P · Command Palette" />

                <Menu Grid.Column="2"
                      VerticalAlignment="Center"
                      Background="Transparent">
                    <MenuItem Header="Créer">
                        <MenuItem Header="Nouvelle note"
                                  Click="NewNote_Click" />
                        <MenuItem Header="Nouveau projet"
                                  Click="NewProject_Click" />
                        <MenuItem Header="Nouvelle tâche"
                                  Click="NewTask_Click" />
                        <MenuItem Header="Nouvelle intervention"
                                  Click="NewMaintenanceIntervention_Click" />
                        <MenuItem Header="Modifier une intervention"
                                  Click="EditMaintenanceIntervention_Click" />
                        <Separator />
                        <MenuItem Header="Note rapide"
                                  Click="CaptureQuickNote_Click" />
                        <MenuItem Header="Capture Inbox"
                                  Click="CaptureInbox_Click" />
                        <MenuItem Header="Extraire une réunion"
                                  Click="ExtractMeeting_Click" />
                    </MenuItem>

                    <MenuItem Header="Pilotage">
                        <MenuItem Header="Historique de maintenance"
                                  Click="OpenMaintenanceHistory_Click" />
                        <Separator />
                        <MenuItem Header="Tâches"
                                  Click="ShowAllTasks_Click" />
                        <MenuItem Header="Jalons"
                                  Click="ShowMilestones_Click" />
                        <MenuItem Header="Calendrier"
                                  Click="OpenWorkspaceCalendar_Click" />
                        <MenuItem Header="Kanban"
                                  Click="OpenWorkspaceKanban_Click" />
                        <Separator />
                        <MenuItem Header="Health check projet"
                                  Click="OpenProjectHealth_Click" />
                        <MenuItem Header="Couverture &amp; cohérence"
                                  Click="OpenProjectCoverage_Click" />
                    </MenuItem>

                    <MenuItem Header="Connaissance">
                        <MenuItem Header="Notes rapides"
                                  Click="ShowQuickNotes_Click" />
                        <MenuItem Header="Inbox"
                                  Click="OpenInbox_Click" />
                        <MenuItem Header="Journal"
                                  Click="ShowDailyNotes_Click" />
                        <MenuItem Header="Panneau Contexte"
                                  Click="ToggleContextPanel_Click" />
                        <Separator />
                        <MenuItem Header="Templates"
                                  Click="OpenTemplateEditor_Click" />
                    </MenuItem>

                    <MenuItem Header="Données">
                        <MenuItem Header="Importer DOCX"
                                  Click="ImportDocx_Click" />
                        <MenuItem Header="Importer Markdown"
                                  Click="ImportMarkdown_Click" />
                        <MenuItem Header="Exporter le projet"
                                  Click="ExportProject_Click" />
                    </MenuItem>

                    <MenuItem Header="IA locale">
                        <MenuItem Header="Résumé réunion IA"
                                  Click="SummarizeMeetingAi_Click" />
                        <MenuItem Header="Préparer le prompt de mise à jour du projet"
                                  Click="GenerateProjectUpdatePrompt_Click" />
                        <MenuItem Header="Challenger IA"
                                  Click="ChallengeWithAi_Click" />
                        <MenuItem Header="Générer tests IA"
                                  Click="GenerateTestsWithAi_Click" />
                    </MenuItem>

                    <MenuItem Header="Système">
                        <MenuItem Header="Changer de workspace…"
                                  Click="ChangeWorkspace_Click" />
                        <Separator />
                        <MenuItem Header="Mise à jour"
                                  Click="OpenUpdate_Click" />
                        <MenuItem Header="Rollback"
                                  Click="RollbackUpdate_Click" />
                        <Separator />
                        <MenuItem Header="Sauvegardes"
                                  Click="OpenBackups_Click" />
                        <MenuItem Header="Diagnostics"
                                  Click="OpenDiagnostics_Click" />
                        <MenuItem Header="Diagnostic workspace"
                                  Click="OpenWorkspaceIntegrity_Click" />
                        <MenuItem Header="Corbeille"
                                  Click="OpenTrash_Click" />
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ContextSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="ContextColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,1,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="EXPLORATEUR"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource WorktreeHeaderButtonStyle}"
                                Margin="0,0,4,0"
                                Click="RevealActiveDocument_Click"
                                ToolTip="Révéler le document actif dans l'arbre"
                                AutomationProperties.Name="Révéler le document actif dans l'explorateur">
                            <Path Width="16" Height="16"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource PrimaryTextBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 3,13 L 13,3 M 7,3 L 13,3 L 13,9" />
                        </Button>
                        <Button Grid.Column="2"
                                Style="{StaticResource WorktreeHeaderButtonStyle}"
                                Click="CreateApplication_Click"
                                ToolTip="Nouvelle application"
                                AutomationProperties.Name="Créer une application">
                            <Path Width="16" Height="16"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource PrimaryTextBrush}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 8,2 L 8,14 M 2,8 L 14,8" />
                        </Button>
                    </Grid>

                    <!-- P1 filter and display modes; all operate on the existing tree VM. -->
                    <Grid DockPanel.Dock="Top"
                          Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,4,0">
                            <TextBox x:Name="WorktreeFilterBox"
                                     Height="31" MinHeight="31"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Filtrer instantanément les noms de l'explorateur"
                                     AutomationProperties.Name="Filtrer les éléments de l'explorateur"
                                     TextChanged="WorktreeFilterBox_TextChanged" />
                            <TextBlock Text="Filtrer…"
                                       Margin="10,0,4,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{StaticResource SecondaryTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=WorktreeFilterBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource WorktreeHeaderButtonStyle}"
                                Width="32" Height="31" MinHeight="31"
                                ToolTip="Effacer le filtre"
                                AutomationProperties.Name="Effacer le filtre de l'explorateur"
                                Content="×"
                                Click="ClearWorktreeFilter_Click" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="WorktreeApplicationScopeCheck"
                                      Grid.Column="0"
                                      Content="Application courante"
                                      ToolTip="Limiter visuellement l'arbre à l'application du document ou projet actif"
                                      VerticalAlignment="Center"
                                      FontSize="11"
                                      Checked="WorktreeApplicationScope_Changed"
                                      Unchecked="WorktreeApplicationScope_Changed" />
                            <ComboBox x:Name="WorktreeDensityComboBox"
                                      Grid.Column="1"
                                      Width="105" Height="30"
                                      MinHeight="30"
                                      ToolTip="Densité des lignes de l'explorateur"
                                      AutomationProperties.Name="Densité de l'explorateur"
                                      SelectionChanged="WorktreeDensityComboBox_SelectionChanged">
                                <ComboBoxItem Content="Confortable" Tag="Comfortable" />
                                <ComboBoxItem Content="Compact" Tag="Compact" />
                            </ComboBox>
                        </Grid>
                    </Grid>

                    <!-- Shortcuts are derived from Quick Open's existing favorites
                         and recent history, never from duplicate local lists. -->
                    <StackPanel DockPanel.Dock="Top"
                                Margin="0,0,0,5">
                        <Expander x:Name="WorktreeFavoritesExpander"
                                  Header="★ Favoris"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  Background="{StaticResource PanelBackgroundBrush}"
                                  Expanded="WorktreeShortcuts_ExpandedChanged"
                                  Collapsed="WorktreeShortcuts_ExpandedChanged">
                            <ListBox x:Name="WorktreeFavoritesList"
                                     MaxHeight="135"
                                     FontSize="12"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ToolTip="Double-cliquer ou appuyer sur Entrée pour ouvrir"
                                     MouseDoubleClick="WorktreeShortcutList_MouseDoubleClick"
                                     KeyDown="WorktreeShortcutList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type navigation:QuickOpenEntry}">
                                        <StackPanel ToolTip="{Binding QualifiedPath}"
                                                    Margin="2,2,2,3">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding QualifiedPath}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                        <Expander Header="▦ Mes vues" Foreground="{StaticResource PrimaryTextBrush}"
                                  Background="{StaticResource PanelBackgroundBrush}">
                            <ListBox x:Name="WorktreeViewsList" MaxHeight="140"
                                     FontSize="12" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="SavedViewsList_MouseDoubleClick"
                                     KeyDown="SavedViewsList_KeyDown"
                                     AutomationProperties.Name="Mes vues sauvegardées">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3" ToolTip="{Binding Context}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Context}" FontSize="10"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                        <Expander x:Name="WorktreeRecentsExpander"
                                  Header="◷ Documents récents"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  Background="{StaticResource PanelBackgroundBrush}"
                                  Expanded="WorktreeShortcuts_ExpandedChanged"
                                  Collapsed="WorktreeShortcuts_ExpandedChanged">
                            <ListBox x:Name="WorktreeRecentsList"
                                     MaxHeight="135"
                                     FontSize="12"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ToolTip="Double-cliquer ou appuyer sur Entrée pour ouvrir"
                                     MouseDoubleClick="WorktreeShortcutList_MouseDoubleClick"
                                     KeyDown="WorktreeShortcutList_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type navigation:QuickOpenEntry}">
                                        <StackPanel ToolTip="{Binding QualifiedPath}"
                                                    Margin="2,2,2,3">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding QualifiedPath}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </StackPanel>

                    <!-- Sticky context is OUTSIDE the ScrollViewer. Its layout never
                         hides the first visible worktree row underneath an overlay. -->
                    <Border x:Name="WorktreeStickyHost"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed"
                            Margin="0,0,0,5"
                            Padding="0,0,0,5"
                            Background="{StaticResource PanelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <ItemsControl x:Name="WorktreeStickyItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type navigation:NavigationNodeViewModel}">
                                    <Button Margin="1,1,1,2"
                                            Padding="0"
                                            MinHeight="28"
                                            HorizontalContentAlignment="Stretch"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            ToolTip="{Binding FullPath}"
                                            ToolTipService.InitialShowDelay="250"
                                            AutomationProperties.Name="{Binding DisplayName}"
                                            Tag="{Binding}"
                                            Click="WorktreeStickyEntry_Click">
                                        <Border x:Name="StickyRow"
                                                Background="{StaticResource PanelElevatedBrush}"
                                                BorderBrush="{StaticResource NavigationGuideBrush}"
                                                BorderThickness="3,0,0,0"
                                                CornerRadius="5"
                                                Padding="7,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="23" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="15" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="StickyGlyph"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Text="{Binding NavigationGlyph}" />
                                                <TextBlock x:Name="StickyTitle"
                                                           Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="36"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           FontSize="11"
                                                           Text="↑"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Kind}"
                                                     Value="{x:Static coreNavigation:WorkspaceNodeKind.Project}">
                                            <Setter TargetName="StickyGlyph" Property="Foreground"
                                                    Value="{StaticResource NavigationProjectBrush}" />
                                            <Setter TargetName="StickyRow" Property="BorderBrush"
                                                    Value="{StaticResource NavigationProjectBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}"
                                                     Value="{x:Static coreNavigation:WorkspaceNodeKind.Application}">
                                            <Setter TargetName="StickyGlyph" Property="Foreground"
                                                    Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="StickyRow" Property="BorderBrush"
                                                    Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom"
                                Margin="0,10,0,0">
                        <Button Margin="0,0,0,6"
                                Click="OpenWorkspaceCalendar_Click"
                                Content="Calendrier workspace" />
                        <Button Margin="0,0,0,6"
                                Click="OpenWorkspaceKanban_Click"
                                Content="Kanban tâches" />
                        <Button Margin="0,0,0,6"
                                Click="OpenProjectHealth_Click"
                                Content="Health check projet" />
                        <Button Margin="0,0,0,6"
                                Click="OpenProjectCoverage_Click"
                                Content="Couverture &amp; cohérence" />
                        <Button Margin="0,0,0,6"
                                Click="OpenWorkspaceIntegrity_Click"
                                Content="Diagnostic workspace" />
                        <Button Click="OpenTrash_Click"
                                Content="Corbeille" />
                    </StackPanel>

                    <TreeView x:Name="NavigationTree"
                              Tag="Comfortable"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Stretch"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              Loaded="NavigationTree_StickyLoaded"
                              SizeChanged="NavigationTree_StickySizeChanged"
                              ScrollViewer.ScrollChanged="NavigationTree_StickyScrollChanged"
                              SelectedItemChanged="NavigationTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="NavigationTree_PreviewMouseRightButtonDown"
                              ContextMenuOpening="NavigationTree_ContextMenuOpening">
                        <TreeView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </TreeView.ItemsPanel>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Grid Grid.Column="2"
                  Background="{StaticResource WindowBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="DocumentTabsHost"
                        Grid.Row="0"
                        MinHeight="42"
                        Visibility="Collapsed"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ListBox x:Name="DocumentTabsList"
                                 Margin="6,3"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="DocumentTabsList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="DocumentTabsList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="DocumentTabsList_PreviewMouseMove"
                                 PreviewMouseRightButtonDown="DocumentTabsList_PreviewMouseRightButtonDown"
                                 ContextMenuOpening="DocumentTabsList_ContextMenuOpening"
                                 AllowDrop="True"
                                 Drop="DocumentTabsList_Drop">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinWidth="120"
                                          MaxWidth="260"
                                          Margin="2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="8,0,6,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding TabTitle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FullPath}" />
                                        <Button Grid.Column="1"
                                                Width="24"
                                                Height="24"
                                                Padding="0"
                                                Tag="{Binding}"
                                                Click="CloseDocumentTab_Click"
                                                ToolTip="Fermer l'onglet · Ctrl+W"
                                                Content="×" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="1"
                        MinHeight="64"
                        Padding="22,12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <Button x:Name="MaintenanceHistoryButton"
                                    Visibility="Collapsed"
                                    Padding="10,6"
                                    Margin="0,0,6,0"
                                    Click="OpenMaintenanceHistory_Click"
                                    ToolTip="Consulter les incidents et interventions avec recherche et filtres"
                                    Content="Historique" />
                            <Button x:Name="NewMaintenanceInterventionButton"
                                    Visibility="Collapsed"
                                    Padding="10,6"
                                    Margin="0,0,6,0"
                                    Click="NewMaintenanceIntervention_Click"
                                    ToolTip="Créer une intervention et l'ajouter à la fiche de maintenance"
                                    Content="Nouvelle intervention" />
                            <Button x:Name="EditMaintenanceInterventionButton"
                                    Visibility="Collapsed"
                                    Padding="10,6"
                                    Click="EditMaintenanceIntervention_Click"
                                    ToolTip="Modifier une intervention existante"
                                    Content="Modifier" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="DocumentTitleText"
                                       Text="Accueil"
                                       FontSize="18"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="DocumentPathText"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border x:Name="EditorToolbar"
                        Grid.Row="2"
                        Padding="0,4"
                        Visibility="Collapsed"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Width="34"
                                    Height="28"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    FontWeight="Bold"
                                    Click="Bold_Click"
                                    ToolTip="Gras · Ctrl+B"
                                    Content="B" />
                            <Button Width="34"
                                    Height="28"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    FontStyle="Italic"
                                    Click="Italic_Click"
                                    ToolTip="Italique · Ctrl+I"
                                    Content="I" />
                            <Button Width="42"
                                    Height="28"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    FontFamily="Consolas"
                                    Click="InlineCode_Click"
                                    ToolTip="Code inline"
                                    Content="&lt;/&gt;" />
                            <Button Height="28"
                                    Padding="8,0"
                                    Click="AttachFile_Click"
                                    ToolTip="Ajouter une pièce jointe locale"
                                    Content="Joindre" />
                        </StackPanel>

                        <TextBlock x:Name="SaveStateText"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Enregistré" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Width="34"
                                    Height="28"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    Click="SplitVertical_Click"
                                    ToolTip="Scinder verticalement · deux documents côte à côte"
                                    Content="↔" />
                            <Button Width="34"
                                    Height="28"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    Click="SplitHorizontal_Click"
                                    ToolTip="Scinder horizontalement · deux documents superposés"
                                    Content="↕" />
                            <Button VerticalAlignment="Center"
                                    Click="TogglePreview_Click"
                                    Content="Aperçu" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid x:Name="DocumentEditorHost"
                      Grid.Row="3"
                      Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="PrimaryEditorRow" Height="*" />
                        <RowDefinition x:Name="SplitEditorHorizontalDividerRow" Height="0" />
                        <RowDefinition x:Name="SecondaryEditorRow" Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PrimaryEditorColumn" Width="*" />
                        <ColumnDefinition x:Name="SplitEditorVerticalDividerColumn" Width="0" />
                        <ColumnDefinition x:Name="SecondaryEditorColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="PrimaryEditorPane"
                          Grid.Row="0"
                          Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="PreviewSplitterColumn" Width="5" />
                            <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="MarkdownEditorTextBox"
                                 Grid.Column="0"
                                 Padding="18"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 TextChanged="MarkdownEditorTextBox_TextChanged"
                                 GotKeyboardFocus="PrimaryMarkdownEditorTextBox_GotKeyboardFocus"
                                 PreviewMouseMove="MarkdownEditorTextBox_PreviewMouseMove"
                                 MouseLeave="MarkdownEditorTextBox_MouseLeave"
                                 MouseDoubleClick="MarkdownEditorTextBox_MouseDoubleClick"
                                 PreviewMouseRightButtonDown="MarkdownEditorTextBox_PreviewMouseRightButtonDown"
                                 ContextMenuOpening="MarkdownEditorTextBox_ContextMenuOpening"
                                 SpellCheck.IsEnabled="False" />

                        <Popup x:Name="InternalLinkPopup"
                               Grid.Column="0"
                               PlacementTarget="{Binding ElementName=MarkdownEditorTextBox}"
                               Placement="RelativePoint"
                               AllowsTransparency="True"
                               StaysOpen="False">
                            <Border Width="430"
                                    MaxHeight="280"
                                    Padding="6"
                                    CornerRadius="6"
                                    Background="{StaticResource PanelElevatedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <ListBox x:Name="InternalLinkSuggestions"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         MouseDoubleClick="InternalLinkSuggestions_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding QualifiedName}"
                                                           Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>

                        <GridSplitter x:Name="PreviewSplitter"
                                      Grid.Column="1"
                                      Width="5"
                                      HorizontalAlignment="Stretch"
                                      Background="{StaticResource BorderBrush}"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="True" />

                        <FlowDocumentScrollViewer x:Name="MarkdownPreview"
                                                  Grid.Column="2"
                                                  Background="{StaticResource WindowBackgroundBrush}"
                                                  BorderThickness="0"
                                                  IsToolBarVisible="False"
                                                  VerticalScrollBarVisibility="Auto" />
                    </Grid>

                    <GridSplitter x:Name="SplitEditorDivider"
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="Collapsed"
                                  Background="{StaticResource BorderBrush}"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns"
                                  ShowsPreview="True"
                                  DragCompleted="SplitEditorDivider_DragCompleted" />

                    <Border x:Name="SecondaryEditorPane"
                            Grid.Row="0"
                            Grid.Column="2"
                            Visibility="Collapsed"
                            Background="{StaticResource WindowBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="8,4"
                                  Background="{StaticResource PanelBackgroundBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center"
                                           Margin="4,0,8,0"
                                           Text="PANE 2"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                <ComboBox x:Name="SecondaryDocumentPicker"
                                          Grid.Column="1"
                                          MinWidth="140"
                                          Margin="0,0,8,0"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="SecondaryDocumentPicker_SelectionChanged" />

                                <TextBlock x:Name="SecondarySaveStateText"
                                           Grid.Column="2"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="—"
                                           Foreground="{StaticResource SecondaryTextBrush}" />

                                <Button Grid.Column="3"
                                        Width="28"
                                        Height="26"
                                        Padding="0"
                                        Click="CloseSecondaryPane_Click"
                                        ToolTip="Fermer la deuxième pane"
                                        Content="×" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="SecondaryPreviewSplitterColumn" Width="0" />
                                    <ColumnDefinition x:Name="SecondaryPreviewColumn" Width="0" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="SecondaryMarkdownEditorTextBox"
                                         Grid.Column="0"
                                         Padding="18"
                                         BorderThickness="0"
                                         FontFamily="Consolas"
                                         FontSize="14"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextChanged="SecondaryMarkdownEditorTextBox_TextChanged"
                                         SelectionChanged="SecondaryMarkdownEditorTextBox_SelectionChanged"
                                         GotKeyboardFocus="SecondaryMarkdownEditorTextBox_GotKeyboardFocus"
                                         SpellCheck.IsEnabled="False" />

                                <GridSplitter x:Name="SecondaryPreviewSplitter"
                                              Grid.Column="1"
                                              Width="5"
                                              HorizontalAlignment="Stretch"
                                              Visibility="Collapsed"
                                              Background="{StaticResource BorderBrush}"
                                              ResizeDirection="Columns"
                                              ResizeBehavior="PreviousAndNext"
                                              ShowsPreview="True" />

                                <FlowDocumentScrollViewer x:Name="SecondaryMarkdownPreview"
                                                          Grid.Column="2"
                                                          Visibility="Collapsed"
                                                          Background="{StaticResource WindowBackgroundBrush}"
                                                          BorderThickness="0"
                                                          IsToolBarVisible="False"
                                                          VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="DashboardHost"
                              Grid.Row="3"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <DockPanel Margin="0,0,0,22">
                            <Button DockPanel.Dock="Right"
                                    Margin="16,0,0,0"
                                    Padding="10,5"
                                    VerticalAlignment="Top"
                                    Click="ClearRecentHistory_Click"
                                    Content="Effacer l'historique" />
                            <Button x:Name="InboxDashboardButton"
                                    DockPanel.Dock="Right"
                                    Content="Inbox (0)"
                                    Margin="8,0,0,0"
                                    Padding="10,5"
                                    VerticalAlignment="Top"
                                    ToolTip="Ouvrir la boîte de réception"
                                    Click="OpenInbox_Click" />
                            <StackPanel>
                                <TextBlock Text="Reprendre le travail"
                                           FontSize="28"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="Favoris, session et éléments récemment ouverts sur ce poste."
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </DockPanel>

                        <Border Margin="0,0,0,20" Padding="14" CornerRadius="6"
                                Background="{StaticResource PanelBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="Toutes les vues"
                                            Padding="8,4" Click="OpenAllViews_Click" />
                                    <TextBlock Text="MES VUES · ÉPINGLÉES ET SAUVEGARDÉES"
                                               VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </DockPanel>
                                <ListBox x:Name="SavedViewsDashboardList" MaxHeight="150"
                                         BorderThickness="0" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MouseDoubleClick="SavedViewsList_MouseDoubleClick"
                                         KeyDown="SavedViewsList_KeyDown"
                                         AutomationProperties.Name="Vues du dashboard">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="3,5">
                                                <TextBlock Text="{Binding Context}" DockPanel.Dock="Right"
                                                           Margin="12,0,0,0" FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="14"
                                    CornerRadius="6"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="FAVORIS"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <ListBox x:Name="FavoritesList"
                                             Margin="0,8,0,0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             MouseDoubleClick="DashboardList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,5">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding Context}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="14"
                                    CornerRadius="6"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PROJETS RÉCENTS"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <ListBox x:Name="RecentProjectsList"
                                             Margin="0,8,0,0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             PreviewMouseRightButtonDown="RecentHistoryList_PreviewMouseRightButtonDown"
                                             ContextMenuOpening="RecentHistoryList_ContextMenuOpening"
                                             MouseDoubleClick="DashboardList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,5">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource SecondaryTextBrush}">
                                                        <Run Text="{Binding LastOpenedUtc, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Padding="14"
                                    CornerRadius="6"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="DOCUMENTS RÉCENTS"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <ListBox x:Name="RecentDocumentsList"
                                             Margin="0,8,0,0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             PreviewMouseRightButtonDown="RecentHistoryList_PreviewMouseRightButtonDown"
                                             ContextMenuOpening="RecentHistoryList_ContextMenuOpening"
                                             MouseDoubleClick="DashboardList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,5">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Text="{Binding Context}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    Padding="14"
                                    CornerRadius="6"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right"
                                                Padding="8,4"
                                                Margin="8,0,0,0"
                                                ToolTip="Générer un fichier temporaire contenant la présentation du projet et le résumé IA d'une réunion"
                                                Content="Prompt projet"
                                                Click="GenerateProjectUpdatePrompt_Click" />
                                        <TextBlock Text="RÉUNIONS RÉCENTES"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </DockPanel>
                                    <ListBox x:Name="RecentMeetingsList"
                                             Margin="0,8,0,0"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             PreviewMouseRightButtonDown="RecentHistoryList_PreviewMouseRightButtonDown"
                                             ContextMenuOpening="RecentHistoryList_ContextMenuOpening"
                                             MouseDoubleClick="DashboardList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,5">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,2,0,0"
