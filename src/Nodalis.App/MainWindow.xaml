<Window x:Class="Nodalis.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:navigation="clr-namespace:Nodalis.App.Navigation"
        Title="Nodalis"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type navigation:NavigationNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayName}"
                       TextTrimming="CharacterEllipsis" />
        </HierarchicalDataTemplate>

        <Style TargetType="TreeViewItem"
               BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected"
                    Value="{Binding IsSelected, Mode=TwoWay}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="NODALIS"
                               FontWeight="SemiBold"
                               FontSize="16"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="WorkspaceNameText"
                               Margin="10,0,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="Ctrl+P · Command Palette"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Click="ToggleContextPanel_Click"
                            Content="Contexte" />
                    <Button Click="NewNote_Click"
                            Content="Nouvelle note  Ctrl+N" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn" Width="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ContextSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="ContextColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="NAVIGATION"
                               Margin="4,4,0,10"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />

                    <TreeView x:Name="NavigationTree"
                              SelectedItemChanged="NavigationTree_SelectedItemChanged" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Grid Grid.Column="2"
                  Background="{StaticResource WindowBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="22,10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock x:Name="DocumentTitleText"
                                   Text="Accueil"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="DocumentPathText"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border x:Name="EditorToolbar"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Width="34"
                                    Height="28"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    FontWeight="Bold"
                                    Click="Bold_Click"
                                    ToolTip="Gras · Ctrl+B"
                                    Content="B" />
                            <Button Width="34"
                                    Height="28"
                                    Margin="0,0,5,0"
                                    Padding="0"
                                    FontStyle="Italic"
                                    Click="Italic_Click"
                                    ToolTip="Italique · Ctrl+I"
                                    Content="I" />
                            <Button Width="42"
                                    Height="28"
                                    Padding="0"
                                    FontFamily="Consolas"
                                    Click="InlineCode_Click"
                                    ToolTip="Code inline"
                                    Content="&lt;/&gt;" />
                        </StackPanel>

                        <TextBlock x:Name="SaveStateText"
                                   Grid.Column="1"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="Enregistré" />

                        <Button Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="TogglePreview_Click"
                                Content="Aperçu" />
                    </Grid>
                </Border>

                <Grid x:Name="DocumentEditorHost"
                      Grid.Row="2"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="PreviewSplitterColumn" Width="5" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="MarkdownEditorTextBox"
                             Grid.Column="0"
                             Padding="18"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="14"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextChanged="MarkdownEditorTextBox_TextChanged"
                             SpellCheck.IsEnabled="False" />

                    <GridSplitter x:Name="PreviewSplitter"
                                  Grid.Column="1"
                                  Width="5"
                                  HorizontalAlignment="Stretch"
                                  Background="{StaticResource BorderBrush}"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext"
                                  ShowsPreview="True" />

                    <FlowDocumentScrollViewer x:Name="MarkdownPreview"
                                              Grid.Column="2"
                                              Background="{StaticResource WindowBackgroundBrush}"
                                              BorderThickness="0"
                                              IsToolBarVisible="False"
                                              VerticalScrollBarVisibility="Auto" />
                </Grid>

                <Border x:Name="NodeSummaryHost"
                        Grid.Row="2"
                        Margin="20"
                        Padding="18"
                        CornerRadius="6"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <TextBlock x:Name="NodeSummaryText"
                               Text="Sélectionnez un élément dans l'arborescence."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>
            </Grid>

            <GridSplitter x:Name="ContextSplitter"
                          Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True" />

            <Border x:Name="ContextPanel"
                    Grid.Column="4"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="CONTEXTE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="ContextTitleText"
                               Text="Aucun élément sélectionné"
                               Margin="0,14,0,0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ContextKindText"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="ContextPathText"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Margin="0,20,0,0"
                               Text="Les backlinks et métadonnées enrichies seront ajoutés ici dans les prochaines étapes."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Text="Local · Markdown + JSON · Aucun appel réseau"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Ctrl+S enregistrer · Ctrl+B gras · Ctrl+I italique"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
