                                                                       FontSize="10"
                                                                       Foreground="{StaticResource SecondaryTextBrush}">
                                                                <Run Text="{Binding Date, StringFormat={}{0:dd/MM/yyyy}}" />
                                                                <Run Text="  " />
                                                                <Run Text="{Binding Status}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

