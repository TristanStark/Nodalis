                                            Background="{StaticResource WindowBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="JALONS"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock x:Name="ProjectMilestoneSummaryText"
                                                       Margin="0,5,0,0"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="4"
                                            Padding="12"
                                            CornerRadius="5"
                                            Background="{StaticResource WindowBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="ALERTES"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBlock x:Name="ProjectAlertSummaryText"
                                                       Margin="0,5,0,0"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Padding="13"
                                            CornerRadius="6"
                                            Background="{StaticResource WindowBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
