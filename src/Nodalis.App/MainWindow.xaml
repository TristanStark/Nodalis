                                                     Background="Transparent"
                                                     MouseDoubleClick="ProjectDecisionList_MouseDoubleClick">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="4,5">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
