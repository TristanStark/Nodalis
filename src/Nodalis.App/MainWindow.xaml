                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="4,5">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="10"
                                                                       Foreground="{StaticResource SecondaryTextBrush}">
                                                                <Run Text="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                                                                <Run Text="  " />
                                                                <Run Text="{Binding Detail}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2"
                                            Padding="13"
                                            CornerRadius="6"
                                            Background="{StaticResource WindowBackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="ALERTES DE COHÉRENCE"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource SecondaryTextBrush}" />
                                            <ListBox x:Name="ProjectAlertsList"
                                                     Margin="0,8,0,0"
                                                     MaxHeight="240"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     MouseDoubleClick="ProjectAlertList_MouseDoubleClick">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="4,5">
                                                            <TextBlock Text="{Binding Category}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AccentBrush}" />
                                                            <TextBlock Margin="0,2,0,0"
                                                                       Text="{Binding Message}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Margin="0,18,0,0"
                                        Padding="13"
                                        CornerRadius="6"
                                        Background="{StaticResource WindowBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="FAVORIS DU PROJET"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <ListBox x:Name="ProjectFavoritesList"
                                                 Margin="0,8,0,0"
                                                 MaxHeight="180"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 MouseDoubleClick="DashboardList_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="4,5">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding Context}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
