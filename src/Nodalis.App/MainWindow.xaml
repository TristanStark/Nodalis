                                Grid.Row="5"
                                Margin="0,18,0,0"
                                Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       Text="PROPRIÉTÉS"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                            <Button x:Name="EditDocumentPropertiesButton"
                                    DockPanel.Dock="Right"
                                    Padding="8,2"
                                    IsEnabled="False"
                                    Click="EditDocumentProperties_Click"
                                    Content="Modifier" />
                        </DockPanel>

                        <ItemsControl x:Name="DocumentPropertiesList"
                                      Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="{Binding Value}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource PrimaryTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="DocumentPropertiesEmptyText"
                                   Text="Aucune propriété. Le document reste un Markdown libre."
