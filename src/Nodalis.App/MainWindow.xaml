                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Padding="7,2"
                                Click="BookmarkHeadingButton_Click"
                                Content="☆ Signet…"
                                ToolTip="Ajouter, renommer ou supprimer un signet sur la section sélectionnée" />
                    </DockPanel>

                    <Grid Grid.Row="7">
                        <TreeView x:Name="DocumentOutlineTree"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  SelectedItemChanged="DocumentOutlineTree_SelectedItemChanged">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type editor:DocumentOutlineItemViewModel}"
                                                          ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding LineNumber, StringFormat='Aller à la ligne {0}'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{StaticResource PrimaryTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}"
                                                                 Value="True">
                                                        <Setter Property="FontWeight"
                                                                Value="SemiBold" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <TextBlock x:Name="DocumentOutlineEmptyText"
                                   Margin="4,4,0,0"
                                   Text="Aucun titre Markdown dans ce document."
                                   TextWrapping="Wrap"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <DockPanel Grid.Row="8"
                               Margin="0,18,0,8"
                               LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Text="RELATIONS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="ImpactAnalysisButton"
                                    Margin="0,0,6,0"
                                    Padding="7,2"
                                    IsEnabled="False"
                                    Click="ImpactAnalysisButton_Click"
                                    Content="Impacts…"
                                    ToolTip="Analyser les impacts potentiels à partir du document actif" />
                            <Button x:Name="AddRelationButton"
                                    Padding="7,2"
                                    IsEnabled="False"
                                    Click="AddRelationButton_Click"
                                    Content="+ Ajouter"
                                    ToolTip="Ajouter une relation typée au document actif" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="9">
                        <ListBox x:Name="RelationsList"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MouseDoubleClick="RelationsList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Direction}"
                                                       Margin="0,0,6,0"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{Binding RelationType}"
                                                       Margin="0,0,6,0"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Margin="16,2,0,0"
                                                   Text="{Binding Detail}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="RelationsEmptyText"
                                   Margin="4,4,0,0"
                                   Text="Aucune relation."
                                   TextWrapping="Wrap"
                                   IsHitTestVisible="False"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <DockPanel Grid.Row="10"
                               Margin="0,18,0,8"
                               LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Text="BACKLINKS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button x:Name="ExploreReferencesButton"
                                DockPanel.Dock="Right"
                                Padding="7,2"
                                IsEnabled="False"
                                Click="ExploreReferencesButton_Click"
                                Content="Explorer…"
                                ToolTip="Filtrer les liens et relations qui référencent cet élément" />
                    </DockPanel>

                    <ListBox x:Name="BacklinksList"
                             Grid.Row="11"
                             BorderThickness="0"
                             Background="Transparent"
                             MouseDoubleClick="BacklinksList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,5">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Source.DisplayName}" />
                                        <Run Text=" · ligne " />
                                        <Run Text="{Binding LineNumber}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0"
                                               Text="{Binding Excerpt}"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           Text="Local · Markdown + JSON · Aucun appel réseau"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="Ctrl+K lien · Ctrl+S enregistrer · Ctrl+B gras · Ctrl+I italique"
                           FontSize="11"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
